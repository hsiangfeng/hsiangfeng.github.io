[{"data":1,"prerenderedAt":394},["ShallowReactive",2],{"header-locale:\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F":3,"page:\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F":4,"alt:\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F":3,"prev-next:\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F":372,"related:\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F":381},"\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F",{"id":5,"title":6,"abbrlink":7,"altUrl":3,"body":8,"category":339,"date":340,"description":341,"extension":342,"lang":343,"meta":344,"navigation":355,"path":356,"readingMinutes":357,"seo":358,"standalone":359,"stem":360,"tags":361,"tldr":369,"updated":340,"url":370,"__hash__":371},"content\u002FVibe Coding 實戰 30 天\u002FVibe-Coding-實戰-30-天-Day-30-系列回顧與下一步.md","老闆不會教你的 Vibe Coding 實戰 30 天｜Day 30：完賽回顧與全系列目錄","26073030",{"type":9,"value":10,"toc":324},"minimark",[11,18,22,25,28,32,35,38,41,44,48,51,56,111,115,166,170,221,225,276,279,295,298,301,304,315,318,321],[12,13,14],"p",{},[15,16],"img",{"alt":6,"src":17},"https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fai\u002Fithome-2026-vibe-coding\u002Fvibe-coding-day-30-cover.png",[19,20,21],"h2",{"id":21},"前言",[12,23,24],{},"不知不覺就第 30 天了。",[12,26,27],{},"這一天就簡單一點吧，簡單寫一下我的心得順便整理成目錄。",[19,29,31],{"id":30},"這-30-天的感想","這 30 天的感想",[12,33,34],{},"恩...老實講呢...",[12,36,37],{},"非技術性的文章，對於我來講挑戰性非常高，尤其要介紹 AI Agent 這一塊我認為難度非常高，但純粹的介紹技術、流程我卻覺得很簡單。",[12,39,40],{},"所以前面章節中 Day1～Day20 我寫下來相對容易，但 Day20～Day29 我就開始覺得難度大增（甚至開始摸了 xD），所以後半段如果你覺得有點爛，就....請見諒？！",[12,42,43],{},"那這邊廢話也不再多說了，就稍微整理一下目錄，方便你可以找到你想看到。",[19,45,47],{"id":46},"全-30-篇目錄","全 30 篇目錄",[12,49,50],{},"這邊我把 30 篇依照四週排開，有興趣的話可以直接點進去看看：",[52,53,55],"h3",{"id":54},"week-1先把觀念跟基本操作搞定","Week 1：先把觀念跟基本操作搞定",[57,58,59,69,76,83,90,97,104],"ul",{},[60,61,62],"li",{},[63,64,68],"a",{"href":65,"rel":66},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260914\u002Fvibe-coding-30-days-intro\u002F",[67],"nofollow","Day 1：用 Claude Code 做記帳 App 的 30 天路線",[60,70,71],{},[63,72,75],{"href":73,"rel":74},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260915\u002Fwhat-is-vibe-coding\u002F",[67],"Day 2：Vibe Coding 是什麼？來換一種懂法",[60,77,78],{},[63,79,82],{"href":80,"rel":81},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260916\u002Fclaude-code-install-and-pricing\u002F",[67],"Day 3：安裝 Claude Code 跟訂閱方案怎麼選",[60,84,85],{},[63,86,89],{"href":87,"rel":88},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260917\u002Fclaude-code-first-task-read-diff\u002F",[67],"Day 4：第一個任務——改 code 的最小流程",[60,91,92],{},[63,93,96],{"href":94,"rel":95},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260918\u002Fclaude-code-permission-plan-mode\u002F",[67],"Day 5：Permission 跟 Plan Mode 之不要什麼都按 Yes",[60,98,99],{},[63,100,103],{"href":101,"rel":102},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260919\u002Fclaude-code-clear-vs-compact\u002F",[67],"Day 6：Context 與 Token —— AI 為什麼越聊越笨",[60,105,106],{},[63,107,110],{"href":108,"rel":109},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260920\u002Fclaude-code-beginner-mistakes\u002F",[67],"Day 7：Week 1 收尾之新手最常踩的 5 個雷",[52,112,114],{"id":113},"week-2從一份規格做到能用的-mvp","Week 2：從一份規格做到能用的 MVP",[57,116,117,124,131,138,145,152,159],{},[60,118,119],{},[63,120,123],{"href":121,"rel":122},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260921\u002Fwrite-spec-md-with-claude-code\u002F",[67],"Day 8：把想法變規格跟著 AI 一起寫 SPEC.md",[60,125,126],{},[63,127,130],{"href":128,"rel":129},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260922\u002Fclaude-code-project-setup-git-init\u002F",[67],"Day 9：專案初始化——CLAUDE.md 跟 git init",[60,132,133],{},[63,134,137],{"href":135,"rel":136},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260923\u002Fplan-mode-build-first-feature\u002F",[67],"Day 10：Plan Mode 實戰之記一筆帳",[60,139,140],{},[63,141,144],{"href":142,"rel":143},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260924\u002Fclaude-code-prompt-splitting\u002F",[67],"Day 11：功能迭代之一次一個的 Prompt 拆法",[60,146,147],{},[63,148,151],{"href":149,"rel":150},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260925\u002Fclaude-code-debug-workflow\u002F",[67],"Day 12：畫面壞了怎麼辦？！來聊聊 Debug 流程",[60,153,154],{},[63,155,158],{"href":156,"rel":157},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260926\u002Fchart-js-stats-page-with-claude-code\u002F",[67],"Day 13：讓數字站起來！統計頁跟圓餅圖",[60,160,161],{},[63,162,165],{"href":163,"rel":164},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260927\u002Fshould-you-read-ai-written-code\u002F",[67],"Day 14：Week 2 收尾之 AI 寫的 code 到底要不要看",[52,167,169],{"id":168},"week-3畫面變好看然後幫-ai-裝工具","Week 3：畫面變好看，然後幫 AI 裝工具",[57,171,172,179,186,193,200,207,214],{},[60,173,174],{},[63,175,178],{"href":176,"rel":177},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260928\u002Fwhat-are-claude-code-skills\u002F",[67],"Day 15：Skills 是什麼，就是學會你做事方法",[60,180,181],{},[63,182,185],{"href":183,"rel":184},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260929\u002Fclaude-code-frontend-design-plugin\u002F",[67],"Day 16：讓畫面變好看（上）之 Frontend Design",[60,187,188],{},[63,189,192],{"href":190,"rel":191},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20260930\u002Flock-ui-style-with-design-md\u002F",[67],"Day 17：畫面好看（下）之用設計文件鎖住風格",[60,194,195],{},[63,196,199],{"href":197,"rel":198},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261001\u002Fwrite-your-first-claude-code-skill\u002F",[67],"Day 18：第一個 Skill，從 SKILL.md 從零開始",[60,201,202],{},[63,203,206],{"href":204,"rel":205},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261002\u002Fclaude-code-subagents-code-review\u002F",[67],"Day 19：Subagents 之來請一個 Code Review 副手",[60,208,209],{},[63,210,213],{"href":211,"rel":212},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261003\u002Fclaude-code-mcp-intro\u002F",[67],"Day 20：MCP 入門之請 AI 查完最新文件再回答",[60,215,216],{},[63,217,220],{"href":218,"rel":219},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261004\u002Fskills-subagents-mcp-how-to-choose\u002F",[67],"Day 21：Week 3 收尾之 Skills、Subagents、MCP 怎麼選",[52,222,224],{"id":223},"week-4把專案從能用推到敢上線","Week 4：把專案從能用推到敢上線",[57,226,227,234,241,248,255,262,269],{},[60,228,229],{},[63,230,233],{"href":231,"rel":232},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261005\u002Fclaude-code-hooks-auto-format\u002F",[67],"Day 22：Hooks 生命週期觸發器",[60,235,236],{},[63,237,240],{"href":238,"rel":239},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261006\u002Fclaude-code-vitest-unit-tests\u002F",[67],"Day 23：測試安全網",[60,242,243],{},[63,244,247],{"href":245,"rel":246},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261007\u002Frefactor-ai-generated-code\u002F",[67],"Day 24：Refactor 還技術債",[60,249,250],{},[63,251,254],{"href":252,"rel":253},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261008\u002Fdeploy-vite-app-to-github-pages\u002F",[67],"Day 25：部署上線 GitHub Pages",[60,256,257],{},[63,258,261],{"href":259,"rel":260},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261009\u002Fclaude-code-add-feature-after-launch\u002F",[67],"Day 26：上線後的第一次改版",[60,263,264],{},[63,265,268],{"href":266,"rel":267},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261010\u002Fgithub-pull-request-coderabbit-ai-code-review\u002F",[67],"Day 27：PR 流程與 CodeRabbit 自動審查",[60,270,271],{},[63,272,275],{"href":273,"rel":274},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261011\u002Fclaude-code-save-token-cost\u002F",[67],"Day 28：Week 4 收尾之 Token 怎麼省",[52,277,278],{"id":278},"最後兩天",[57,280,281,288],{},[60,282,283],{},[63,284,287],{"href":285,"rel":286},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261012\u002Fvibe-coding-workflow-sop\u002F",[67],"Day 29：我的 Vibe Coding 流程 SOP",[60,289,290],{},[63,291,294],{"href":292,"rel":293},"https:\u002F\u002Fisraynotarray.com\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F",[67],"Day 30：完賽回顧與全系列目錄",[19,296,297],{"id":297},"結語",[12,299,300],{},"時間差不多了，30 天就到這邊收工啦～",[12,302,303],{},"最後總結一下：",[57,305,306,309,312],{},[60,307,308],{},"小 App 跟大專案用的是同一副骨架：規格、測試、審查、自動部署。",[60,310,311],{},"工具會一直換，描述、驗收、拆解這三件事不會。",[60,313,314],{},"下一步就是開一個你自己的專案。",[12,316,317],{},"謝謝每一個跟到這裡的你，不管你是每天動手跟著做，還是純看故事看到完賽。",[12,319,320],{},"之後有新的坑跟新的玩具，我會繼續寫成單篇文章放在部落格上。",[12,322,323],{},"希望這 30 天有讓你真的走進 Vibe Coding 的世界哩～完賽，我們下個系列見囉～",{"title":325,"searchDepth":326,"depth":326,"links":327},"",2,[328,329,330,338],{"id":21,"depth":326,"text":21},{"id":30,"depth":326,"text":31},{"id":46,"depth":326,"text":47,"children":331},[332,334,335,336,337],{"id":54,"depth":333,"text":55},3,{"id":113,"depth":333,"text":114},{"id":168,"depth":333,"text":169},{"id":223,"depth":333,"text":224},{"id":278,"depth":333,"text":278},{"id":297,"depth":326,"text":297},"AI","2026-10-13 09:00:00","老闆不會教你的 Vibe Coding 實戰 30 天最終回！這篇是完賽心得加全系列目錄：先聊這 30 天用 Claude Code 從一份 SPEC.md 做到記帳 App 上線的感想，再把 30 篇依四週排開（Week 1 基本操作、Week 2 從規格到 MVP、Week 3 Skills／Subagents／MCP 與畫面設計、Week 4 Hooks／測試／重構／部署／上線後改版／PR 流程，最後是流程 SOP），之後要回來查直接從這篇找。最後給一個不做承諾的下一步：開一個自己的專案把六步 SOP 跑一遍。","md","zh-Hant",{"photo":17,"thumbnail":17,"faq":345},[346,349,352],{"q":347,"a":348},"這 30 篇要照順序看嗎？","建議照順序，因為記帳 App 是從 Day 8 一路接著做到 Day 27 的，中間的功能、檔案、工具都會互相引用。如果你只是想查某個工具，直接從目錄挑那一篇就好，Week 3 的 Skills、Subagents、MCP 三篇觀念上可以獨立看。",{"q":350,"a":351},"30 天之後接下來該學什麼？","先別急著學新的，開一個自己的專案把 Day 29 的六步 SOP 跑一遍，讓方法長在自己身上。更進階的功能等你真的遇到那個需求，再去翻官方文件就好。",{"q":353,"a":354},"這套流程可以用在工作專案嗎？","核心流程（規格、地基、計畫、小步、關卡、部署）完全通用，差別在每一步做得更足：規格會更正式、測試覆蓋更廣、review 更嚴格、部署換成公司的流程。工作專案記得先確認公司對 AI 工具的使用規範。",true,"\u002Fvibe-coding-30\u002Fvibe-coding-30-day-30","2",{"title":6,"description":341},false,"Vibe Coding 實戰 30 天\u002FVibe-Coding-實戰-30-天-Day-30-系列回顧與下一步",[362,363,364,365,366,367,368],"Vibe Coding","Vibe Coding 心得","Claude Code 30 天","鐵人賽完賽","Vibe Coding 系列目錄","Claude Code","老闆不會教你的 Vibe Coding 實戰 30 天",null,"\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F","cVZLtTRUNOo-YYM3npC-0F7aGA0ma9BbBK87m1R2jq8",{"newer":373,"older":377},{"url":374,"title":375,"date":376},"\u002Fother\u002F20261018\u002F3499703665\u002F","Zeabur 結束營運：台灣新創的跌倒與成長","2026-10-18 20:39:25",{"url":378,"title":379,"date":380},"\u002Fai\u002F20261012\u002Fvibe-coding-workflow-sop\u002F","老闆不會教你的 Vibe Coding 實戰 30 天｜Day 29：我的 Vibe Coding 流程 SOP","2026-10-12 09:00:00",[382,384,389],{"url":378,"title":379,"date":380,"readingMinutes":383},"7",{"url":385,"title":386,"date":387,"readingMinutes":388},"\u002Fai\u002F20261011\u002Fclaude-code-save-token-cost\u002F","老闆不會教你的 Vibe Coding 實戰 30 天｜Day 28：Week 4 收尾之 Token 怎麼省","2026-10-11 09:00:00","3",{"url":390,"title":391,"date":392,"readingMinutes":393},"\u002Fai\u002F20261010\u002Fgithub-pull-request-coderabbit-ai-code-review\u002F","老闆不會教你的 Vibe Coding 實戰 30 天｜Day 27：PR 流程與 CodeRabbit 自動審查","2026-10-10 09:00:00","6",1792338353941]