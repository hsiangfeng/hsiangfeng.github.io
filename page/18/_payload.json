[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F18\u002F":3,"post-page:zh-Hant:18":4,"author-stats:zh-Hant:full":75},null,{"posts":5,"total":73,"totalPages":74},[6,16,23,29,35,41,48,54,60,66],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20231010\u002F3798507505\u002F","Day26-Google Extension 與 Vite","2023-10-10 00:00:01","Nodejs",[12,13],"Node.js","《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","前一篇我們對於 Google Extension 有了初步的認識，但我們實際開發上來講，必定會使用到人家開發好的套件，所以這一篇就會來使用 Vite 來開發 Google Extension。","5",{"url":17,"title":18,"date":19,"updated":19,"category":10,"tags":20,"description":21,"readingMinutes":22},"\u002Fnodejs\u002F20231009\u002F609773828\u002F","Day25-Google Extension","2023-10-09 00:00:01",[12,13],"又進入新的章節了，這章節我們要來介紹 Google Extension，那麼 Google Extension 是什麼呢？這一篇就讓我們來簡單的認識一下吧！","3",{"url":24,"title":25,"date":26,"updated":26,"category":10,"tags":27,"description":28,"readingMinutes":15},"\u002Fnodejs\u002F20231008\u002F2016996949\u002F","Day24-部署到 Zeabur","2023-10-08 00:00:01",[12,13],"前一面我們對於伺服器有基本概念後，接下來當然是要實際部署專案到伺服器上囉～",{"url":30,"title":31,"date":32,"updated":32,"category":10,"tags":33,"description":34,"readingMinutes":22},"\u002Fnodejs\u002F20231007\u002F3219221834\u002F","Day23 - 關於伺服器","2023-10-07 00:00:01",[12,13],"我們介紹了許多知識點，並且也將爬蟲整合進去 Discord Bot 中，但是實際上來講我們不可能都用本地端來啟動 Discord Bot，所以接下來將會來介紹一些關於伺服器與主機的知識點，所以這一篇會相對比較簡單，也算是讓腦袋放鬆一下。",{"url":36,"title":37,"date":38,"updated":38,"category":10,"tags":39,"description":40,"readingMinutes":15},"\u002Fnodejs\u002F20231006\u002F4255357825\u002F","Day22 - Discord Bot 整合","2023-10-06 00:00:01",[12,13],"前一篇對於 Discord 已經具有一定基礎後，當然要來做一點小東西了，當然不會太難，大多都是前面所寫過跟使用過的東西哩。",{"url":42,"title":43,"date":44,"updated":44,"category":10,"tags":45,"description":46,"readingMinutes":47},"\u002Fnodejs\u002F20231005\u002F1512925992\u002F","Day21 - Discord 基礎","2023-10-05 00:00:01",[12,13],"在前一篇我們準備好了 Discord 基本的一些東西與設定，接下來當然要繼續聊 Discord 的部分囉～","4",{"url":49,"title":50,"date":51,"updated":51,"category":10,"tags":52,"description":53,"readingMinutes":22},"\u002Fnodejs\u002F20231004\u002F1031795777\u002F","Day20 - Discord Bot？","2023-10-04 00:00:01",[12,13],"除了爬蟲之外，Node.js 可以做的事情其實非常多，所以接下來將會介紹一些其他的應用的實作，也就是 Bot。",{"url":55,"title":56,"date":57,"updated":57,"category":10,"tags":58,"description":59,"readingMinutes":47},"\u002Fnodejs\u002F20231003\u002F1830434204\u002F","Day19 - Crontab + Node.js","2023-10-03 00:00:01",[12,13],"前一篇我們對於 Crontab 已經有一個基本的概念，接下來當然要套用到實戰上，不然認識了也沒用，所以這一篇我們就來實作一個 Crontab + Node.js 的範例。",{"url":61,"title":62,"date":63,"updated":63,"category":10,"tags":64,"description":65,"readingMinutes":22},"\u002Fnodejs\u002F20231002\u002F2297973079\u002F","Day18 - 初識 Crontab","2023-10-02 00:00:01",[12,13],"看到現在，你也應該學了不少知識了，你應該會發現有些系統好像都會「自動」去做某些事情，所以接下來將會來介紹例行性工作排程 (crontab) 這個東西。",{"url":67,"title":68,"date":69,"updated":69,"category":10,"tags":70,"description":71,"readingMinutes":72},"\u002Fnodejs\u002F20231001\u002F2119244773\u002F","Day17 - 續談爬蟲（下）","2023-10-01 00:00:01",[12,13],"這一篇將會接續前一篇的文章內容，繼續把前一篇沒講完的爬蟲內容給補完。","6",1050,105,{"postCount":73,"tagCount":76},1053,1790265672754]