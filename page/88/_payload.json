[{"data":1,"prerenderedAt":80},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F88\u002F":3,"post-page:zh-Hant:88":4,"author-stats:zh-Hant:full":78},null,{"posts":5,"total":76,"totalPages":77},[6,16,22,29,37,44,50,56,62,68],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002FTypeScript\u002F20190622\u002F2982589304\u002F","TypeScript 基礎入門-混和型別","2019-06-22 21:56:38","TypeScript",[12,13,10],"TypeScript 基礎入門","JavaScript","前面講到 TypeScript 有所謂的型別推論的能力，在這邊再來講一個東西混和型別，這個東西又是什麼呢?讓我們來了解一下","1",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":15},"\u002FTypeScript\u002F20190622\u002F2739569432\u002F","TypeScript 基礎入門-型別推論","2019-06-22 15:49:05",[12,13,10],"前面已經了解該如何設置變數型別的方式，但是尾段其實也有講到如果不設置型別也是會編譯成功，但是實際上真的是這樣子嗎?這邊就來講講 TypeScript 裡面有一個很特別的東西，叫做型別推論，就算你不宣告型別 TypeScript 也會自己判定，來了解看看吧~",{"url":23,"title":24,"date":25,"updated":3,"category":10,"tags":26,"description":27,"readingMinutes":28},"\u002FTypeScript\u002F20190622\u002F3955309115\u002F","TypeScript 基礎入門-變數篇","2019-06-22 15:06:22",[12,13,10],"身邊滿多前端工程師都會接觸到 TypeScript，所以這邊紀錄一下 TypeScript 基礎入門","2",{"url":30,"title":31,"date":32,"updated":3,"category":33,"tags":34,"description":36,"readingMinutes":28},"\u002Fgit\u002F20190621\u002F4239571950\u002F","GitHub 發生衝突該如何解決","2019-06-21 16:35:09","Git",[35,33],"GitHub","當參加團隊專案開發的時候，其實很容易發生程式碼衝突問題，那這邊就來講一下該如何解除衝突吧~",{"url":38,"title":39,"date":40,"updated":3,"category":13,"tags":41,"description":43,"readingMinutes":15},"\u002Fjavascript\u002F20190621\u002F538821393\u002F","CoffeeScript 三元運算子","2019-06-21 11:49:07",[13,42],"CoffeeScript","這邊紀錄一下 CoffeeScript 的三元運算子該如何撰寫",{"url":45,"title":46,"date":47,"updated":3,"category":13,"tags":48,"description":49,"readingMinutes":15},"\u002Fjavascript\u002F20190621\u002F4177225789\u002F","CoffeeScript event 沒有反應","2019-06-21 10:19:54",[13,42],"撰寫 CoffeeScript 的時候發生一件怪事情，event 事件竟然無法使用，所以這邊紀錄一下我曾經做過哪些事情以及解決方式",{"url":51,"title":5