[{"data":1,"prerenderedAt":85},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F102\u002F":3,"post-page:zh-Hant:102":4,"author-stats:zh-Hant:full":83},null,{"posts":5,"total":81,"totalPages":82},[6,15,22,32,39,45,52,60,68,74],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fhexo\u002F20190514\u002F1899427194\u002F","NexT 實用的設定與功能","2019-05-14 16:20:41","Hexo",[10,12],"NexT","這邊紀錄一下我的 NexT 修改了那些地方及一些不錯的插件安裝。","3",{"url":16,"title":17,"date":18,"updated":3,"category":10,"tags":19,"description":21,"readingMinutes":14},"\u002Fhexo\u002F20190514\u002F2072033203\u002F","Hexo搜尋引擎優化","2019-05-14 08:38:25",[10,20,12],"SEO","由於自己架設計部落格之後凡事都要自己來，所以這邊紀錄一下該如何加強 Hexo 的 SEO 部分。",{"url":23,"title":24,"date":25,"updated":3,"category":26,"tags":27,"description":31,"readingMinutes":14},"\u002Fvue\u002F20190513\u002F948497494\u002F","Vuejs部屬GitHub Pages","2019-05-13 19:34:56","Vue",[28,26,29,30],"JavaScript","Git","GitHub","開發 Vue.js 結束後接下來就是部屬上 GitHub，這邊紀錄一下指令該如何部屬到 GitHub Pages 吧~",{"url":33,"title":34,"date":35,"updated":3,"category":28,"tags":36,"description":37,"readingMinutes":38},"\u002Fjavascript\u002F20190511\u002F638155277\u002F","JavaScript基礎閉包觀念","2019-05-11 18:51:54",[28],"JavaScript 中有一個閉包的觀念，滿時常聽人家在講閉包閉包，稍微查了一下相關文章這邊也做一下筆記。","2",{"url":40,"title":41,"date":42,"updated":3,"category":26,"tags":43,"description":44,"readingMinutes":38},"\u002Fvue\u002F20190510\u002F1766915506\u002F","props與emit的傳遞方式","2019-05-10 19:04:33",[28,26],"這幾天自己突然又開始使用 Vue 來製作一個小東西，因為我都是用 components 來製作，所以勢必要了解 props 與 emit 之間是如何傳遞的。",{"url":46,"title":47,"date":48,"updated":49,"category":26,"tags":50,"description":51,"readingMinutes":38},"\u002Fvue\u002F20190510\u002F86469050\u002F","Vue 的 @（小老鼠）符號是什麼？src 路徑別名與 .. 的差異","2019-05-10 10:30:35","2026-06-11 09:00:00",[28,26],"在 Vue 專案的 import 路徑常看到 @ 這個小老鼠符號，它其實是 Vue CLI 幫你設定好的 src 路徑別名（alias）。這篇講清楚 @ 跟相對路徑 .. 的差異，以及 Vue CLI 2 與 3 的設定位置在哪。",{"url":53,"title":54,"date":55,"updated":55,"category":56,"tags":57,"description":59,"readingMinutes":38},"\u002Flearnexp\u002F20190509\u002F3880255625\u002F","適當的休息也是學習的一種方式","2019-05-09 22:18:55","學習經驗",[58,56],"其他","這陣子準備一個小作品同時也不停地幫忙一些私下找我聊聊的朋友們，發現有很多朋友都有一種不太好的習慣，這邊分享一下經驗:D",{"url":61,"title":62,"date":63,"updated":3,"category":64,"tags":65,"description":66,"readingMinutes":67},"\u002Fcss\u002F20190509\u002F1681665762\u002F","用CSS來判別跑版","2019-05-09 10:23:41","CSS",[64],"有時候我們在做 CSS 切版的時候常常會發生跑版的狀況，但是一般瀏覽器並沒有辦法提供給我們格線系統，所以這邊紀錄一下使用 CSS 來開啟格線。","1",{"url":69,"title":70,"date":71,"updated":3,"category":26,"tags":72,"description":73,"readingMinutes":67},"\u002Fvue\u002F20190508\u002F40080850\u002F","vuejs(cli)中使用wowjs","2019-05-08 22:10:45",[28,26],"最近正在製作一個小作品，因為是使用 Vue Cli 開發，這邊紀錄一下該如何在 Vue Cli 中使用 WOWJS",{"url":75,"title":76,"date":77,"updated":3,"category":28,"tags":78,"description":79,"readingMinutes":80},"\u002Fjavascript\u002F20190507\u002F3500556123\u002F","JavaScript全域變數與區域變數的差別","2019-05-07 15:33:37",[28],"JavaScript 中真的滿多坑可以撲倒新手的，一個不小心就踩到地雷，所以這一篇來講講全域變數及區域變數的差異吧~","4",1049,105,{"postCount":81,"tagCount":84},1050,1790179293981]