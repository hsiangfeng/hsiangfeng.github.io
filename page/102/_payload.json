[{"data":1,"prerenderedAt":85},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F102\u002F":3,"post-page:zh-Hant:102":4,"author-stats:zh-Hant:full":83},null,{"posts":5,"total":81,"totalPages":82},[6,16,23,29,38,45,54,60,66,73],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190515\u002F1050733096\u002F","[JS奇怪的世界]No.3 全域環境與全域物件","2019-05-15 11:30:35","克服JS奇怪的部分系列",[12,13],"JavaScript","JavaScript 全攻略:克服JS奇怪的部分","「全域環境」的觀念與「執行環境」也有一定的關係，一般來講當程式一開始執行時，都是在「全域環境」下，而這環境也是別人所寫好的一個程式，一個 「Global」","2",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190515\u002F3276113437\u002F","[JS奇怪的世界]No.2 觀念小提醒:名稱 and 值配對與物件","2019-05-15 10:54:35",[12,13],"簡單來講一個名稱只會配對一個唯一的值，觀念就像一個變數只會配一個值，而名稱可以被定義及變換值很多次，但是一般狀況下名稱只會對上一個值。","1",{"url":24,"title":25,"date":26,"updated":3,"category":10,"tags":27,"description":28,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190515\u002F2002773604\u002F","[JS奇怪的世界]No.1 觀念小提醒:語法解析器、執行環境、詞彙環境","2019-05-15 09:54:35",[12,13],"接下來將會開始一系列的 JS 奇怪的部分，主要是為了深入了解人稱世界上誤會最大的程式語言 JavaScript，也希望藉由這次的筆記能夠讓自己成長。",{"url":30,"title":31,"date":32,"updated":3,"category":33,"tags":34,"description":36,"readingMinutes":37},"\u002Fhexo\u002F20190514\u002F1899427194\u002F","NexT 實用的設定與功能","2019-05-14 16:20:41","Hexo",[33,35],"NexT","這邊紀錄一下我的 NexT 修改了那些地方及一些不錯的插件安裝。","3",{"url":39,"title":40,"date":41,"updated":3,"category":33,"tags":42,"description":44,"readingMinutes":37},"\u002Fhexo\u002F20190514\u002F2072033203\u002F","Hexo搜尋引擎優化","2019-05-14 08:38:25",[33,43,35],"SEO","由於自己架設計部落格之後凡事都要自己來，所以這邊紀錄一下該如何加強 Hexo 的 SEO 部分。",{"url":46,"title":47,"date":48,"updated":3,"category":49,"tags":50,"description":53,"readingMinutes":37},"\u002Fvue\u002F20190513\u002F948497494\u002F","Vuejs部屬GitHub Pages","2019-05-13 19:34:56","Vue",[12,49,51,52],"Git","GitHub","開發 Vue.js 結束後接下來就是部屬上 GitHub，這邊紀錄一下指令該如何部屬到 GitHub Pages 吧~",{"url":55,"title":56,"date":57,"updated":3,"category":12,"tags":58,"description":59,"readingMinutes":15},"\u002Fjavascript\u002F20190511\u002F638155277\u002F","JavaScript基礎閉包觀念","2019-05-11 18:51:54",[12],"JavaScript 中有一個閉包的觀念，滿時常聽人家在講閉包閉包，稍微查了一下相關文章這邊也做一下筆記。",{"url":61,"title":62,"date":63,"updated":3,"category":49,"tags":64,"description":65,"readingMinutes":15},"\u002Fvue\u002F20190510\u002F1766915506\u002F","props與emit的傳遞方式","2019-05-10 19:04:33",[12,49],"這幾天自己突然又開始使用 Vue 來製作一個小東西，因為我都是用 components 來製作，所以勢必要了解 props 與 emit 之間是如何傳遞的。",{"url":67,"title":68,"date":69,"updated":70,"category":49,"tags":71,"description":72,"readingMinutes":15},"\u002Fvue\u002F20190510\u002F86469050\u002F","Vue 的 @（小老鼠）符號是什麼？src 路徑別名與 .. 的差異","2019-05-10 10:30:35","2026-06-11 09:00:00",[12,49],"在 Vue 專案的 import 路徑常看到 @ 這個小老鼠符號，它其實是 Vue CLI 幫你設定好的 src 路徑別名（alias）。這篇講清楚 @ 跟相對路徑 .. 的差異，以及 Vue CLI 2 與 3 的設定位置在哪。",{"url":74,"title":75,"date":76,"updated":76,"category":77,"tags":78,"description":80,"readingMinutes":15},"\u002Flearnexp\u002F20190509\u002F3880255625\u002F","適當的休息也是學習的一種方式","2019-05-09 22:18:55","學習經驗",[79,77],"其他","這陣子準備一個小作品同時也不停地幫忙一些私下找我聊聊的朋友們，發現有很多朋友都有一種不太好的習慣，這邊分享一下經驗:D",1052,106,{"postCount":81,"tagCount":84},1059,1790438712191]