[{"data":1,"prerenderedAt":119},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F7\u002F":3,"post-page:zh-Hant:7":4,"author-stats:zh-Hant:full":117},null,{"posts":5,"total":115,"totalPages":116},[6,18,33,43,54,64,75,85,95,105],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":16,"readingMinutes":17},"\u002Fvue\u002F20251106\u002F1172686218\u002F","用 &lt;spec lang=\"md\"&gt; 標籤在 Vue 中舒服的使用 SFC 搭配 AI 開發","2025-11-06 13:45:34","2026-04-23 13:45:34","Vue",[11,13,14,15],"SFC","AI 開發","規格驅動開發","許多開發者都會搭配著 AI 工具（Claude Code、Gemini、Copilot 等）來協助撰寫程式碼，而在 Vue 的單檔元件（Single File Component, SFC）中，常常會遇到一些困擾，所以這邊就來分享一個不同的做法，也就是自訂一個 &lt;spec lang=\"md\"&gt; 標籤，來讓我們能夠在 SFC 中更舒服地使用 AI 工具來開發。","6",{"url":19,"title":20,"date":21,"updated":21,"category":22,"tags":23,"description":31,"readingMinutes":32},"\u002Fai\u002F20251102\u002F2069630219\u002F","生成式人工智慧與機器學習導論（1） - 其實都是文字接龍","2025-11-02 04:39:25","AI",[24,25,26,27,28,29,30],"生成式 AI","李宏毅","大語言模型","ChatGPT 原理","LLM 教學","AI 幻覺","Context Engineering","這幾年來 AI 技術發展非常快速，已經到達了連普通人都可以指揮 AI 幫忙做事的地步，尤其是大家所熟悉的 Vibe Coding 就是一個很好的例子，剛好台大的李宏毅老師在 2025 年開辦了一堂生成式 AI 與機器學習課程，就來寫一下這堂課的記錄跟心得吧～","8",{"url":34,"title":35,"date":36,"updated":37,"category":38,"tags":39,"description":41,"readingMinutes":42},"\u002Flearnexp\u002F20250930\u002F2883140524\u002F","【Day 30】目錄","2025-09-30 00:00:00","2026-05-07 21:00:00","學習經驗",[40],"Code Review 我的青春：從『嗶』聲開啟我的軟體工程師之路","系列總覽：30 天鐵人賽完整記錄，從電腦基礎、網路協定、程式語言、前端框架到職涯發展，時間軸與主題分類雙版本，幫助快速學習與查找。","4",{"url":44,"title":45,"date":46,"updated":37,"category":38,"tags":47,"description":52,"readingMinutes":53},"\u002Flearnexp\u002F20250929\u002F4192339363\u002F","【Day 29】十年工程師之路","2025-09-29 00:00:00",[40,48,49,50,51],"工程師十年歷程","AI時代程式員","技術職涯破版","程式學習心得","從「嗶」聲到十年：被遊戲點燃、被前端折磨、靠寫文成長、最後和 AI 共舞 —— 一路跌跌撞撞的工程師成長紀錄。","3",{"url":55,"title":56,"date":57,"updated":37,"category":38,"tags":58,"description":63,"readingMinutes":17},"\u002Flearnexp\u002F20250928\u002F1706365915\u002F","【Day 28】每一個學生的問題，都是我成