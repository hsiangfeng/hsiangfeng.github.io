[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F100\u002F":3,"post-page:zh-Hant:100":4,"author-stats:zh-Hant:full":75},null,{"posts":5,"total":73,"totalPages":74},[6,15,25,31,37,43,49,55,61,67],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fhexo\u002F20190517\u002F2562079032\u002F","Hexo Url優化(SEO)","2019-05-17 10:05:19","Hexo",[10,12],"SEO","由於 Hexo 本身 Url 的 SEO 狀況並不是設計非常漂亮，因為在 SEO 規範中文連結遠比英文連結差，所以這邊紀錄一下該如何使用。","1",{"url":16,"title":17,"date":18,"updated":3,"category":19,"tags":20,"description":23,"readingMinutes":24},"\u002Fjsweirdworld\u002F20190516\u002F803766782\u002F","[JS奇怪的世界]No.18 比較運算子","2019-05-16 21:16:35","克服JS奇怪的部分系列",[21,22],"JavaScript","JavaScript 全攻略:克服JS奇怪的部分","將下來講講 小於運算子，讓我們試著用程式碼來講解。","2",{"url":26,"title":27,"date":28,"updated":3,"category":19,"tags":29,"description":30,"readingMinutes":14},"\u002Fjsweirdworld\u002F20190516\u002F3588659278\u002F","[JS奇怪的世界]No.17 觀念小叮嚀:強制轉型","2019-05-16 21:01:35",[21,22],"強制轉型的意思是什麼?就是將原本的型別轉換成另一種，例如 String 變成 Boolean。",{"url":32,"title":33,"date":34,"updated":3,"category":19,"tags":35,"description":36,"readingMinutes":14},"\u002Fjsweirdworld\u002F20190516\u002F3658238475\u002F","[JS奇怪的世界]No.16 運算子的優先性與相依性","2019-05-16 20:34:35",[21,22],"這兩個在 JavaScript 是一個非常重要的名詞，其實非常重要的觀念，如果能瞭解其觀念，對於 debug 上是有一定幫助的。",{"url":38,"title":39,"date":40,"updated":3,"category":19,"tags":41,"description":42,"readingMinutes":14},"\u002Fjsweirdworld\u002F20190516\u002F2821553635\u002F","[JS奇怪的世界]No.15 觀念小叮嚀:運算子","2019-05-16 20:00:35",[21,22],"運算子可以說是 JavaScript 中提供的特殊方法也可以稱之為函數，並且可以協助我們做一些計算，那怎麼寫呢?",{"url":44,"title":45,"date":46,"updated":3,"category":19,"tags":47,"description":48,"readingMinutes":24},"\u002Fjsweirdworld\u002F20190516\u002F890725015\u002F","[JS奇怪的世界]No.14 純值","2019-05-16 19:30:35",[21,22],"前面已經針對 JavaScript 的型別做的一個簡易的介紹，而這章節課程將針對 JavaScript 動態型別瞭解以及其優缺點深入瞭解。",{"url":50,"title":51,"date":52,"updated":3,"category":19,"tags":53,"description":54,"readingMinutes":14},"\u002Fjsweirdworld\u002F20190516\u002F3276239225\u002F","[JS奇怪的世界]No.13 觀念小叮嚀-型別與JavaScript","2019-05-16 19:00:35",[21,22],"這一個章節是新的章節「型別與運算子」。",{"url":56,"title":57,"date":58,"updated":3,"category":19,"tags":59,"description":60,"readingMinutes":24},"\u002Fjsweirdworld\u002F20190516\u002F3421234703\u002F","[JS奇怪的世界]No.12 關於非同步回呼","2019-05-16 15:30:35",[21,22],"前面某一章節我有講過 JavaScipt 的同步執行，想必你也聽過很多所謂的非同步，但非同步是什麼?",{"url":62,"title":63,"date":64,"updated":3,"category":19,"tags":65,"description":66,"readingMinutes":14},"\u002Fjsweirdworld\u002F20190516\u002F2522156098\u002F","[JS奇怪的世界]No.11 範圍、ES6與let","2019-05-16 14:30:35",[21,22],"範圍所代表的意思是變數可以被取用的區域。",{"url":68,"title":69,"date":70,"updated":3,"category":19,"tags":71,"description":72,"readingMinutes":24},"\u002Fjsweirdworld\u002F20190516\u002F4036061119\u002F","[JS奇怪的世界]No.10 範圍鏈","2019-05-16 14:00:35",[21,22],"接下來要講得是「範圍鏈」，而這觀念並不會太難，因為在前面已經練習很多次了，更不用說上一章其實有講到範圍鏈(The Scope Chain)，一樣從課堂範例程式碼學習 ↓",1050,105,{"postCount":73,"tagCount":76},1053,1790265899462]