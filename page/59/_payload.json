[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F59\u002F":3,"post-page:zh-Hant:59":4,"author-stats:zh-Hant:full":87},null,{"posts":5,"total":85,"totalPages":86},[6,16,28,40,46,54,61,67,73,79],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fhexo\u002F20200914\u002F3741834499\u002F","(1) 試著學 Hexo - 序章","2020-09-14 20:58:06","Hexo",[10,12,13],"試著學 Hexo","第 12 屆 iT邦幫忙鐵人賽","為什麼要寫這個系列文章呢？比起 Hexo 選擇現成的部落格平台，不是更適合嗎？其實選擇 Hexo 來當作你的第一個架站工具是非常好上手的，你只需要掌握一些基本知識就可以快速的架設，那麼廢話不多說，讓我們來開始「試著」從零開始學習架設自己的第一個部落格吧！","2",{"url":17,"title":18,"date":19,"updated":20,"category":21,"tags":22,"description":26,"readingMinutes":27},"\u002Fgit\u002F20200914\u002F1124442109\u002F","淺談 Git Flow 與 commit 規範","2020-09-14 14:09:23","2022-11-16 08:05:46","Git",[21,23,24,25],"Git Flow","Commit 規範","GitHub","Git Flow 與 commit 一直都是許多 Git 新手的痛，畢竟一開始學習是很少會有機會碰到多人協作，因此來寫一篇筆記記錄一下什麼是 Git Flow 以及為什麼要做 commit 規範。","5",{"url":29,"title":30,"date":31,"updated":3,"category":32,"tags":33,"description":38,"readingMinutes":39},"\u002Fjavascript\u002F20200914\u002F617086885\u002F","PixiJS V5 教學 (32) - 重新開始製作","2020-09-14 08:40:30","JavaScript",[34,35,32,36,37],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","這一篇稍微輕鬆鬆一點接續上一篇，所以這一篇就來製作重新開始遊戲的方法。","1",{"url":41,"title":42,"date":43,"updated":3,"category":32,"tags":44,"description":45,"readingMinutes":39},"\u002Fjavascript\u002F20200907\u002F267037798\u002F","PixiJS V5 教學 (31) - 文字訊息","2020-09-07 08:49:56",[34,35,32,36,37],"接下來我們要來製作一下當碰撞死亡後出現的文字訊息。",{"url":47,"title":48,"date":49,"updated":3,"category":32,"tags":50,"description":53,"readingMinutes":15},"\u002Fjavascript\u002F20200905\u002F1375484447\u002F","JavaScript 核心觀念(30)-物件-淺層複製及深層複製","2020-09-05 23:22:53",[32,51,52],"JavaScript 核心篇","物件","接下來讓我們來了解什麼是淺層複製與深層複製吧。",{"url":55,"title":56,"date":57,"updated":3,"category":32,"tags":58,"description":59,"readingMinutes":60},"\u002Fjavascript\u002F20200904\u002F1772972600\u002F","JavaScript 核心觀念(29)-物件-Call by Reference 還是 Call by Sharing","2020-09-04 21:36:03",[32,51,52],"接下來談談什麼是 Call by Reference 還是 Call by Sharing","3",{"url":62,"title":63,"date":64,"updated":3,"category":32,"tags":65,"description":66,"readingMinutes":15},"\u002Fjavascript\u002F20200831\u002F384933159\u002F","PixiJS V5 教學 (30) - 遊戲循環","2020-08-31 13:45:57",[34,35,32,36,37],"接下來就準備要來做遊戲的循環，簡單來講就是 app.ticker.add((delta) => {...});",{"url":68,"title":69,"date":70,"updated":3,"category":32,"tags":71,"description":72,"readingMinutes":15},"\u002Fjavascript\u002F20200829\u002F48073682\u002F","JavaScript 核心觀念(28)-物件-物件參考之章節作業","2020-08-29 23:52:38",[32,51,52],"接下來這章節是物件參考的章節作業，這章節主要是確保物件傳參考的觀念有正確的吸收。",{"url":74,"title":75,"date":76,"updated":3,"category":32,"tags":77,"description":78,"readingMinutes":60},"\u002Fjavascript\u002F20200824\u002F3337702489\u002F","PixiJS V5 教學 (29) - treasureHunter (寶藏獵人)","2020-08-24 17:41:22",[34,35,32,36,37],"接下來我們差不多要來實作 treasureHunter (寶藏獵人) 的部分，所以這邊會慢慢拆解組合出一個簡易的寶藏獵人。",{"url":80,"title":81,"date":82,"updated":3,"category":32,"tags":83,"description":84,"readingMinutes":15},"\u002Fjavascript\u002F20200817\u002F3756686616\u002F","PixiJS V5 教學 (28) - JSON 加載圖片","2020-08-17 08:30:47",[34,35,32,36,37],"前一章節我們學會該如何裁切圖片，接下來就會另一種方式來加載圖片。",1039,104,{"postCount":85,"tagCount":88},1020,1789315466019]