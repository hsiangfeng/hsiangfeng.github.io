[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F79\u002F":3,"post-page:zh-Hant:79":4,"author-stats:zh-Hant:full":84},null,{"posts":5,"total":82,"totalPages":83},[6,15,23,32,40,47,55,63,69,75],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fgit\u002F20190802\u002F1198998279\u002F","GitHub 重新命名分支名稱","2019-08-02 10:52:04","Git",[12,10],"GitHub","有時候我們在開發的時候會遇到需要重新命名 GitHub 分支，但是總不能用刪除分支的方式來做處理，這樣子會導致先前的 commit 紀錄都消失，所以就來記錄一下該如何重新命名分支並 push 到 GitHub 上吧","1",{"url":16,"title":17,"date":18,"updated":3,"category":19,"tags":20,"description":22,"readingMinutes":14},"\u002Fvue\u002F20190801\u002F1336347183\u002F","Vue 出一個女友吧!-中場休息","2019-08-01 10:54:29","Vue",[19,21],"Vue 出一個女友吧","這一篇主要是紀錄目前做了哪些功能，所以並不會有太多技術性的東西",{"url":24,"title":25,"date":26,"updated":3,"category":27,"tags":28,"description":31,"readingMinutes":14},"\u002Fnodejs\u002F20190801\u002F449913843\u002F","無法辨識 'XXX' 詞彙是否為 Cmdlet、函數、指令檔或可執行程式的名稱","2019-08-01 10:28:33","Nodejs",[29,30],"Node.js","障礙排除","Windows PowerShell 突然每個指令都跳「無法辨識 XXX 詞彙是否為 Cmdlet」？這一篇分享我試過移除套件、重裝 Node 都無效之後， 從環境變數 Path 找到的真正解法。",{"url":33,"title":34,"date":35,"updated":3,"category":36,"tags":37,"description":39,"readingMinutes":14},"\u002Fphp\u002F20190731\u002F2973745480\u002F","Laravel-Vue ESLint 在 VSCode 上無法靜態使用的問題","2019-07-31 14:49:14","PHP",[36,19,38,30],"Laravel","由於最近專案開發上會使用到 Laravel-Vue，本身自己也會使用 ESLint 來管制自己得程式碼品質，但是不知道為什麼不管怎麼甚至就是沒有反應，所以這一篇來記錄一下怎麼解決",{"url":41,"title":42,"date":43,"updated":3,"category":44,"tags":45,"description":46,"readingMinutes":14},"\u002Fhexo\u002F20190730\u002F884035779\u002F","Hexo 指令失效","2019-07-30 11:51:48","Hexo",[44,30],"今天要準備撰寫文章的時候發生一個怪事，也就是 Hexo 的指令失效了，所以這一篇來記錄一下該如何解決",{"url":48,"title":49,"date":50,"updated":3,"category":36,"tags":51,"description":54,"readingMinutes":14},"\u002Fphp\u002F20190729\u002F3880646315\u002F","Composer 安裝","2019-07-29 20:48:44",[52,36,53],"環境安裝","Composer","這一篇來記錄 Composer 如何安裝吧",{"url":56,"title":57,"date":58,"updated":3,"category":59,"tags":60,"description":61,"readingMinutes":62},"\u002Fmysql\u002F20190729\u002F1187759096\u002F","MySQL 8.0.17.0 環境安裝","2019-07-29 17:53:31","MySQL",[52,59],"這一篇將會記錄 MySQL 5.7 以上的安裝流程，避免自己以後金魚腦忘記怎麼安裝","2",{"url":64,"title":65,"date":66,"updated":3,"category":19,"tags":67,"description":68,"readingMinutes":62},"\u002Fvue\u002F20190729\u002F4147561982\u002F","Vue 出一個女友吧!-上傳圖片","2019-07-29 16:36:59",[19,21],"這部分是屬於我忘記寫的地方(該打)，所以這一篇來補一下產品的圖片上傳",{"url":70,"title":71,"date":72,"updated":3,"category":19,"tags":73,"description":74,"readingMinutes":14},"\u002Fvue\u002F20190729\u002F371929708\u002F","Vue 出一個女友吧!-製作分頁邏輯-2","2019-07-29 16:17:31",[19,21],"從上一篇就可以了解到其實前端也是可以製作分頁邏輯的，但是會相當複雜，如果後端有做好相關的分頁邏輯 API 給前端那就會不一樣囉",{"url":76,"title":77,"date":78,"updated":3,"category":19,"tags":79,"description":80,"readingMinutes":81},"\u002Fvue\u002F20190729\u002F2401395670\u002F","Vue 出一個女友吧!-製作分頁邏輯-1","2019-07-29 09:47:57",[19,21],"接下來講講製作分頁邏輯的部分，好在本身 API 就已經有判斷分頁了","5",1049,105,{"postCount":82,"tagCount":85},1050,1790179295782]