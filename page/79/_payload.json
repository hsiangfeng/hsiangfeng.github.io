[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F79\u002F":3,"post-page:zh-Hant:79":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,16,24,32,38,45,53,59,65,71],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fphp\u002F20190729\u002F3880646315\u002F","Composer 安裝","2019-07-29 20:48:44","PHP",[12,10,13],"環境安裝","Composer","這一篇來記錄 Composer 如何安裝吧","1",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":22,"readingMinutes":23},"\u002Fmysql\u002F20190729\u002F1187759096\u002F","MySQL 8.0.17.0 環境安裝","2019-07-29 17:53:31","MySQL",[12,20],"這一篇將會記錄 MySQL 5.7 以上的安裝流程，避免自己以後金魚腦忘記怎麼安裝","2",{"url":25,"title":26,"date":27,"updated":3,"category":28,"tags":29,"description":31,"readingMinutes":23},"\u002Fvue\u002F20190729\u002F4147561982\u002F","Vue 出一個女友吧!-上傳圖片","2019-07-29 16:36:59","Vue",[28,30],"Vue 出一個女友吧","這部分是屬於我忘記寫的地方(該打)，所以這一篇來補一下產品的圖片上傳",{"url":33,"title":34,"date":35,"updated":3,"category":28,"tags":36,"description":37,"readingMinutes":15},"\u002Fvue\u002F20190729\u002F371929708\u002F","Vue 出一個女友吧!-製作分頁邏輯-2","2019-07-29 16:17:31",[28,30],"從上一篇就可以了解到其實前端也是可以製作分頁邏輯的，但是會相當複雜，如果後端有做好相關的分頁邏輯 API 給前端那就會不一樣囉",{"url":39,"title":40,"date":41,"updated":3,"category":28,"tags":42,"description":43,"readingMinutes":44},"\u002Fvue\u002F20190729\u002F2401395670\u002F","Vue 出一個女友吧!-製作分頁邏輯-1","2019-07-29 09:47:57",[28,30],"接下來講講製作分頁邏輯的部分，好在本身 API 就已經有判斷分頁了","5",{"url":46,"title":47,"date":48,"updated":3,"category":49,"tags":50,"description":51,"readingMinutes":52},"\u002Fjavascript\u002F20190728\u002F313613648\u002F","關於我逃出胡立的異世界 R30 這件事之攻略包","2019-07-28 10:08:31","JavaScript",[49],"由於這個系列是紀錄挑戰胡立分享的遊戲 [異世界?r3:0挑戰] 的挑戰紀錄，也不知道該算在哪個分類，所以就乾脆都放在 JavaScript 下囉~","4",{"url":54,"title":55,"date":56,"updated":3,"category":28,"tags":57,"description":58,"readingMinutes":15},"\u002Fvue\u002F20190727\u002F3081561859\u002F","Vue 出一個女友吧!-組件溝通 event bus","2019-07-27 17:16:15",[28,30],"接下來將會講一個東西叫做組件溝通 event bus，可是我個人比較喜歡講成元件溝通就是了...那麼 event bus 會拿來做什麼呢?來記錄一下吧",{"url":60,"title":61,"date":62,"updated":3,"category":28,"tags":63,"description":64,"readingMinutes":15},"\u002Fvue\u002F20190726\u002F2706745772\u002F","Vue 出一個女友吧!-vue-fontawesome","2019-07-26 21:09:13",[28,30],"接下來講講其中一個套件，也就是 vue-fontawesome，在前面我們已經安裝了，但是該怎麼使用呢?來記錄一下吧",{"url":66,"title":67,"date":68,"updated":3,"category":28,"tags":69,"description":70,"readingMinutes":15},"\u002Fvue\u002F20190725\u002F335001087\u002F","Vue 出一個女友吧!-loading","2019-07-25 21:43:11",[28,30],"接下來要來替產品新增、修改以及刪除時增加一個 loading 特效，這樣子對於使用者體驗也會比較好，那這邊就會使用到 vue-loading-overlay",{"url":72,"title":73,"date":74,"updated":3,"category":28,"tags":75,"description":76,"readingMinutes":77},"\u002Fvue\u002F20190725\u002F1855985718\u002F","Vue 出一個女友吧!-產品頁面","2019-07-25 20:14:34",[28,30],"接下來是製作產品相關的 API，這邊將會講到商品建立、取得商品列表、修改商品以及刪除商品","3",1044,105,{"postCount":78,"tagCount":81},1034,1789747495292]