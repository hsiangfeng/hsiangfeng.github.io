[{"data":1,"prerenderedAt":102},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F16\u002F":3,"post-page:zh-Hant:16":4,"author-stats:zh-Hant:full":100},null,{"posts":5,"total":98,"totalPages":99},[6,18,30,41,49,63,69,78,86,93],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":16,"readingMinutes":17},"\u002Fnuxt\u002F20231104\u002F4026785494\u002F","Nuxt 3.8.0 useFetch Error Cache 的問題","2023-11-04 00:00:19","2023-11-14 00:00:19","Nuxt",[13,14,15],"Nuxt3","useFetch","障礙排除","最近在使用 Nuxt3 的 useFetch 的時候發生了一點狀況，也就是 API 發生 Error 之後就無法再次觸發 API 的問題，所以這邊就來記錄一下。","3",{"url":19,"title":20,"date":21,"updated":22,"category":23,"tags":24,"description":28,"readingMinutes":29},"\u002Fjavascript\u002F20231031\u002F1586150719\u002F","Prettier 教學：你終究要用，為什麼不一開始就用？（VSCode 設定完整指南）","2023-10-31 10:33:52","2026-05-12 09:00:00","JavaScript",[23,25,26,27],"Prettier","ESLint","VSCode","在我們前端開發中，有一個非常重要的工具你一定要會用，也就是 Prettier，就算你現在不用，未來你也一定會用到，那為什麼不一開始就用「Prettier」呢？所以這一篇就來介紹如何使用 Prettier 吧！","5",{"url":31,"title":32,"date":33,"updated":33,"category":34,"tags":35,"description":39,"readingMinutes":40},"\u002Fother\u002F20231029\u002F4161770695\u002F","首頁總是不更新，關於被 Service Workers 雷的這件事","2023-10-29 00:12:47","雜談",[36,37,15,38],"Service Workers","PWA","Progressive Web Apps","最近發現部落格總是不更新，經過一番查找，發現是 Service Workers 的關係，這篇文章就來記錄一下。","2",{"url":42,"title":43,"date":44,"updated":44,"category":27,"tags":45,"description":47,"readingMinutes":48},"\u002Fvscode\u002F20231026\u002F54606935\u002F","VSCode 上 Vue 自訂元件失去高亮","2023-10-26 11:03:07",[15,27,46],"Vue","最近開發發現 Volar 的自訂元件高亮功能好像怪怪的，所以記錄一下原因。","1",{"url":50,"title":51,"date":52,"updated":52,"category":53,"tags":54,"description":61,"readingMinutes":62},"\u002Fnodejs\u002F20231024\u002F1839693229\u002F","Mac 開啟專案時，自動使用 nvm use 切換到專案的 Node 版本","2023-10-24 16:00:52","Nodejs",[55,56,57,58,59,60],"Node.js","nvm","zsh","oh-my-zsh","zsh-nvm","Powerlevel10k","身為一名 Node.js 相關的開發者，常常會遇到需要切換 Node.js 版本的情況，但是我們每個專案所使用的 Node.js 都不同，因此就很容易忘記切換版本，所以這一篇就要來記錄一下如何在 Mac 上開啟專案時，就自動使用 nvm 切換 Node 版本。","4",{"url":64,"title":65,"date":66,"updated":66,"category":11,"tags":67,"description":68,"readingMinutes":17},"\u002Fnuxt\u002F20231023\u002F2419347402\u002F","Nuxt3 綁定表單後無限觸發 API","2023-10-23 17:04:45",[13,11,15],"最近在開發 Nuxt3 的時候踩到一個 useFetch 的雷，剛好這個雷好像滿多朋友都有踩到，所以就順便記錄一下。",{"url":70,"title":71,"date":72,"updated":72,"category":34,"tags":73,"description":77,"readingMinutes":29},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31",[74,75,76],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。",{"url":79,"title":80,"date":81,"updated":81,"category":23,"tags":82,"description":84,"readingMinutes":85},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58",[23,83],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":87,"title":88,"date":89,"updated":89,"category":53,"tags":90,"description":92,"readingMinutes":17},"\u002Fnodejs\u002F20231015\u002F3466588754\u002F","Day31 - 目錄與補充資源","2023-10-15 00:00:01",[55,91],"《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","今天打算做一個總結了，所以這一篇主要就以回顧的方式來做一個總結哩～",{"url":94,"title":95,"date":96,"updated":96,"category":53,"tags":97,"description":92,"readingMinutes":40},"\u002Fnodejs\u002F20231014\u002F27552363\u002F","Day30-旅途告一個段落","2023-10-14 00:00:01",[55,91],1043,105,{"postCount":98,"tagCount":101},1032,1789660898297]