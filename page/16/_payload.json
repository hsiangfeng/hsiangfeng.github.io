[{"data":1,"prerenderedAt":107},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F16\u002F":3,"post-page:zh-Hant:16":4,"author-stats:zh-Hant:full":105},null,{"posts":5,"total":103,"totalPages":104},[6,18,30,41,51,59,73,79,88,96],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fother\u002F20231106\u002F3142223114\u002F","你為什麼要懂記憶體流失\u002F泄露（memory leak）","2023-11-06 16:57:44","雜談",[12,13,14,15],"記憶體","memory leak","記憶體流失","記憶體泄露","記憶體流失（memory leak）到底是什麼？為什麼開發者要懂？這一篇從主記憶體、快取、虛擬記憶體的差異講起，再聊 GC 怎麼運作、JavaScript 三種常見會默默吃光記憶體的寫法。","5",{"url":19,"title":20,"date":21,"updated":22,"category":23,"tags":24,"description":28,"readingMinutes":29},"\u002Fnuxt\u002F20231104\u002F4026785494\u002F","Nuxt 3.8.0 useFetch Error Cache 的問題","2023-11-04 00:00:19","2023-11-14 00:00:19","Nuxt",[25,26,27],"Nuxt3","useFetch","障礙排除","最近在使用 Nuxt3 的 useFetch 的時候發生了一點狀況，也就是 API 發生 Error 之後就無法再次觸發 API 的問題，所以這邊就來記錄一下。","3",{"url":31,"title":32,"date":33,"updated":34,"category":35,"tags":36,"description":40,"readingMinutes":17},"\u002Fjavascript\u002F20231031\u002F1586150719\u002F","Prettier 教學：你終究要用，為什麼不一開始就用？（VSCode 設定完整指南）","2023-10-31 10:33:52","2026-05-12 09:00:00","JavaScript",[35,37,38,39],"Prettier","ESLint","VSCode","在我們前端開發中，有一個非常重要的工具你一定要會用，也就是 Prettier，就算你現在不用，未來你也一定會用到，那為什麼不一開始就用「Prettier」呢？所以這一篇就來介紹如何使用 Prettier 吧！",{"url":42,"title":43,"date":44,"updated":44,"category":10,"tags":45,"description":49,"readingMinutes":50},"\u002Fother\u002F20231029\u002F4161770695\u002F","首頁總是不更新，關於被 Service Workers 雷的這件事","2023-10-29 00:12:47",[46,47,27,48],"Service Workers","PWA","Progressive Web Apps","最近發現部落格總是不更新，經過一番查找，發現是 Service Workers 的關係，這篇文章就來記錄一下。","2",{"url":52,"title":53,"date":54,"updated":54,"category":39,"tags":55,"description":57,"readingMinutes":58},"\u002Fvscode\u002F20231026\u002F54606935\u002F","VSCode 上 Vue 自訂元件失去高亮","2023-10-26 11:03:07",[27,39,56],"Vue","最近開發發現 Volar 的自訂元件高亮功能好像怪怪的，所以記錄一下原因。","1",{"url":60,"title":61,"date":62,"updated":62,"category":63,"tags":64,"description":71,"readingMinutes":72},"\u002Fnodejs\u002F20231024\u002F1839693229\u002F","Mac 開啟專案時，自動使用 nvm use 切換到專案的 Node 版本","2023-10-24 16:00:52","Nodejs",[65,66,67,68,69,70],"Node.js","nvm","zsh","oh-my-zsh","zsh-nvm","Powerlevel10k","身為一名 Node.js 相關的開發者，常常會遇到需要切換 Node.js 版本的情況，但是我們每個專案所使用的 Node.js 都不同，因此就很容易忘記切換版本，所以這一篇就要來記錄一下如何在 Mac 上開啟專案時，就自動使用 nvm 切換 Node 版本。","4",{"url":74,"title":75,"date":76,"updated":76,"category":23,"tags":77,"description":78,"readingMinutes":29},"\u002Fnuxt\u002F20231023\u002F2419347402\u002F","Nuxt3 綁定表單後無限觸發 API","2023-10-23 17:04:45",[25,23,27],"最近在開發 Nuxt3 的時候踩到一個 useFetch 的雷，剛好這個雷好像滿多朋友都有踩到，所以就順便記錄一下。",{"url":80,"title":81,"date":82,"updated":82,"category":10,"tags":83,"description":87,"readingMinutes":17},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31",[84,85,86],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。",{"url":89,"title":90,"date":91,"updated":91,"category":35,"tags":92,"description":94,"readingMinutes":95},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58",[35,93],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":97,"title":98,"date":99,"updated":99,"category":63,"tags":100,"description":102,"readingMinutes":29},"\u002Fnodejs\u002F20231015\u002F3466588754\u002F","Day31 - 目錄與補充資源","2023-10-15 00:00:01",[65,101],"《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","今天打算做一個總結了，所以這一篇主要就以回顧的方式來做一個總結哩～",1044,105,{"postCount":103,"tagCount":106},1034,1789747493900]