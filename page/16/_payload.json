[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F16\u002F":3,"post-page:zh-Hant:16":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,17,26,36,42,48,54,60,66,72],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":15,"readingMinutes":16},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31","雜談",[12,13,14],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。","5",{"url":18,"title":19,"date":20,"updated":20,"category":21,"tags":22,"description":24,"readingMinutes":25},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58","JavaScript",[21,23],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":27,"title":28,"date":29,"updated":29,"category":30,"tags":31,"description":34,"readingMinutes":35},"\u002Fnodejs\u002F20231015\u002F3466588754\u002F","Day31 - 目錄與補充資源","2023-10-15 00:00:01","Nodejs",[32,33],"Node.js","《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","今天打算做一個總結了，所以這一篇主要就以回顧的方式來做一個總結哩～","3",{"url":37,"title":38,"date":39,"updated":39,"category":30,"tags":40,"description":34,"readingMinutes":41},"\u002Fnodejs\u002F20231014\u002F27552363\u002F","Day30-旅途告一個段落","2023-10-14 00:00:01",[32,33],"2",{"url":43,"title":44,"date":45,"updated":45,"category":30,"tags":46,"description":47,"readingMinutes":16},"\u002Fnodejs\u002F20231013\u002F3280561145\u002F","Day29-關於 JWT 驗證","2023-10-13 00:00:01",[32,33],"接下來這一篇將會來介紹 JWT 的驗證，畢竟前面一直都沒提到，可是實戰上來講卻是非常重要的一環哩。",{"url":49,"title":50,"date":51,"updated":51,"category":30,"tags":52,"description":53,"readingMinutes":35},"\u002Fnodejs\u002F20231012\u002F3543796485\u002F","Day28-Google Extension 與 Google Apps Script 蹦再一起","2023-10-12 00:00:01",[32,33],"為了讓我們熟悉 Google Apps Script 的環境，那麼最快的方式就是實作，因此這邊就來整合 Google Extension 吧～",{"url":55,"title":56,"date":57,"updated":57,"category":30,"tags":58,"description":59,"readingMinutes":35},"\u002Fnodejs\u002F20231011\u002F1771923912\u002F","Day27-遇見 Google Apps Script","2023-10-11 00:00:01",[32,33],"OMG，這又是什麼新玩意了，接下來這一篇我們會稍微輕鬆一點來認識 Google Apps Script 是什麼東西，而且實戰上來講，也是非常的方便，因此我們就來看看 Google Apps Script 是什麼東西吧！",{"url":61,"title":62,"date":63,"updated":63,"category":30,"tags":64,"description":65,"readingMinutes":16},"\u002Fnodejs\u002F20231010\u002F3798507505\u002F","Day26-Google Extension 與 Vite","2023-10-10 00:00:01",[32,33],"前一篇我們對於 Google Extension 有了初步的認識，但我們實際開發上來講，必定會使用到人家開發好的套件，所以這一篇就會來使用 Vite 來開發 Google Extension。",{"url":67,"title":68,"date":69,"updated":69,"category":30,"tags":70,"description":71,"readingMinutes":35},"\u002Fnodejs\u002F20231009\u002F609773828\u002F","Day25-Google Extension","2023-10-09 00:00:01",[32,33],"又進入新的章節了，這章節我們要來介紹 Google Extension，那麼 Google Extension 是什麼呢？這一篇就讓我們來簡單的認識一下吧！",{"url":73,"title":74,"date":75,"updated":75,"category":30,"tags":76,"description":77,"readingMinutes":16},"\u002Fnodejs\u002F20231008\u002F2016996949\u002F","Day24-部署到 Zeabur","2023-10-08 00:00:01",[32,33],"前一面我們對於伺服器有基本概念後，接下來當然是要實際部署專案到伺服器上囉～",1037,104,{"postCount":78,"tagCount":81},1013,1785121396935]