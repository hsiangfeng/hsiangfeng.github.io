[{"data":1,"prerenderedAt":97},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F70\u002F":3,"post-page:zh-Hant:70":4,"author-stats:zh-Hant:full":95},null,{"posts":5,"total":93,"totalPages":94},[6,16,26,33,39,53,59,71,77,87],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjavascript\u002F20191209\u002F1271823341\u002F","世界上誤解最大的語言 JavaScript 之 JS 到底是同步與非同步語言?!","2019-12-09 10:38:53","JavaScript",[10,12,13],"Asynchronous","Synchronous","許多網路文章都可以看到大家都說 JavaScript 是一個非同步語言，但是經過一些事情觀念驗證後才發現，這個誤解可大了，所以這一篇就來講一下 JavaScript 到底是非同步語言還是同步語言。","3",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":24,"readingMinutes":25},"\u002Fhexo\u002F20191206\u002F2397475810\u002F","十分鐘超詳細替 Hexo Next 開啟 Gitalk 留言版","2019-12-06 20:10:01","Hexo",[20,22,23],"GitHub","Gitalk","最近決定將自己使用約快一年的 Disqus 換成 GitHub Gitalk，最主要原因是 Disqus 許多人留言常常收不到通知，發現的時候都已經過兩個禮拜甚至三個月以上，所以這一篇就來介紹如何快速開啟 Gitalk 吧!","2",{"url":27,"title":28,"date":29,"updated":3,"category":30,"tags":31,"description":32,"readingMinutes":25},"\u002Fpwa\u002F20191203\u002F2841782636\u002F","Day6-PWA 初體驗 - 小試身手","2019-12-03 09:53:48","PWA",[30],"前面真的講滿多廢話的，接下來這邊就準備拿一個小專案來小試身手囉~",{"url":34,"title":35,"date":36,"updated":3,"category":30,"tags":37,"description":38,"readingMinutes":25},"\u002Fpwa\u002F20191126\u002F3955439291\u002F","Day5-PWA 初體驗 - 開發環境","2019-11-26 09:24:48",[30],"前面講那麼多東西，也認識了基本的 PWA 架構，接下來就要來準備一下開發環境了。",{"url":40,"title":41,"date":42,"updated":3,"category":10,"tags":43,"description":51,"readingMinutes":52},"\u002Fjavascript\u002F20191119\u002F2727084611\u002F","有點長的淺談 JavaScript function 函式","2019-11-19 21:11:19",[10,44,45,46,47,48,49,50],"Function","Named Function","Anonymous Function","Arrow Function","IIFE","Vue","ES6","昨天在六角學院做了線上直播的介紹，過程真的是緊張到爆炸，我知道自己其實滿容易健忘的，所以不寫文章筆記心裡有點過意不去，因此這一篇 「有點長的淺談 JavaScript function 函式」就誕生了。","7",{"url":54,"title":55,"date":56,"updated":3,"category":30,"tags":57,"description":58,"readingMinutes":25},"\u002Fpwa\u002F20191114\u002F405525681\u002F","Day4-PWA 初體驗 - PWA 架構(二)","2019-11-14 22:56:48",[30],"這一篇將會介紹 PWA 的核心，也就是 Service Workers。",{"url":60,"title":61,"date":62,"updated":63,"category":64,"tags":65,"description":69,"readingMinutes":70},"\u002Fother\u002F20191111\u002F1875438261\u002F","Markdown 入門教學：常見語法與範例完整整理","2019-11-11 09:48:27","2026-03-18 13:20:00","雜談",[66,67,68],"Markdown","Markdown 教學","Markdown 語法","一篇涵蓋所有常見 Markdown 語法的入門教學，從標題、粗體、清單到表格與程式碼區塊，每個語法皆附範例與對應的 HTML 標籤說明，幫助你快速上手 Markdown 寫作。","4",{"url":72,"title":73,"date":74,"updated":3,"category":30,"tags":75,"description":76,"readingMinutes":25},"\u002Fpwa\u002F20191104\u002F3071954899\u002F","Day3-PWA 初體驗 - PWA 架構(一)","2019-11-04 17:24:48",[30],"接下來這一篇將會來了解 PWA 的架構，但是這邊將會拆成兩個章節介紹。",{"url":78,"title":79,"date":80,"updated":3,"category":64,"tags":81,"description":85,"readingMinutes":86},"\u002Fother\u002F20191028\u002F864994619\u002F","軟體工程師必學的文字對話藝術","2019-10-28 21:28:54",[82,83,84],"其他","軟體工程師","文字對話藝術","文字交流上其實有許多非常需要注意的事情，看似單純幾個中文字，但真正傳遞的感受是不同的，尤其是身為軟體工程師這個行業更不用說最常使用文字與他人溝通，所以這一篇將會來集中討論關於文字對話上的藝術。","5",{"url":88,"title":89,"date":90,"updated":3,"category":30,"tags":91,"description":92,"readingMinutes":25},"\u002Fpwa\u002F20191024\u002F1480429268\u002F","Day2-PWA 初體驗 - PWA 特色","2019-10-24 19:24:48",[30],"這一篇將會來介紹如何開啟 PWA 的特色。",1047,105,{"postCount":93,"tagCount":96},1044,1790006523704]