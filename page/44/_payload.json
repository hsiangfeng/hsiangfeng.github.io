[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F44\u002F":3,"post-page:zh-Hant:44":4,"author-stats:zh-Hant:full":87},null,{"posts":5,"total":85,"totalPages":86},[6,17,28,34,41,52,59,67,73,79],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":15,"readingMinutes":16},"\u002Fpython\u002F20211001\u002F4124098345\u002F","從 JavaScript 角度學 Python(30) - 爬蟲","2021-10-01 00:00:10","Python",[10,12,13,14],"JavaScript","從 JavaScript 角度學 Python","第 13 屆 iT邦幫忙鐵人賽","前面我們也已經學了不少的知識點，而這邊也進入了鐵人賽的最後一天，所以就來試著寫一個簡單的 ithelp 鐵人賽爬蟲。","5",{"url":18,"title":19,"date":20,"updated":3,"category":21,"tags":22,"description":26,"readingMinutes":27},"\u002Fother\u002F20210930\u002F3267246146\u002F","將 Chrome 網頁開發者工具 (Chrome DevTool) 中文化","2021-09-30 23:56:35","雜談",[23,24,25],"Chrome","Chrome DevTool","中文化","不喜歡英文嗎？不用怕，這一篇教你怎麼把 Chrome 的網頁開發者工具 (Chrome DevTool) 中文化。","1",{"url":29,"title":30,"date":31,"updated":3,"category":10,"tags":32,"description":33,"readingMinutes":16},"\u002Fpython\u002F20210930\u002F691102834\u002F","從 JavaScript 角度學 Python(29) - BeautifulSoup","2021-09-30 00:00:10",[10,12,13,14],"已經準備進入鐵人賽的尾巴，所以這一篇就來介紹一個很常見的套件，也就是 BeautifulSoup，而這套件也是爬蟲很常使用的套件，所以接下來就讓我們來學習使用 BeautifulSoup 吧。",{"url":35,"title":36,"date":37,"updated":3,"category":10,"tags":38,"description":39,"readingMinutes":40},"\u002Fpython\u002F20210929\u002F585008686\u002F","從 JavaScript 角度學 Python(28) - 閉包(Closure)","2021-09-29 00:00:10",[10,12,13,14],"那 JavaScript 中有一個東西叫做閉包 (Closure)，Python 也會有嗎？所以這章節就輕鬆的聊一下如果你想要在 Python 中寫閉包的話該如何撰寫。","3",{"url":42,"title":43,"date":44,"updated":3,"category":21,"tags":45,"description":50,"readingMinutes":51},"\u002Fother\u002F20210928\u002F2005731696\u002F","Postman 如何使用 HMAC 以 TDX API 為例","2021-09-28 11:55:21",[46,47,48,49],"Postman","TDX API","HMAC","jsSHA","由於近期 The F2E 第三屆準備開跑了，那身為工程師最常用的 Postman 就會很常被拿來試戳 API，所以就紀錄一下如何使用 Postman 戳 TDX API。","2",{"url":53,"title":54,"date":55,"updated":3,"category":10,"tags":56,"description":57,"readingMinutes":58},"\u002Fpython\u002F20210928\u002F4211341551\u002F","從 JavaScript 角度學 Python(27) - 傳值？傳參考？","2021-09-28 00:00:10",[10,12,13,14],"已經快到鐵人賽的結尾了，但是我現在才想到我好像少講了一個東西，就是關於傳值與傳參考的部分，所以這一篇就來聊一下關於傳值與傳參考吧。","6",{"url":60,"title":61,"date":62,"updated":3,"category":63,"tags":64,"description":66,"readingMinutes":27},"\u002Fvscode\u002F20210927\u002F2674618084\u002F","VSCode terminal.integrated.shell.osx 屬性失效","2021-09-27 10:08:06","VSCode",[63,65],"障礙排除","最近 VSCode 發現終端機的 terminal.integrated.shell.osx 設置失效了，所以記錄一下問題跟解決方式。",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":40},"\u002Fpython\u002F20210927\u002F2772560677\u002F","從 JavaScript 角度學 Python(26) - 指定直譯器","2021-09-27 00:00:10",[10,12,13,14],"這一章節開始讓自己腦袋輕鬆一點好了，畢竟前面也學了不少的東西，所以這邊就聊點簡單的好了。",{"url":74,"title":75,"date":76,"updated":3,"category":10,"tags":77,"description":78,"readingMinutes":16},"\u002Fpython\u002F20210926\u002F4028850576\u002F","從 JavaScript 角度學 Python(25) - 例外處理","2021-09-26 00:00:10",[10,12,13,14],"接下來我們要聊一個非常非常重要的東西，也就是關於錯誤的處理，而這個處理又稱之為例外處理。",{"url":80,"title":81,"date":82,"updated":3,"category":10,"tags":83,"description":84,"readingMinutes":40},"\u002Fpython\u002F20210925\u002F2051252749\u002F","從 JavaScript 角度學 Python(24) - 繼承","2021-09-25 00:00:10",[10,12,13,14],"前一篇已經提前預告接下來將會講繼承了，所以這一篇當然就是會介紹繼承啦~(廢話)",1050,105,{"postCount":85,"tagCount":88},1053,1790347327676]