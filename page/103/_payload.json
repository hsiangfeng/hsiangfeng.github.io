[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F103\u002F":3,"post-page:zh-Hant:103":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,15,22,32,39,45,52,60,66,72],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Flearnexp\u002F20190426\u002F43778186\u002F","學習時的心態調整","2019-04-26 15:35:12","學習經驗",[12,10],"其他","最近在幫忙幾位朋友解決學習上的問題時，發現很常出現幾種問題，也跟自己當初的狀況很類似，所以就乾脆寫一下自己的心得分享...","3",{"url":16,"title":17,"date":18,"updated":3,"category":19,"tags":20,"description":21,"readingMinutes":14},"\u002Fjavascript\u002F20190426\u002F1966510488\u002F","關於 Array.prototype.sort() 排序這件不小的小事","2019-04-26 10:04:22","JavaScript",[19],"先前寫了一篇關於 JavaScript 陣列 20 種操作的方法，其中就有朋友對於 sort() 有點疑問不清楚原理，在被詢問時我自己也突然疑惑了一下，所以決定自己針對 sort() 來做一下研究了解原理。",{"url":23,"title":24,"date":25,"updated":3,"category":26,"tags":27,"description":30,"readingMinutes":31},"\u002Fnodejs\u002F20190425\u002F3663458445\u002F","Express自訂SASS\u002FSCSS路徑","2019-04-25 13:57:16","Nodejs",[28,29],"Node.js","障礙排除","前面有撰寫一篇如何Nodejs-Express中撰寫SCSS，剛寫完就遇到一個問題...所以這邊果斷再寫一篇該如何自訂 SASS\u002FSCSS 路徑","2",{"url":33,"title":34,"date":35,"updated":3,"category":26,"tags":36,"description":37,"readingMinutes":38},"\u002Fnodejs\u002F20190425\u002F1258950236\u002F","Nodejs-Express中撰寫SCSS","2019-04-25 12:29:13",[28],"最近正在學習 Nodejs-Express 開發，礙於自己本身所學習是 SCSS 預處理器，可是網路上好像找不到相關解決方式，所以這邊紀錄一下...","1",{"url":40,"title":41,"date":42,"updated":3,"category":19,"tags":43,"description":44,"readingMinutes":31},"\u002Fjavascript\u002F20190424\u002F2772517253\u002F","JavaScript奇妙的題目","2019-04-24 20:41:32",[19],"JavaScript 在很多地方都非常的奇妙又好玩，過陣子也準備進入 js 奇妙的章節...先來做一下記錄前陣子在學院中人家的 js 問題。",{"url":46,"title":47,"date":48,"updated":3,"category":19,"tags":49,"description":50,"readingMinutes":51},"\u002Fjavascript\u002F20190421\u002F1216566123\u002F","關於 JavaScript 陣列 20 種操作的方法","2019-04-21 11:56:53",[19],"這篇文章主要是觀看了偷米騎巴哥]操作JS陣列的20種方式而撰寫的，因為覺得這張圖真的是精華","7",{"url":53,"title":54,"date":55,"updated":3,"category":56,"tags":57,"description":59,"readingMinutes":31},"\u002FSCSS\u002F20190421\u002F968240674\u002F","SCSS學習-mixin(五)","2019-04-21 07:24:30","SCSS",[56,58],"SCSS 學習手冊","前一篇主要講解 @import 使用方式，這篇會慢慢結合前面所寫的教學來統整製作，接下來將會講解 mixin，mixin 又是什麼呢?我會把它當作一個 SCSS 資料庫，因為這裡面會放很多自己常用的 SCSS",{"url":61,"title":62,"date":63,"updated":3,"category":19,"tags":64,"description":65,"readingMinutes":31},"\u002Fjavascript\u002F20190419\u002F3635730318\u002F","Javascript中的hoisting","2019-04-19 20:33:08",[19],"今天參加了六角學院 JavaScript 線上問答時，發現自己對於這個觀念上有些地方不太正確，所以寫一下做紀錄。",{"url":67,"title":68,"date":69,"updated":3,"category":56,"tags":70,"description":71,"readingMinutes":31},"\u002FSCSS\u002F20190419\u002F947541843\u002F","SCSS學習-import(四)","2019-04-19 17:24:30",[56,58],"SCSS 中有提供一個 @import 功能，如果使用的妥當就可以開發上管理的方便。",{"url":73,"title":74,"date":75,"updated":3,"category":19,"tags":76,"description":77,"readingMinutes":78},"\u002Fjavascript\u002F20190418\u002F1842588803\u002F","關於this是一個很神奇的東西這件事情","2019-04-18 19:46:16",[19],"我學習 JavaScript 中令我感到最痛苦最煩惱的其中一個東西就是 this，所以這邊就針對 this 來做一下紀錄學習。","5",1042,105,{"postCount":79,"tagCount":82},1028,1789574462291]