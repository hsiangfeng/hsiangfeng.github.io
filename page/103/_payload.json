[{"data":1,"prerenderedAt":85},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F103\u002F":3,"post-page:zh-Hant:103":4,"author-stats:zh-Hant:full":83},null,{"posts":5,"total":81,"totalPages":82},[6,15,22,29,37,44,53,62,69,75],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190508\u002F40080850\u002F","vuejs(cli)中使用wowjs","2019-05-08 22:10:45","Vue",[12,10],"JavaScript","最近正在製作一個小作品，因為是使用 Vue Cli 開發，這邊紀錄一下該如何在 Vue Cli 中使用 WOWJS","1",{"url":16,"title":17,"date":18,"updated":3,"category":12,"tags":19,"description":20,"readingMinutes":21},"\u002Fjavascript\u002F20190507\u002F3500556123\u002F","JavaScript全域變數與區域變數的差別","2019-05-07 15:33:37",[12],"JavaScript 中真的滿多坑可以撲倒新手的，一個不小心就踩到地雷，所以這一篇來講講全域變數及區域變數的差異吧~","4",{"url":23,"title":24,"date":25,"updated":3,"category":26,"tags":27,"description":28,"readingMinutes":14},"\u002Fhexo\u002F20190506\u002F2831397096\u002F","Hexo使用特殊符號sitemap會出現錯誤","2019-05-06 20:42:07","Hexo",[26],"最近在調整 Hexo 的 SEO 時發現 sitemap 竟然出現錯誤?!",{"url":30,"title":31,"date":32,"updated":3,"category":33,"tags":34,"description":35,"readingMinutes":36},"\u002Fanalytics\u002F20190506\u002F1879363764\u002F","如何使用GA來替自己網站作分析","2019-05-06 15:42:13","Analytics",[33,26],"這一篇主要是被朋友推坑下來做撰寫得，所以這邊會介紹該如何埋入 Analytics，就是俗稱得 GA 分析，只要你有自己的網站、部落格，我推薦要使用 GA 分析，這可以讓自己了解到自己那些文章是屬於熱門文章。","2",{"url":38,"title":39,"date":40,"updated":3,"category":12,"tags":41,"description":42,"readingMinutes":43},"\u002Fjavascript\u002F20190505\u002F1432256317\u002F","JavaScript 製作分頁功能(使用 Fetch APIs)","2019-05-05 15:06:43",[12],"開網站會很長需要使用到分頁的功能，有些是在後端處理之後往前端丟，這種通常比較不擔心那麼多，只需要在資料庫做好相關設置就好了，可是如果今天後端將所有資料一次往前端丟那麼就要自己來刻分頁邏輯，所以寫一篇文章加強自己的分頁邏輯撰寫。","7",{"url":45,"title":46,"date":47,"updated":47,"category":48,"tags":49,"description":51,"readingMinutes":52},"\u002Flearnexp\u002F20190503\u002F3738458215\u002F","該如何制定自己的學習","2019-05-03 09:53:55","學習經驗",[50,48],"其他","今天又寫了一篇心得分享，主要原因出在先前所撰寫的三篇文章該如何正確的學習前端技術&程式語言、學習心態調整及你願意犧牲多少來得到你想要的事物，很多人都來詢問該如何學習及撰寫筆記這方面的問題，所以我也寫一下我提供的建議。","6",{"url":54,"title":55,"date":56,"updated":3,"category":57,"tags":58,"description":61,"readingMinutes":14},"\u002Fnodejs\u002F20190503\u002F2483499053\u002F","nodejs出現錯誤代碼500","2019-05-03 09:06:26","Nodejs",[59,60],"Node.js","障礙排除","昨天在弄 nodejs 的時候發生一件很奇妙的事情，前一天使用 ajax 還很正常，昨天突然 ajax 掛掉了...最後今天發現原因紀錄一下自己多白癡。",{"url":63,"title":64,"date":65,"updated":65,"category":48,"tags":66,"description":67,"readingMinutes":68},"\u002Flearnexp\u002F20190502\u002F4023370690\u002F","你願意犧牲多少來得到你想要的事物?","2019-05-02 10:24:41",[50,48],"許多時候我們都必須去作出選擇，先前六角學院的廖老師有分享過前端求職履歷面試全攻略的影音心得，其中裡面有講到你願意為了達到目標犧牲多少?","3",{"url":70,"title":71,"date":72,"updated":3,"category":57,"tags":73,"description":74,"readingMinutes":14},"\u002Fnodejs\u002F20190429\u002F1130866276\u002F","nodejs神奇的兩次Request","2019-04-29 20:06:34",[59,60],"由於最近再進修 Nodejs + firebase ，所以也挪不太出時間來寫文章，但是練習 Nodejs 過程中遇到一個很低級&智障問題，結果因此卡了三天，所以這邊做一下紀錄。",{"url":76,"title":77,"date":78,"updated":78,"category":48,"tags":79,"description":80,"readingMinutes":68},"\u002Flearnexp\u002F20190426\u002F43778186\u002F","學習時的心態調整","2019-04-26 15:35:12",[50,48],"最近在幫忙幾位朋友解決學習上的問題時，發現很常出現幾種問題，也跟自己當初的狀況很類似，所以就乾脆寫一下自己的心得分享...",1051,106,{"postCount":81,"tagCount":84},1057,1790352092949]