[{"data":1,"prerenderedAt":88},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F67\u002F":3,"post-page:zh-Hant:67":4,"author-stats:zh-Hant:full":86},null,{"posts":5,"total":84,"totalPages":85},[6,18,25,34,40,47,55,61,70,78],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fjavascript\u002F20200330\u002F363291611\u002F","PixiJS V5 教學 (8) - Ticker(2)","2020-03-30 08:20:14","JavaScript",[12,13,10,14,15],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前面終於讓圖片動起來了，接下來這一篇就輕鬆一點試著了解一下剛剛移動圖片的 API 還有哪些吧~","1",{"url":19,"title":20,"date":21,"updated":3,"category":10,"tags":22,"description":23,"readingMinutes":24},"\u002Fjavascript\u002F20200323\u002F2334412373\u002F","PixiJS V5 教學 (7) - Ticker","2020-03-23 09:01:18",[12,13,10,14,15],"前面已經學會引入圖片，那麼單純只是引入圖片有點無聊，所以來試著移動圖片吧~","2",{"url":26,"title":27,"date":28,"updated":28,"category":29,"tags":30,"description":32,"readingMinutes":33},"\u002Flearnexp\u002F20200317\u002F2499808266\u002F","履歷該放什麼？作業還是作品？","2020-03-17 08:27:48","學習經驗",[31,29],"履歷","身為一名跨行轉職的新人工程師，往往都會犯一個很嚴重的錯誤，也就是將課堂上的作業當作作品集來使用。","4",{"url":35,"title":36,"date":37,"updated":3,"category":10,"tags":38,"description":39,"readingMinutes":24},"\u002Fjavascript\u002F20200316\u002F2334412373\u002F","PixiJS V5 教學 (6) - Texture(2)","2020-03-16 08:39:30",[12,13,10,14,15],"上一篇介紹了使用 new PIXI.Loader(); 的方式來渲染圖片，這一篇則會介紹另一種寫法。",{"url":41,"title":42,"date":43,"updated":3,"category":10,"tags":44,"description":46,"readingMinutes":24},"\u002Fjavascript\u002F20200313\u002F3743352418\u002F","淺談 JavaScript 中的 Debug 神器 Console","2020-03-13 10:51:48",[10,45],"console","在寫 JavaScript 時，其實我們會很長使用 console 來 debug，所以這一篇來淺談一下 console 吧。",{"url":48,"title":49,"date":50,"updated":3,"category":51,"tags":52,"description":54,"readingMinutes":17},"\u002Fvscode\u002F20200312\u002F457161302\u002F","Visual Studio Code(VSCode) 1.43 高亮問題","2020-03-12 10:20:20","VSCode",[51,53],"障礙排除","這幾天 Visual Studio Code(VSCode) 更新成了 1.43，但卻發生高亮不太正常?!不知道是刻意改的還是不正常的關係，所以這一篇紀錄一下該如何解決。",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":60,"readingMinutes":24},"\u002Fjavascript\u002F20200309\u002F2684951958\u002F","PixiJS V5 教學 (5) - Texture","2020-03-09 08:15:00",[12,13,10,14,15],"有引入文字那麼就會有引入圖片啦~而 PIXI 會使用 GPU 以及 WebGL 來渲染圖片，而圖片需要經過處理才能夠使用的，而通常處理好的圖片都會稱為 Texture。",{"url":62,"title":63,"date":64,"updated":3,"category":10,"tags":65,"description":68,"readingMinutes":69},"\u002Fjavascript\u002F20200308\u002F3384986223\u002F","Fetch API 到底是 ESMAScript6 還是 Web APIs?","2020-03-08 12:07:26",[10,66,67],"ESMAScript6","Fetch API","Fetch API 是一個很多人會誤解的一個語法，最大誤解大概就是無法區分這一個語法到底是屬於 ECMAScript6 還是 Web APIs，所以這一篇來詳解一下吧。","3",{"url":71,"title":72,"date":73,"updated":3,"category":10,"tags":74,"description":77,"readingMinutes":69},"\u002Fjavascript\u002F20200307\u002F1405700237\u002F","JavaScript 核心觀念(1)-執行環境與作用域-JavaScript 運作方式","2020-03-07 21:37:04",[10,75,76],"JavaScript 核心篇","執行環境與作用域","第一篇將會來了解 JavaScript 的運作模式，",{"url":79,"title":80,"date":81,"updated":3,"category":10,"tags":82,"description":83,"readingMinutes":33},"\u002Fjavascript\u002F20200307\u002F318160061\u002F","JavaScript 核心觀念(0)-目錄及前言","2020-03-07 21:27:49",[10,75],"JavaScript 核心篇是基於六角學院的線上影音課程而撰寫的系列文章，雖然自己本身已經有上過 JavaScript 奇怪的部份，但每一位講者都有屬於他的講解方式，所以這一篇也來開始做一次紀錄以及學習囉。",1050,105,{"postCount":84,"tagCount":87},1053,1790265673914]