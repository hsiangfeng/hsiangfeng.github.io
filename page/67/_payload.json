[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F67\u002F":3,"post-page:zh-Hant:67":4,"author-stats:zh-Hant:full":89},null,{"posts":5,"total":87,"totalPages":88},[6,16,28,35,44,50,57,65,71,79],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fother\u002F20200402\u002F69728820\u002F","如何讓 Google 廣告(AdSense)收益？","2020-04-02 22:12:01","雜談",[12,13],"Google","Google AdSense","這一篇僅僅只是紀錄如何讓自己部落格的廣告收益增加的一些小眉角而已，最主要是說明該如何放廣吿才是比較好的狀況。","3",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":26,"readingMinutes":27},"\u002Fjavascript\u002F20200330\u002F363291611\u002F","PixiJS V5 教學 (8) - Ticker(2)","2020-03-30 08:20:14","JavaScript",[22,23,20,24,25],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前面終於讓圖片動起來了，接下來這一篇就輕鬆一點試著了解一下剛剛移動圖片的 API 還有哪些吧~","1",{"url":29,"title":30,"date":31,"updated":3,"category":20,"tags":32,"description":33,"readingMinutes":34},"\u002Fjavascript\u002F20200323\u002F2334412373\u002F","PixiJS V5 教學 (7) - Ticker","2020-03-23 09:01:18",[22,23,20,24,25],"前面已經學會引入圖片，那麼單純只是引入圖片有點無聊，所以來試著移動圖片吧~","2",{"url":36,"title":37,"date":38,"updated":38,"category":39,"tags":40,"description":42,"readingMinutes":43},"\u002Flearnexp\u002F20200317\u002F2499808266\u002F","履歷該放什麼？作業還是作品？","2020-03-17 08:27:48","學習經驗",[41,39],"履歷","身為一名跨行轉職的新人工程師，往往都會犯一個很嚴重的錯誤，也就是將課堂上的作業當作作品集來使用。","4",{"url":45,"title":46,"date":47,"updated":3,"category":20,"tags":48,"description":49,"readingMinutes":34},"\u002Fjavascript\u002F20200316\u002F2334412373\u002F","PixiJS V5 教學 (6) - Texture(2)","2020-03-16 08:39:30",[22,23,20,24,25],"上一篇介紹了使用 new PIXI.Loader(); 的方式來渲染圖片，這一篇則會介紹另一種寫法。",{"url":51,"title":52,"date":53,"updated":3,"category":20,"tags":54,"description":56,"readingMinutes":34},"\u002Fjavascript\u002F20200313\u002F3743352418\u002F","淺談 JavaScript 中的 Debug 神器 Console","2020-03-13 10:51:48",[20,55],"console","在寫 JavaScript 時，其實我們會很長使用 console 來 debug，所以這一篇來淺談一下 console 吧。",{"url":58,"title":59,"date":60,"updated":3,"category":61,"tags":62,"description":64,"readingMinutes":27},"\u002Fvscode\u002F20200312\u002F457161302\u002F","Visual Studio Code(VSCode) 1.43 高亮問題","2020-03-12 10:20:20","VSCode",[61,63],"障礙排除","這幾天 Visual Studio Code(VSCode) 更新成了 1.43，但卻發生高亮不太正常?!不知道是刻意改的還是不正常的關係，所以這一篇紀錄一下該如何解決。",{"url":66,"title":67,"date":68,"updated":3,"category":20,"tags":69,"description":70,"readingMinutes":34},"\u002Fjavascript\u002F20200309\u002F2684951958\u002F","PixiJS V5 教學 (5) - Texture","2020-03-09 08:15:00",[22,23,20,24,25],"有引入文字那麼就會有引入圖片啦~而 PIXI 會使用 GPU 以及 WebGL 來渲染圖片，而圖片需要經過處理才能夠使用的，而通常處理好的圖片都會稱為 Texture。",{"url":72,"title":73,"date":74,"updated":3,"category":20,"tags":75,"description":78,"readingMinutes":15},"\u002Fjavascript\u002F20200308\u002F3384986223\u002F","Fetch API 到底是 ESMAScript6 還是 Web APIs?","2020-03-08 12:07:26",[20,76,77],"ESMAScript6","Fetch API","Fetch API 是一個很多人會誤解的一個語法，最大誤解大概就是無法區分這一個語法到底是屬於 ECMAScript6 還是 Web APIs，所以這一篇來詳解一下吧。",{"url":80,"title":81,"date":82,"updated":3,"category":20,"tags":83,"description":86,"readingMinutes":15},"\u002Fjavascript\u002F20200307\u002F1405700237\u002F","JavaScript 核心觀念(1)-執行環境與作用域-JavaScript 運作方式","2020-03-07 21:37:04",[20,84,85],"JavaScript 核心篇","執行環境與作用域","第一篇將會來了解 JavaScript 的運作模式，",1051,106,{"postCount":87,"tagCount":90},1057,1790352094547]