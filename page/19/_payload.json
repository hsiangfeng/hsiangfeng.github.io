[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F19\u002F":3,"post-page:zh-Hant:19":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,16,24,31,38,44,50,56,62,68],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20230930\u002F4076915411\u002F","Day16 - 續談爬蟲（上）","2023-09-30 00:00:01","Nodejs",[12,13],"Node.js","《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","接下來這一篇也是針對爬蟲來介紹，但是會去撈一些比較複雜的資料。","6",{"url":17,"title":18,"date":19,"updated":20,"category":10,"tags":21,"description":22,"readingMinutes":23},"\u002Fnodejs\u002F20230929\u002F3878806252\u002F","Day15 - 第一個爬蟲","2023-09-29 00:00:01","2023-11-19 00:00:01",[12,13],"前一篇我們對於爬蟲應該有一些基本的概念與認知了，接下來當然就是要來實作一下囉。","5",{"url":25,"title":26,"date":27,"updated":27,"category":10,"tags":28,"description":29,"readingMinutes":30},"\u002Fnodejs\u002F20230928\u002F2824059455\u002F","Day14 - 網頁爬蟲？","2023-09-28 00:00:01",[12,13],"這一篇基本上我打算輕鬆一點介紹爬蟲就好，所以這一篇的篇幅或許會比以往前面少很多，主要也是讓大腦可以輕鬆一點。","3",{"url":32,"title":33,"date":34,"updated":34,"category":10,"tags":35,"description":36,"readingMinutes":37},"\u002Fnodejs\u002F20230927\u002F4133508926\u002F","Day13 - 替你的 Express 戴上頭盔吧！","2023-09-27 00:00:01",[12,13],"前面介紹了 CORS 跟 Env 可以說是基本的基本，接下來要來介紹一個很特別的東西，叫做 Helmet。","4",{"url":39,"title":40,"date":41,"updated":41,"category":10,"tags":42,"description":43,"readingMinutes":15},"\u002Fnodejs\u002F20230926\u002F1829302614\u002F","Day12 - 關於 CORS 與 Env","2023-09-26 00:00:01",[12,13],"前一篇我們完成了 Express + Mongoose 的整合，接下來我們要來處理一些環境變數的問題，以及 CORS 的問題。",{"url":45,"title":46,"date":47,"updated":47,"category":10,"tags":48,"description":49,"readingMinutes":23},"\u002Fnodejs\u002F20230925\u002F3347882734\u002F","Day11 - Express 與 Mongoose","2023-09-25 00:00:01",[12,13],"在上一篇文章中，我們初步建立了 MongoDB Atlas 的帳號，並且快速認識了 Mongoose，接下來當然就是要來整合再一起啦～",{"url":51,"title":52,"date":53,"updated":53,"category":10,"tags":54,"description":55,"readingMinutes":23},"\u002Fnodejs\u002F20230924\u002F3283299199\u002F","Day10 - MongoDB 與 Mongoose","2023-09-24 00:00:01",[12,13],"前一篇我們初步對於資料庫有了一點概念後，接下來當然要進入資料庫章節啦～",{"url":57,"title":58,"date":59,"updated":59,"category":10,"tags":60,"description":61,"readingMinutes":23},"\u002Fnodejs\u002F20230923\u002F264010765\u002F","Day9 - What is a database？","2023-09-23 00:00:01",[12,13],"對於一個網站或者服務來講，資料庫是不可或缺的一個元素，那麼什麼是資料庫呢？接下來我們就來聊聊什麼是資料庫。",{"url":63,"title":64,"date":65,"updated":65,"category":10,"tags":66,"description":67,"readingMinutes":15},"\u002Fnodejs\u002F20230922\u002F299784561\u002F","Day8 - 再續 Express.js","2023-09-22 00:00:01",[12,13],"前面我們介紹了 Express 以及 Middleware 的概念，這一篇我們將會繼續介紹 Express.js。",{"url":69,"title":70,"date":71,"updated":71,"category":72,"tags":73,"description":77,"readingMinutes":78},"\u002Fvscode\u002F20230921\u002F1985180173\u002F","Visual Studio Code 自訂折疊區塊","2023-09-21 09:43:55","VSCode",[72,74,75,76],"實用設定","Setting","開發","VSCode 預設可以折疊函式但不能自訂區塊？其實只要用 #region 跟 #endregion 包住程式碼就能自訂折疊範圍，這一篇示範這個少人知道但相當實用的小技巧。","2",1050,105,{"postCount":79,"tagCount":82},1053,1790265672775]