[{"data":1,"prerenderedAt":84},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F101\u002F":3,"post-page:zh-Hant:101":4,"author-stats:zh-Hant:full":82},null,{"posts":5,"total":80,"totalPages":81},[6,17,24,30,37,45,53,59,66,73],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":15,"readingMinutes":16},"\u002Fvue\u002F20190513\u002F948497494\u002F","Vuejs部屬GitHub Pages","2019-05-13 19:34:56","Vue",[12,10,13,14],"JavaScript","Git","GitHub","開發 Vue.js 結束後接下來就是部屬上 GitHub，這邊紀錄一下指令該如何部屬到 GitHub Pages 吧~","3",{"url":18,"title":19,"date":20,"updated":3,"category":12,"tags":21,"description":22,"readingMinutes":23},"\u002Fjavascript\u002F20190511\u002F638155277\u002F","JavaScript基礎閉包觀念","2019-05-11 18:51:54",[12],"JavaScript 中有一個閉包的觀念，滿時常聽人家在講閉包閉包，稍微查了一下相關文章這邊也做一下筆記。","2",{"url":25,"title":26,"date":27,"updated":3,"category":10,"tags":28,"description":29,"readingMinutes":23},"\u002Fvue\u002F20190510\u002F1766915506\u002F","props與emit的傳遞方式","2019-05-10 19:04:33",[12,10],"這幾天自己突然又開始使用 Vue 來製作一個小東西，因為我都是用 components 來製作，所以勢必要了解 props 與 emit 之間是如何傳遞的。",{"url":31,"title":32,"date":33,"updated":34,"category":10,"tags":35,"description":36,"readingMinutes":23},"\u002Fvue\u002F20190510\u002F86469050\u002F","Vue 的 @（小老鼠）符號是什麼？src 路徑別名與 .. 的差異","2019-05-10 10:30:35","2026-06-11 09:00:00",[12,10],"在 Vue 專案的 import 路徑常看到 @ 這個小老鼠符號，它其實是 Vue CLI 幫你設定好的 src 路徑別名（alias）。這篇講清楚 @ 跟相對路徑 .. 的差異，以及 Vue CLI 2 與 3 的設定位置在哪。",{"url":38,"title":39,"date":40,"updated":40,"category":41,"tags":42,"description":44,"readingMinutes":23},"\u002Flearnexp\u002F20190509\u002F3880255625\u002F","適當的休息也是學習的一種方式","2019-05-09 22:18:55","學習經驗",[43,41],"其他","這陣子準備一個小作品同時也不停地幫忙一些私下找我聊聊的朋友們，發現有很多朋友都有一種不太好的習慣，這邊分享一下經驗:D",{"url":46,"title":47,"date":48,"updated":3,"category":49,"tags":50,"description":51,"readingMinutes":52},"\u002Fcss\u002F20190509\u002F1681665762\u002F","用CSS來判別跑版","2019-05-09 10:23:41","CSS",[49],"有時候我們在做 CSS 切版的時候常常會發生跑版的狀況，但是一般瀏覽器並沒有辦法提供給我們格線系統，所以這邊紀錄一下使用 CSS 來開啟格線。","1",{"url":54,"title":55,"date":56,"updated":3,"category":10,"tags":57,"description":58,"readingMinutes":52},"\u002Fvue\u002F20190508\u002F40080850\u002F","vuejs(cli)中使用wowjs","2019-05-08 22:10:45",[12,10],"最近正在製作一個小作品，因為是使用 Vue Cli 開發，這邊紀錄一下該如何在 Vue Cli 中使用 WOWJS",{"url":60,"title":61,"date":62,"updated":3,"category":12,"tags":63,"description":64,"readingMinutes":65},"\u002Fjavascript\u002F20190507\u002F3500556123\u002F","JavaScript全域變數與區域變數的差別","2019-05-07 15:33:37",[12],"JavaScript 中真的滿多坑可以撲倒新手的，一個不小心就踩到地雷，所以這一篇來講講全域變數及區域變數的差異吧~","4",{"url":67,"title":68,"date":69,"updated":3,"category":70,"tags":71,"description":72,"readingMinutes":52},"\u002Fhexo\u002F20190506\u002F2831397096\u002F","Hexo使用特殊符號sitemap會出現錯誤","2019-05-06 20:42:07","Hexo",[70],"最近在調整 Hexo 的 SEO 時發現 sitemap 竟然出現錯誤?!",{"url":74,"title":75,"date":76,"updated":3,"category":77,"tags":78,"description":79,"readingMinutes":23},"\u002Fanalytics\u002F20190506\u002F1879363764\u002F","如何使用GA來替自己網站作分析","2019-05-06 15:42:13","Analytics",[77,70],"這一篇主要是被朋友推坑下來做撰寫得，所以這邊會介紹該如何埋入 Analytics，就是俗稱得 GA 分析，只要你有自己的網站、部落格，我推薦要使用 GA 分析，這可以讓自己了解到自己那些文章是屬於熱門文章。",1037,104,{"postCount":80,"tagCount":83},1013,1785121396720]