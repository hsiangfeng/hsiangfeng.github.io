[{"data":1,"prerenderedAt":86},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F105\u002F":3,"post-page:zh-Hant:105":4,"author-stats:zh-Hant:full":84},null,{"posts":5,"total":82,"totalPages":83},[6,15,23,30,39,45,54,61,69,76],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002FSCSS\u002F20190418\u002F2434021097\u002F","SCSS學習-運算子(三)","2019-04-18 17:24:30","SCSS",[10,12],"SCSS 學習手冊","預算子?加減乘除嗎? CSS 中也有提供運算子的功能，所謂的運算子就是 加(+)、 減(-)、 乘(*)、 除(\u002F)。","1",{"url":16,"title":17,"date":18,"updated":3,"category":19,"tags":20,"description":21,"readingMinutes":22},"\u002Fjavascript\u002F20190418\u002F3212024334\u002F","JavaScript陣列物件屬性合併","2019-04-18 16:00:00","JavaScript",[19],"昨天有一位大大丟了一個 JavaScript 問題和我一起討論，他提供了一個陣列物件給我研究看看，沒想到看似這麼簡單的東西做起來這麼麻煩，還因此耗了我大概 3~4 小時左右的時間，功力果然不夠阿~~~~~","3",{"url":24,"title":25,"date":26,"updated":3,"category":10,"tags":27,"description":28,"readingMinutes":29},"\u002FSCSS\u002F20190417\u002F2961076508\u002F","SCSS學習-變數($)(二)","2019-04-17 12:45:50",[10,12],"從這篇開始就不會講到 SASS，讓我們來專心地了解一下如何基礎學會 SCSS。","2",{"url":31,"title":32,"date":33,"updated":33,"category":34,"tags":35,"description":37,"readingMinutes":38},"\u002Flearnexp\u002F20190416\u002F3782185665\u002F","該如何正確的學習前端技術或程式語言","2019-04-16 22:36:38","學習經驗",[36,34],"其他","先講講為什麼我會寫這一篇文章，自從加入六角學院轉行走前端工程師，陸陸續續都有朋友、網友及同學等都來請教該如何像我一樣學習前端技術，我思考了好一陣子才決定寫這一篇文章作為經驗分享。","5",{"url":40,"title":41,"date":42,"updated":3,"category":10,"tags":43,"description":44,"readingMinutes":29},"\u002FSCSS\u002F20190416\u002F4026443340\u002F","SCSS學習-前言(一)","2019-04-16 20:03:12",[10,12],"首先感謝六角學院- 廖洧杰校長所撰寫的 \"30天掌握 SASS 語法\" 這篇文章讓學習 SCSS 的我一直回頭學習，實在可以堪稱葵花寶典阿!!",{"url":46,"title":47,"date":48,"updated":3,"category":49,"tags":50,"description":53,"readingMinutes":14},"\u002Fnodejs\u002F20190415\u002F3558033712\u002F","Failed at the grpc@1.10.1 install script.","2019-04-15 20:34:42","Nodejs",[51,52],"Node.js","障礙排除","最近在撰寫 nodejs + firebase 時出現了一些問題滿奇怪的問題，這邊紀錄一下...",{"url":55,"title":56,"date":57,"updated":3,"category":58,"tags":59,"description":60,"readingMinutes":38},"\u002Fhtml\u002F20190415\u002F3620209158\u002F","HTML常用標籤認識","2019-04-15 15:59:26","HTML",[58],"HTML 標籤其實非常多，所以特別寫一篇記錄一下常用的標籤有哪些，順便做一下解釋紀錄...",{"url":62,"title":63,"date":64,"updated":3,"category":65,"tags":66,"description":67,"readingMinutes":68},"\u002Fcss\u002F20190413\u002F2684450192\u002F","中國第五屆CSS開發者大會@張鑫旭","2019-04-13 23:10:52","CSS",[65],"今年2019年3月20日，中國在深圳舉辦了由 W3C、 W3ctech的 CSS 開發者大會，目前在 Youtube 也有影片可以觀看，在這邊作為一個紀錄練習，本文參考張鑫旭來製作撰寫。","8",{"url":70,"title":71,"date":72,"updated":3,"category":73,"tags":74,"description":75,"readingMinutes":14},"\u002Fhexo\u002F20190413\u002F2508191011\u002F","Hexo側邊欄修改","2019-04-13 13:32:30","Hexo",[73],"Hexo 的側邊欄的修改大多都是在 _config.yml，這邊以 NexT 為例紀錄一下該如何增加頭像，如果要讓分類功能、標籤功能有效果則必須參考另一篇文章>Hexo新增標籤及分類頁面",{"url":77,"title":78,"date":79,"updated":3,"category":73,"tags":80,"description":81,"readingMinutes":14},"\u002Fhexo\u002F20190413\u002F1568146247\u002F","Hexo新增標籤及分類頁面","2019-04-13 13:06:39",[73],"由於標籤頁面及分類頁面必須由人工生成，所以這邊紀錄一下如何生成。",1052,106,{"postCount":82,"tagCount":85},1059,1790438712328]