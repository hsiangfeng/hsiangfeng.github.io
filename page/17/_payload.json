[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F17\u002F":3,"post-page:zh-Hant:17":4,"author-stats:zh-Hant:full":89},null,{"posts":5,"total":87,"totalPages":88},[6,20,30,41,50,57,63,69,75,81],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":18,"readingMinutes":19},"\u002Fnodejs\u002F20231024\u002F1839693229\u002F","Mac 開啟專案時，自動使用 nvm use 切換到專案的 Node 版本","2023-10-24 16:00:52","Nodejs",[12,13,14,15,16,17],"Node.js","nvm","zsh","oh-my-zsh","zsh-nvm","Powerlevel10k","身為一名 Node.js 相關的開發者，常常會遇到需要切換 Node.js 版本的情況，但是我們每個專案所使用的 Node.js 都不同，因此就很容易忘記切換版本，所以這一篇就要來記錄一下如何在 Mac 上開啟專案時，就自動使用 nvm 切換 Node 版本。","4",{"url":21,"title":22,"date":23,"updated":23,"category":24,"tags":25,"description":28,"readingMinutes":29},"\u002Fnuxt\u002F20231023\u002F2419347402\u002F","Nuxt3 綁定表單後無限觸發 API","2023-10-23 17:04:45","Nuxt",[26,24,27],"Nuxt3","障礙排除","最近在開發 Nuxt3 的時候踩到一個 useFetch 的雷，剛好這個雷好像滿多朋友都有踩到，所以就順便記錄一下。","3",{"url":31,"title":32,"date":33,"updated":33,"category":34,"tags":35,"description":39,"readingMinutes":40},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31","雜談",[36,37,38],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。","5",{"url":42,"title":43,"date":44,"updated":44,"category":45,"tags":46,"description":48,"readingMinutes":49},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58","JavaScript",[45,47],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":51,"title":52,"date":53,"updated":53,"category":10,"tags":54,"description":56,"readingMinutes":29},"\u002Fnodejs\u002F20231015\u002F3466588754\u002F","Day31 - 目錄與補充資源","2023-10-15 00:00:01",[12,55],"《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","今天打算做一個總結了，所以這一篇主要就以回顧的方式來做一個總結哩～",{"url":58,"title":59,"date":60,"updated":60,"category":10,"tags":61,"description":56,"readingMinutes":62},"\u002Fnodejs\u002F20231014\u002F27552363\u002F","Day30-旅途告一個段落","2023-10-14 00:00:01",[12,55],"2",{"url":64,"title":65,"date":66,"updated":66,"category":10,"tags":67,"description":68,"readingMinutes":40},"\u002Fnodejs\u002F20231013\u002F3280561145\u002F","Day29-關於 JWT 驗證","2023-10-13 00:00:01",[12,55],"接下來這一篇將會來介紹 JWT 的驗證，畢竟前面一直都沒提到，可是實戰上來講卻是非常重要的一環哩。",{"url":70,"title":71,"date":72,"updated":72,"category":10,"tags":73,"description":74,"readingMinutes":29},"\u002Fnodejs\u002F20231012\u002F3543796485\u002F","Day28-Google Extension 與 Google Apps Script 蹦再一起","2023-10-12 00:00:01",[12,55],"為了讓我們熟悉 Google Apps Script 的環境，那麼最快的方式就是實作，因此這邊就來整合 Google Extension 吧～",{"url":76,"title":77,"date":78,"updated":78,"category":10,"tags":79,"description":80,"readingMinutes":29},"\u002Fnodejs\u002F20231011\u002F1771923912\u002F","Day27-遇見 Google Apps Script","2023-10-11 00:00:01",[12,55],"OMG，這又是什麼新玩意了，接下來這一篇我們會稍微輕鬆一點來認識 Google Apps Script 是什麼東西，而且實戰上來講，也是非常的方便，因此我們就來看看 Google Apps Script 是什麼東西吧！",{"url":82,"title":83,"date":84,"updated":84,"category":10,"tags":85,"description":86,"readingMinutes":40},"\u002Fnodejs\u002F20231010\u002F3798507505\u002F","Day26-Google Extension 與 Vite","2023-10-10 00:00:01",[12,55],"前一篇我們對於 Google Extension 有了初步的認識，但我們實際開發上來講，必定會使用到人家開發好的套件，所以這一篇就會來使用 Vite 來開發 Google Extension。",1049,105,{"postCount":87,"tagCount":90},1050,1790254980259]