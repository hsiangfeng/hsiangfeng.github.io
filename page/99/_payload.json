[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F99\u002F":3,"post-page:zh-Hant:99":4,"author-stats:zh-Hant:full":75},null,{"posts":5,"total":73,"totalPages":74},[6,16,23,29,37,43,49,55,61,67],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190517\u002F3961604918\u002F","[JS奇怪的世界]No.21 框架小叮嚀:預設值","2019-05-17 13:22:00","克服JS奇怪的部分系列",[12,13],"JavaScript","JavaScript 全攻略:克服JS奇怪的部分","接下來將針對框架做一個小觀念叮嚀，這邊課程講解的是 jQuery，為什麼會拿 jQuery 來講解呢呢?以前最熱門的框架非 jQuery 莫屬，舉凡動畫效果等等都是由 jQuery 一手包辦，並不用說瀏覽器適應問題，所以這章節拿 jQuery 來作範例再適合不過了。","2",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190517\u002F600418516\u002F","[JS奇怪的世界]No.20 預設值","2019-05-17 12:22:00",[12,13],"上一章節講解了強制轉型的一些特性，所以這堂課將會試著從另一個角度去利用它的特性，首先課程提供了範例程式碼 ↓","1",{"url":24,"title":25,"date":26,"updated":3,"category":10,"tags":27,"description":28,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190517\u002F3849161770\u002F","[JS奇怪的世界]No.19 存在與布林值","2019-05-17 11:16:35",[12,13],"一般來講我們可以手動使用 Boolean、Number 等函數來做強制轉型的動作，但是課程也是強調不要這樣做(手動轉型)，但是用來展示效果是可以的，舉例我們將 undefined 轉換成布林值 ↓",{"url":30,"title":31,"date":32,"updated":3,"category":33,"tags":34,"description":36,"readingMinutes":22},"\u002Fhexo\u002F20190517\u002F2562079032\u002F","Hexo Url優化(SEO)","2019-05-17 10:05:19","Hexo",[33,35],"SEO","由於 Hexo 本身 Url 的 SEO 狀況並不是設計非常漂亮，因為在 SEO 規範中文連結遠比英文連結差，所以這邊紀錄一下該如何使用。",{"url":38,"title":39,"date":40,"updated":3,"category":10,"tags":41,"description":42,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190516\u002F803766782\u002F","[JS奇怪的世界]No.18 比較運算子","2019-05-16 21:16:35",[12,13],"將下來講講 小於運算子，讓我們試著用程式碼來講解。",{"url":44,"title":45,"date":46,"updated":3,"category":10,"tags":47,"description":48,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190516\u002F3588659278\u002F","[JS奇怪的世界]No.17 觀念小叮嚀:強制轉型","2019-05-16 21:01:35",[12,13],"強制轉型的意思是什麼?就是將原本的型別轉換成另一種，例如 String 變成 Boolean。",{"url":50,"title":51,"date":52,"updated":3,"category":10,"tags":53,"description":54,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190516\u002F3658238475\u002F","[JS奇怪的世界]No.16 運算子的優先性與相依性","2019-05-16 20:34:35",[12,13],"這兩個在 JavaScript 是一個非常重要的名詞，其實非常重要的觀念，如果能瞭解其觀念，對於 debug 上是有一定幫助的。",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":60,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190516\u002F2821553635\u002F","[JS奇怪的世界]No.15 觀念小叮嚀:運算子","2019-05-16 20:00:35",[12,13],"運算子可以說是 JavaScript 中提供的特殊方法也可以稱之為函數，並且可以協助我們做一些計算，那怎麼寫呢?",{"url":62,"title":63,"date":64,"updated":3,"category":10,"tags":65,"description":66,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190516\u002F890725015\u002F","[JS奇怪的世界]No.14 純值","2019-05-16 19:30:35",[12,13],"前面已經針對 JavaScript 的型別做的一個簡易的介紹，而這章節課程將針對 JavaScript 動態型別瞭解以及其優缺點深入瞭解。",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":22},"\u002Fjsweirdworld\u002F20190516\u002F3276239225\u002F","[JS奇怪的世界]No.13 觀念小叮嚀-型別與JavaScript","2019-05-16 19:00:35",[12,13],"這一個章節是新的章節「型別與運算子」。",1043,105,{"postCount":73,"tagCount":76},1032,1789660900693]