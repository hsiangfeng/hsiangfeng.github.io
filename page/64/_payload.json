[{"data":1,"prerenderedAt":91},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F64\u002F":3,"post-page:zh-Hant:64":4,"author-stats:zh-Hant:full":89},null,{"posts":5,"total":87,"totalPages":88},[6,18,27,35,43,49,60,68,74,80],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fjavascript\u002F20200518\u002F1745009932\u002F","PixiJS V5 教學 (15) - Bump","2020-05-18 08:20:50","JavaScript",[12,13,10,14,15],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前一篇我們學習如何使用 PIXI 建立幾何圖形，那麼接下來要學習 PIXI 中一個我認為滿特別的東西，也就是碰撞檢測。","2",{"url":19,"title":20,"date":21,"updated":3,"category":22,"tags":23,"description":26,"readingMinutes":17},"\u002Fcss\u002F20200517\u002F4250484451\u002F","淺談 CSS 設計模式系列-BEM 篇","2020-05-17 15:33:48","CSS",[24,25,22],"CSS 設計模式","BEM","BEM 是一個為了讓 class 有更好地維護架構 CSS 設計模式，但最主要的致命缺點就是命名長度過長，可是在實際開發上非常多人都會使用到 BEM。",{"url":28,"title":29,"date":30,"updated":3,"category":22,"tags":31,"description":33,"readingMinutes":34},"\u002Fcss\u002F20200517\u002F168089779\u002F","淺談 CSS 設計模式系列-OOCSS 篇","2020-05-17 12:53:41",[24,32,22],"OOCSS","OOCSS 是 CSS 設計模式的另一種，其中最主要代表的框架就是 Bootstrap。","3",{"url":36,"title":37,"date":38,"updated":3,"category":22,"tags":39,"description":41,"readingMinutes":42},"\u002Fcss\u002F20200516\u002F2341336904\u002F","淺談 CSS 設計模式-SMACSS 篇","2020-05-16 19:59:52",[24,40,22],"SMACSS","CSS 設計模式是一個觀念、規範以及心法，最主要就是要替我們提高開發與維護的效率。","5",{"url":44,"title":45,"date":46,"updated":3,"category":10,"tags":47,"description":48,"readingMinutes":17},"\u002Fjavascript\u002F20200511\u002F1897499725\u002F","PixiJS V5 教學 (14) - Graphics(2)","2020-05-11 07:30:15",[12,13,10,14,15],"前一篇介紹了基本的幾何圖形的繪畫，但是只介紹矩形，其實 PIXI 還有其他幾何圖形的繪畫，所以接下來就來講其他的幾何圖形囉",{"url":50,"title":51,"date":52,"updated":3,"category":53,"tags":54,"description":58,"readingMinutes":59},"\u002Fother\u002F20200510\u002F1067127387\u002F","解決 Windows 上輸入指令出現「因為這個系統上已停用指令碼執行，所以無法載入...」的問題","2020-05-10 22:52:10","雜談",[55,56,57],"Windows","障礙排除","Terminal","Windows PowerShell 跳「因為這個系統上已停用指令碼執行...」？這一篇講 Set-ExecutionPolicy 預設 Restricted 的原因， 整理 AllSigned、Bypass、Unrestricted 各選項差別與最安全的調整指令。","4",{"url":61,"title":62,"date":63,"updated":3,"category":10,"tags":64,"description":67,"readingMinutes":17},"\u002Fjavascript\u002F20200510\u002F2581786882\u002F","JavaScript 核心觀念(7)-執行環境與作用域-not defined VS undefined","2020-05-10 21:27:11",[10,65,66],"JavaScript 核心篇","執行環境與作用域","not defined 以及 undefined 也是 JavaScript 中相當重要的觀念，若可以搞懂這兩者的差異，對於 debug 上是非常有幫助的。",{"url":69,"title":70,"date":71,"updated":3,"category":10,"tags":72,"description":73,"readingMinutes":17},"\u002Fjavascript\u002F20200504\u002F1045961354\u002F","PixiJS V5 教學 (13) - Graphics(1)","2020-05-04 08:10:50",[12,13,10,14,15],"接下來將會來介紹一點使用 PIXI 繪畫幾何圖形，最後會再來試著整合前面的技巧。",{"url":75,"title":76,"date":77,"updated":3,"category":10,"tags":78,"description":79,"readingMinutes":34},"\u002Fjavascript\u002F20200503\u002F1924910570\u002F","JavaScript 核心觀念(6)-執行環境與作用域-提升","2020-05-03 14:45:13",[10,65,66],"提升(Hoisting) 可以說是我最喜好的一個觀念，JavaScript 中舉凡函式、變數都有這個觀念存在。",{"url":81,"title":82,"date":83,"updated":3,"category":10,"tags":84,"description":85,"readingMinutes":86},"\u002Fjavascript\u002F20200502\u002F1231063032\u002F","JavaScript 核心觀念(5)-執行環境與作用域-範圍鍊","2020-05-02 21:36:56",[10,65,66],"接下來講講為什麼明明宣告在外層的變數甚至是不同地方的函式，卻可以正確的呼叫與執行。","1",1041,105,{"postCount":87,"tagCount":90},1026,1789489006126]