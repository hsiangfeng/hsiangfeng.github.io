[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"header-locale:\u002Fpage\u002F64\u002F":3,"post-page:zh-Hant:64":4,"author-stats:zh-Hant:full":92},null,{"posts":5,"total":90,"totalPages":91},[6,16,25,34,44,51,59,67,73,84],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjavascript\u002F20200524\u002F995184384\u002F","JavaScript 核心觀念(8)-執行環境與作用域-記憶體存放與釋放","2020-05-24 10:56:06","JavaScript",[10,12,13],"JavaScript 核心篇","執行環境與作用域","接下來講一下記憶體的回收機制。","2",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":24,"readingMinutes":15},"\u002Fcss\u002F20200523\u002F116058774\u002F","淺談 CSS 設計模式系列-Sass 7-1 Pattern 篇","2020-05-23 21:00:52","CSS",[22,23,20],"CSS 設計模式","7+1 設計模式","7+1 的設計模式主要是在講目錄結構的區分，早期開發 CSS 時只能將所有檔案放在同一個地方，那麼這樣就會導致維護上的困擾，因此在開發 Sass 時就可以搭配 @import 然後使用資料夾區分相關檔案，也就是所謂的 Sass 7-1 Pattern。",{"url":26,"title":27,"date":28,"updated":3,"category":29,"tags":30,"description":33,"readingMinutes":15},"\u002Fvue\u002F20200522\u002F1986801509\u002F","如何替 Vue Cli 加入 ESLint","2020-05-22 23:48:14","Vue",[10,29,31,32],"Vue Cli","ESLint","實際開發專案時我們為了確保程式碼的品質，通常都會加入程式碼風格管理器，也就是 ESLint，但在 Vue Cli 中該如何正確加入呢？",{"url":35,"title":36,"date":37,"updated":3,"category":10,"tags":38,"description":43,"readingMinutes":15},"\u002Fjavascript\u002F20200518\u002F1745009932\u002F","PixiJS V5 教學 (15) - Bump","2020-05-18 08:20:50",[39,40,10,41,42],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前一篇我們學習如何使用 PIXI 建立幾何圖形，那麼接下來要學習 PIXI 中一個我認為滿特別的東西，也就是碰撞檢測。",{"url":45,"title":46,"date":47,"updated":3,"category":20,"tags":48,"description":50,"readingMinutes":15},"\u002Fcss\u002F20200517\u002F4250484451\u002F","淺談 CSS 設計模式系列-BEM 篇","2020-05-17 15:33:48",[22,49,20],"BEM","BEM 是一個為了讓 class 有更好地維護架構 CSS 設計模式，但最主要的致命缺點就是命名長度過長，可是在實際開發上非常多人都會使用到 BEM。",{"url":52,"title":53,"date":54,"updated":3,"category":20,"tags":55,"description":57,"readingMinutes":58},"\u002Fcss\u002F20200517\u002F168089779\u002F","淺談 CSS 設計模式系列-OOCSS 篇","2020-05-17 12:53:41",[22,56,20],"OOCSS","OOCSS 是 CSS 設計模式的另一種，其中最主要代表的框架就是 Bootstrap。","3",{"url":60,"title":61,"date":62,"updated":3,"category":20,"tags":63,"description":65,"readingMinutes":66},"\u002Fcss\u002F20200516\u002F2341336904\u002F","淺談 CSS 設計模式-SMACSS 篇","2020-05-16 19:59:52",[22,64,20],"SMACSS","CSS 設計模式是一個觀念、規範以及心法，最主要就是要替我們提高開發與維護的效率。","5",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":15},"\u002Fjavascript\u002F20200511\u002F1897499725\u002F","PixiJS V5 教學 (14) - Graphics(2)","2020-05-11 07:30:15",[39,40,10,41,42],"前一篇介紹了基本的幾何圖形的繪畫，但是只介紹矩形，其實 PIXI 還有其他幾何圖形的繪畫，所以接下來就來講其他的幾何圖形囉",{"url":74,"title":75,"date":76,"updated":3,"category":77,"tags":78,"description":82,"readingMinutes":83},"\u002Fother\u002F20200510\u002F1067127387\u002F","解決 Windows 上輸入指令出現「因為這個系統上已停用指令碼執行，所以無法載入...」的問題","2020-05-10 22:52:10","雜談",[79,80,81],"Windows","障礙排除","Terminal","Windows PowerShell 跳「因為這個系統上已停用指令碼執行...」？這一篇講 Set-ExecutionPolicy 預設 Restricted 的原因， 整理 AllSigned、Bypass、Unrestricted 各選項差別與最安全的調整指令。","4",{"url":85,"title":86,"date":87,"updated":3,"category":10,"tags":88,"description":89,"readingMinutes":15},"\u002Fjavascript\u002F20200510\u002F2581786882\u002F","JavaScript 核心觀念(7)-執行環境與作用域-not defined VS undefined","2020-05-10 21:27:11",[10,12,13],"not defined 以及 undefined 也是 JavaScript 中相當重要的觀念，若可以搞懂這兩者的差異，對於 debug 上是非常有幫助的。",1044,105,{"postCount":90,"tagCount":93},1034,1789747494966]