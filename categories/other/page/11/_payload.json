[{"data":1,"prerenderedAt":100},["ShallowReactive",2],{"header-locale:\u002Fcategories\u002Fother\u002Fpage\u002F11\u002F":3,"category-page:zh-Hant:other:11":4,"author-stats:zh-Hant:full":97},null,{"category":5,"posts":6,"total":95,"totalPages":96},"雜談",[7,19,29,41,48,59,69,75,81,89],{"url":8,"title":9,"date":10,"updated":11,"category":5,"tags":12,"description":17,"readingMinutes":18},"\u002Fother\u002F20200123\u002F1105303313\u002F","Mac OS 終端機美化看這一篇就夠了！(Mac OS Terminal)","2020-01-23 00:01:10","2023-10-01 12:07:00",[13,14,15,16],"軟體操作","Terminal","終端機","macOS","Mac 預設終端機太陽春想美化？這一篇完整紀錄我的設定流程：Homebrew、iTerm2、Zsh、Oh My Zsh、agnoster \u002F Powerlevel10k 主題到 zsh-autosuggestions 等實用外掛全部一次裝起來。","8",{"url":20,"title":21,"date":22,"updated":3,"category":5,"tags":23,"description":27,"readingMinutes":28},"\u002Fother\u002F20200122\u002F3909813080\u002F","Windows 10 轉到 Mac OS X 的一些細節","2020-01-22 09:22:13",[24,25,26],"Mac","Windows 10","作業系統","最近開發環境轉到 Mac OS X 上，所以這一篇就稍微紀錄一下 Mac 與 Windows 轉移之痛 Q_Q","2",{"url":30,"title":31,"date":32,"updated":3,"category":5,"tags":33,"description":40,"readingMinutes":28},"\u002Fother\u002F20200115\u002F1138566633\u002F","API 網站列表","2020-01-15 09:57:27",[34,35,36,37,38,39],"AJAX","CORS","GitHub","Slack","Imgur","OAuth","這是一份特別整理 API 網站列表，身為一名前端工程師，時常會為了製作一些小作品尋找 API 老半天，所以就稍微整理了一下有哪些 API 網站，也避免我自己的書籤列表一直爆滿，當然底下的 API 網站我並沒有每個都練習過以及使用過，所以僅僅只是列出來僅供參考而已。",{"url":42,"title":43,"date":44,"updated":3,"category":5,"tags":45,"description":46,"readingMinutes":47},"\u002Fother\u002F20191220\u002F4162492528\u002F","一分鐘把 Slack Auto Format Massage 解決掉!","2019-12-20 11:30:34",[37,13],"最近 Slack 更新版本後新增了一個功能，也就是 Slack Auto Format Massage，這是什麼意思呢?","1",{"url":49,"title":50,"date":51,"updated":52,"category":5,"tags":53,"description":57,"readingMinutes":58},"\u002Fother\u002F20191111\u002F1875438261\u002F","Markdown 入門教學：常見語法與範例完整整理","2019-11-11 09:48:27","2026-03-18 13:20:00",[54,55,56],"Markdown","Markdown 教學","Markdown 語法","一篇涵蓋所有常見 Markdown 語法的入門教學，從標題、粗體、清單到表格與程式碼區塊，每個語法皆附範例與對應的 HTML 標籤說明，幫助你快速上手 Markdown 寫作。","4",{"url":60,"title":61,"date":62,"updated":3,"category":5,"tags":63,"description":67,"readingMinutes":68},"\u002Fother\u002F20191028\u002F864994619\u002F","軟體工程師必學的文字對話藝術","2019-10-28 21:28:54",[64,65,66],"其他","軟體工程師","文字對話藝術","文字交流上其實有許多非常需要注意的事情，看似單純幾個中文字，但真正傳遞的感受是不同的，尤其是身為軟體工程師這個行業更不用說最常使用文字與他人溝通，所以這一篇將會來集中討論關於文字對話上的藝術。","5",{"url":70,"title":71,"date":72,"updated":3,"category":5,"tags":73,"description":74,"readingMinutes":28},"\u002Fother\u002F20190924\u002F3446878284\u002F","Window PowerShell美化(Windows Terminal)","2019-09-24 13:53:52",[13,14],"身為一名工程師來講，最常接觸的就是 Cmd 介面，也就是所謂的終端機，那麼長久看同一個畫面也是會膩的，所以這一篇記錄一下該如何美化自己的 Terminal 吧。",{"url":76,"title":77,"date":78,"updated":3,"category":5,"tags":79,"description":80,"readingMinutes":58},"\u002Fother\u002F20190828\u002F2944044939\u002F","Slack 基礎操作","2019-08-28 08:52:12",[37,13],"這一篇來記錄一下 Slack 的基礎操作與介紹，最主要 Slack 是滿多公司很常使用的溝通工具。",{"url":82,"title":83,"date":84,"updated":3,"category":5,"tags":85,"description":88,"readingMinutes":47},"\u002Fother\u002F20190614\u002F1907905725\u002F","前端開發的 User Story","2019-06-14 21:07:23",[86,87],"User story","User stories","先前稍微瞭解過 User Story，但是這幾天實際 run 一次的時候卻發現一件很重要的事情，以往我在後端開發的時候都是以功能來考量...",{"url":90,"title":91,"date":92,"updated":3,"category":5,"tags":93,"description":94,"readingMinutes":28},"\u002Fother\u002F20190523\u002F1695536352\u002F","User Story 是什麼?","2019-05-23 13:00:04",[86,87],"今天面試的時候面試官講到一個東西，但發現自己並不是很熟悉，所以這邊查一下資料試著理解成自己的東西並做一下筆記，方便自己回顧。",110,11,{"postCount":98,"tagCount":99},1069,1106,1792338367557]