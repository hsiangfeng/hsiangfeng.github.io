.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2014.56.20.png",[17,1815,1816],{},"登入成功後，你會直接進入到 Zeabur 的控制台，接下來你可以點擊畫面上的「建立專案」按鈕來建立專案",[17,1818,1819],{},[31,1820],{"alt":1821,"src":1822},"建立專案","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2015.00.25.png",[17,1824,1825],{},"接下來你會需要選擇專案的地區，這邊我們就選「Taiwan」（題外話：Zeabur 主機位於 GCP 台灣機房）",[17,1827,1828],{},[31,1829],{"alt":1830,"src":1831},"Taiwan","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2015.01.11.png",[17,1833,1834],{},"接著你就可以看到剛剛建立的專案",[17,1836,1837],{},[31,1838],{"alt":1839,"src":1840},"New Project","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002Fnew%20Project.png",[17,1842,1843],{},"點一下它就可以看到這個專案的資訊，先讓我用一張圖介紹說明一下：",[17,1845,1846],{},[31,1847],{"alt":1848,"src":1849},"專案介紹","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002FZeabur_service_dash.jpg",[17,1851,1852],{},"專案設定方面我就不特別介紹了，讓你自行點進去摸索就好。",[17,1854,1855],{},"那麼我們就先來部署自己的服務（專案），點一下建立服務，你會看到 Git、Marketplace 這兩個選項，這邊我們選 Git，因為我們要部署 GitHub 上的專案",[17,1857,1858],{},[31,1859],{"alt":1860,"src":1861},"Git Deploy","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002Fzeabur_deploy_git.png",[17,1863,1864],{},"接著選擇你要部署的專案就可以了",[17,1866,1867],{},[31,1868],{"alt":68,"src":1869},"https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002Fzeabur_deploy_git2.jpg",[17,1871,1872],{},"整個部署過程大概需要 1~2 分鐘",[17,1874,1875],{},[31,1876],{"alt":86,"src":1877},"https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2016.15.07.png",[17,1879,1880],{},"你可以點擊「Log」來查看部署的過程",[17,1882,1883],{},[31,1884],{"alt":1885,"src":1886},"Log","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2016.31.52.png",[17,1888,1889],{},[31,1890],{"alt":1885,"src":1891},"https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002FZeabur_log.jpg",[17,1893,1894],{},"不意外，你應該會發現 Log 出現錯誤",[17,1896,1897],{},[31,1898],{"alt":1899,"src":1900},"Error","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2016.39.27.png",[17,1902,1903],{},"因為我們並沒有填寫 Env 的關係，回到專案主控台下方有一個環境變數，點一下編輯環境變數，你就可以無痛把 .env 的內容直接貼上囉！",[17,1905,1906],{},[31,1907],{"alt":1908,"src":1909},"Env","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002FZeabur_env.jpg",[17,1911,1912],{},"儲存後，按一下專案的 ReDeploy 就可以恢復正常哩~",[17,1914,1915],{},[31,1916],{"alt":1917,"src":1886},"ReDeploy",[17,1919,1920,1921,1924],{},"接著你回到 Discord 上面，應該就會看到你的 Discord Bot 已經上線了，而且你也可以嘗試輸入 ",[101,1922,1923],{},"\u002Fblog"," 來測試看看，應該就會看到你的 Discord Bot 回覆你一篇文章囉！",[1926,1927,1928],"h3",{"id":1928},"關於自動註冊指令",[17,1930,1931,1932,1935],{},"最後也補充一個點一下，也就是關於註冊指令的部分，我們前面有新增一個檔案叫做 ",[101,1933,1934],{},"register.js","，這個檔案的用途就是用來註冊指令的，那麼為了確保指令是最新的，我們可以透過 npm scripts 的指令來註冊指令，這樣就不用每次都要手動註冊指令囉～",[94,1937,1939],{"className":1685,"code":1938,"language":1687,"meta":99,"style":99},"{\n  \"name\": \"example-discord-crawler\",\n  \u002F\u002F ... 略過其他程式碼\n  \"scripts\": {\n    \"postinstall\": \"node register.js\",\n    \"start\": \"node index.js\",\n    \"test\": \"echo \\\"Error: no test specified\\\" && exit 1\",\n    \"register\": \"node register.js\"\n  },\n  \u002F\u002F ... 略過其他程式碼\n}\n",[101,1940,1941,1945,1955,1959,1965,1977,1987,2006,2016,2020,2024],{"__ignoreMap":99},[104,1942,1943],{"class":106,"line":107},[104,1944,1694],{"class":222},[104,1946,1947,1949,1951,1953],{"class":106,"line":118},[104,1948,1700],{"class":1699},[104,1950,1703],{"class":222},[104,1952,1706],{"class":114},[104,1954,345],{"class":222},[104,1956,1957],{"class":106,"line":127},[104,1958,1713],{"class":216},[104,1960,1961,1963],{"class":106,"line":139},[104,1962,1718],{"class":1699},[104,1964,1721],{"class":222},[104,1966,1967,1970,1972,1975],{"class":106,"line":148},[104,1968,1969],{"class":1699},"    \"postinstall\"",[104,1971,1703],{"class":222},[104,1973,1974],{"class":114},"\"node register.js\"",[104,1976,345],{"class":222},[104,1978,1979,1981,1983,1985],{"class":106,"line":156},[104,1980,1726],{"class":1699},[104,1982,1703],{"class":222},[104,1984,1731],{"class":114},[104,1986,345],{"class":222},[104,1988,1989,1991,1993,1995,1997,1999,2001,2004],{"class":106,"line":164},[104,1990,1738],{"class":1699},[104,1992,1703],{"class":222},[104,1994,1743],{"class":114},[104,1996,1747],{"class":1746},[104,1998,1750],{"class":114},[104,2000,1747],{"class":1746},[104,2002,2003],{"class":114}," && exit 1\"",[104,2005,345],{"class":222},[104,2007,2008,2011,2013],{"class":106,"line":172},[104,2009,2010],{"class":1699},"    \"register\"",[104,2012,1703],{"class":222},[104,2014,2015],{"class":114},"\"node register.js\"\n",[104,2017,2018],{"class":106,"line":348},[104,2019,1512],{"class":222},[104,2021,2022],{"class":106,"line":356},[104,2023,1713],{"class":216},[104,2025,2026],{"class":106,"line":364},[104,2027,979],{"class":222},[36,2029,2030],{"id":2030},"其他服務",[17,2032,2033],{},"當然還有很多服務可以使用，例如我先前介紹過的...",[2035,2036,2037,2045],"ul",{},[2038,2039,2040],"li",{},[21,2041,2044],{"href":2042,"rel":2043},"https:\u002F\u002Fisraynotarray.com\u002Fother\u002F20221213\u002F3036227586\u002F",[25],"關於從 Heroku 跳到 Render 這件事情",[2038,2046,2047],{},[21,2048,2051],{"href":2049,"rel":2050},"https:\u002F\u002Fisraynotarray.com\u002Fother\u002F20221216\u002F786812101\u002F",[25],"將你的 Node.js 部署到 fly.io 吧！",[17,2053,2054],{},"之前也有寫過 Zeabur 的文章",[2035,2056,2057],{},[2038,2058,2059],{},[21,2060,2063],{"href":2061,"rel":2062},"https:\u002F\u002Fisraynotarray.com\u002Fother\u002F20230401\u002F3544735243\u002F",[25],"除了 Render 與 Fly 之外，你還可以考慮 Zeabur 服務",[17,2065,2066],{},"這幾個我試用下來，我個人是滿推薦使用 Zeabur 的，雖然只能建立一個專案，但一個專案內是可以部署相當多的服務的，更不用說又有免費的五美金額度可以使用，更不用說官方文件其實非常齊全且相關人員都會第一時間盡可能協助解決問題，所以基本上是非常推薦的。",[17,2068,2069],{},"----- 底下是業配開始線 -----",[17,2071,2072],{},"那麼如果你覺得試用下來相當不錯的話，你可以再付費時填寫我的兌換碼：",[94,2074,2076],{"className":96,"code":2075,"language":98,"meta":99,"style":99},"israynotarray\n",[101,2077,2078],{"__ignoreMap":99},[104,2079,2080],{"class":106,"line":107},[104,2081,2075],{"class":110},[17,2083,2084],{},"你可以免費獲得一個月的開發者方案唷！",[17,2086,2087],{},"而 Zeabur 的計費方式你可以參考他們官方文件：",[17,2089,2090],{},[21,2091,2094],{"href":2092,"rel":2093},"https:\u002F\u002Fzeabur.com\u002Fzh-TW\u002Fpricing",[25],"收費方式",[17,2096,2097],{},"----- 以上業配結束線 -----",[17,2099,2100],{},"那麼這一篇也差不多了，我們下一篇見哩～",[2102,2103,2104],"style",{},"html pre.shiki code .smYoP, html code.shiki .smYoP{--shiki-light:#6F42C1;--shiki-default:#6F42C1;--shiki-dark:#FFB757}html pre.shiki code .sWayO, html code.shiki .sWayO{--shiki-light:#032F62;--shiki-default:#032F62;--shiki-dark:#ADDCFF}html pre.shiki code .stw71, html code.shiki .stw71{--shiki-light:#005CC5;--shiki-default:#005CC5;--shiki-dark:#91CBFF}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weigh