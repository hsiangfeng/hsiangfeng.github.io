[{"data":1,"prerenderedAt":2154},["ShallowReactive",2],{"header-locale:\u002Fnodejs\u002F20231008\u002F2016996949\u002F":3,"page:\u002Fnodejs\u002F20231008\u002F2016996949\u002F":4,"alt:\u002Fnodejs\u002F20231008\u002F2016996949\u002F":3,"prev-next:\u002Fnodejs\u002F20231008\u002F2016996949\u002F":2129,"related:\u002Fnodejs\u002F20231008\u002F2016996949\u002F":2138},"\u002Fen\u002Fnodejs\u002F2023\u002F10\u002F08\u002Fday-24-deploying-to-zeabur\u002F",{"id":5,"title":6,"abbrlink":7,"altUrl":3,"body":8,"category":2113,"date":2114,"description":41,"extension":2115,"lang":2116,"meta":2117,"navigation":285,"path":2118,"readingMinutes":2119,"seo":2120,"standalone":2121,"stem":2122,"tags":2123,"tldr":2126,"updated":2114,"url":2127,"__hash__":2128},"content\u002F《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》\u002FDay24-部署到-Zeabur.md","Day24-部署到 Zeabur","2016996949",{"type":9,"value":10,"toc":2105},"minimark",[11,28,35,39,42,45,48,51,54,70,73,76,81,84,87,90,93,178,202,205,247,250,712,715,1003,1006,1400,1403,1680,1683,1768,1771,1782,1796,1799,1805,1808,1814,1817,1823,1826,1832,1835,1841,1844,1850,1853,1856,1862,1865,1870,1873,1878,1881,1887,1892,1895,1901,1904,1910,1913,1918,1925,1929,1936,2028,2031,2034,2052,2055,2064,2067,2070,2073,2082,2085,2088,2095,2098,2101],[12,13,16],"callout",{"title":14,"type":15},"Note","note",[17,18,19,20,27],"p",{},"Zeabur 已在 2026\u002F10\u002F17 宣布結束營運，所有服務預計在 2026\u002F12\u002F31 前關閉，到時候這篇的部署步驟就沒辦法照著做了，想知道來龍去脈可以看〈",[21,22,26],"a",{"href":23,"rel":24},"https:\u002F\u002Fisraynotarray.com\u002Fother\u002F20261018\u002F3499703665\u002F",[25],"nofollow","Zeabur 結束營運：台灣新創的跌倒與成長","〉。",[17,29,30],{},[31,32],"img",{"alt":33,"src":34},"Zeabur","https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fnodejs\u002Fithelp-nodejs-2023\u002F%E6%88%AA%E5%9C%96%202023-09-08%2014.22.48.png",[36,37,38],"h2",{"id":38},"前言",[17,40,41],{},"前一面我們對於伺服器有基本概念後，接下來當然是要實際部署專案到伺服器上囉～",[36,43,33],{"id":44},"zeabur",[17,46,47],{},"Zeabur 是一個 PaaS 平台，何謂 PaaS 呢？Platform as a service 中文又稱平台即服務。",[17,49,50],{},"有點模糊吧？那我舉個例子來講好了，假設你今天要蓋一個房子好了，那你需要什麼呢？當然是地基、水泥、磚頭、木頭等等，更不用說你還需要去設計房子的樣子，這些都是你需要做的事情。",[17,52,53],{},"而 PaaS 概念就跟請一個專業的建築公司來蓋一樣，因為這間建築公司本身就有提供相對應得服務，例如：設計、施工、材料等等，你只需要跟他們說你要蓋什麼樣的房子，他們就會幫你蓋好，這就是 PaaS 的概念。",[17,55,56,57,61,62,65,66,69],{},"所以以這個概念來講，你代表著",[58,59,60],"strong",{},"開發者","，而建築公司則代表著",[58,63,64],{},"PaaS 平台","，而房子則代表著",[58,67,68],{},"專案","，你只需要專注於專案的開發，而不需要去擔心伺服器的問題，這就是 PaaS 的好處。",[17,71,72],{},"常見的 PaaS 平台非常多，例如...先前轉成收費的 Heroku 就是一個 PaaS 平台，因此我們不用過度的去擔心伺服器的問題，只需要註冊帳號、建立專案、部屬專案就好了，非常的方便呢！",[17,74,75],{},"而 PaaS 平台核心理念在於抽象化你原有在伺服器上複雜管理工作，讓你可以更專注於專案上的開發，因此對於新手、小白等開發者，其實是非常的方便的。",[12,77,78],{"title":14,"type":15},[17,79,80],{},"當然，也有所謂的 Iass（Infrastructure as a Service）與 SaaS（Software as a Service），但這兩個東西就不是我們這邊要講的了，有興趣的話可以自行去查詢看看。",[17,82,83],{},"那麼為什麼我會選擇 Zeabur 呢？因為 Zeabur 是台灣的 PaaS 平台，當然要支持一下本土的平台，而且 Zeabur 也有提供免費的方案（每個月 5 美金），更不用說非常的方便，所以我們就來使用 Zeabur 來部屬我們的專案吧！",[36,85,86],{"id":86},"部署",[17,88,89],{},"接下來我會全程一步一步帶著你將前一篇的專案部屬到 Zeabur 上，當然你也可以自己先試試看，如果有問題的話再回來看看這篇文章。",[17,91,92],{},"首先底下我提供相對應的指令以及預期要部署的程式碼，確保你我之間的程式碼是一致的，這樣才能夠順利的部屬。",[94,95,100],"pre",{"className":96,"code":97,"language":98,"meta":99,"style":99},"language-bash shiki shiki-themes github-light github-light github-dark-high-contrast","mkdir example-discord-bot-crawler\ncd example-discord-bot-crawler\nnpm init -y\ntouch index.js\ntouch register.js\ntouch crawler.js\ntouch postCron.js\ntouch .env\n","bash","",[101,102,103,116,125,137,146,154,162,170],"code",{"__ignoreMap":99},[104,105,108,112],"span",{"class":106,"line":107},"line",1,[104,109,111],{"class":110},"smYoP","mkdir",[104,113,115],{"class":114},"sWayO"," example-discord-bot-crawler\n",[104,117,119,123],{"class":106,"line":118},2,[104,120,122],{"class":121},"stw71","cd",[104,124,115],{"class":114},[104,126,128,131,134],{"class":106,"line":127},3,[104,129,130],{"class":110},"npm",[104,132,133],{"class":114}," init",[104,135,136],{"class":121}," -y\n",[104,138,140,143],{"class":106,"line":139},4,[104,141,142],{"class":110},"touch",[104,144,145],{"class":114}," index.js\n",[104,147,149,151],{"class":106,"line":148},5,[104,150,142],{"class":110},[104,152,153],{"class":114}," register.js\n",[104,155,157,159],{"class":106,"line":156},6,[104,158,142],{"class":110},[104,160,161],{"class":114}," crawler.js\n",[104,163,165,167],{"class":106,"line":164},7,[104,166,142],{"class":110},[104,168,169],{"class":114}," postCron.js\n",[104,171,173,175],{"class":106,"line":172},8,[104,174,142],{"class":110},[104,176,177],{"class":114}," .env\n",[94,179,181],{"className":96,"code":180,"language":98,"meta":99,"style":99},"npm i discord.js cheerio dotenv cron\n",[101,182,183],{"__ignoreMap":99},[104,184,185,187,190,193,196,199],{"class":106,"line":107},[104,186,130],{"class":110},[104,188,189],{"class":114}," i",[104,191,192],{"class":114}," discord.js",[104,194,195],{"class":114}," cheerio",[104,197,198],{"class":114}," dotenv",[104,200,201],{"class":114}," cron\n",[17,203,204],{},".env：",[94,206,210],{"className":207,"code":208,"language":209,"meta":99,"style":99},"language-js shiki shiki-themes github-light github-light github-dark-high-contrast","\u002F\u002F .env\n# .env\nDISCORD_TOKEN=\nDISCORD_CLIENT_ID=\nDISCORD_CHANNEL_ID=\n","js",[101,211,212,218,224,233,240],{"__ignoreMap":99},[104,213,214],{"class":106,"line":107},[104,215,217],{"class":216},"sGBqm","\u002F\u002F .env\n",[104,219,220],{"class":106,"line":118},[104,221,223],{"class":222},"s8XSl","# .env\n",[104,225,226,229],{"class":106,"line":127},[104,227,228],{"class":121},"DISCORD_TOKEN",[104,230,232],{"class":231},"sOudu","=\n",[104,234,235,238],{"class":106,"line":139},[104,236,237],{"class":121},"DISCORD_CLIENT_ID",[104,239,232],{"class":231},[104,241,242,245],{"class":106,"line":148},[104,243,244],{"class":121},"DISCORD_CHANNEL_ID",[104,246,232],{"class":231},[17,248,249],{},"index.js：",[94,251,253],{"className":207,"code":252,"language":209,"meta":99,"style":99},"\u002F\u002F index.js\nrequire('dotenv').config();\n\nconst crawler = require('.\u002Fcrawler');\nconst postCron = require('.\u002FpostCron');\n\nconst {\n  Client,\n  GatewayIntentBits,\n  Partials,\n  Events,\n} = require('discord.js');\n\nconst client = new Client({\n  intents: [\n    GatewayIntentBits.Guilds,\n    GatewayIntentBits.GuildMessages,\n    GatewayIntentBits.MessageContent,\n  ],\n  partials: [\n    Partials.Channel,\n  ],\n});\n\nclient.once(Events.ClientReady, () => {\n  console.log('Ready!');\n  postCron(client).start();\n});\n\nclient.on(Events.InteractionCreate, async (interaction) => {\n  if (interaction.commandName === 'blog') {\n    const data = await crawler();\n    const randomIndex = Math.floor(Math.random() * data.length);\n    const randomData = data[randomIndex];\n    await interaction.reply(`隨機推薦一篇 Ray 的文章：[${randomData.title}](${randomData.url})`);\n  }\n});\n\nclient.login(process.env.DISCORD_TOKEN);\n",[101,254,255,260,281,287,309,327,331,338,346,354,362,370,388,393,412,418,424,430,436,442,448,454,459,465,470,487,503,517,522,527,555,573,591,627,640,681,687,692,697],{"__ignoreMap":99},[104,256,257],{"class":106,"line":107},[104,258,259],{"class":216},"\u002F\u002F index.js\n",[104,261,262,266,269,272,275,278],{"class":106,"line":118},[104,263,265],{"class":264},"scAaK","require",[104,267,268],{"class":222},"(",[104,270,271],{"class":114},"'dotenv'",[104,273,274],{"class":222},").",[104,276,277],{"class":264},"config",[104,279,280],{"class":222},"();\n",[104,282,283],{"class":106,"line":127},[104,284,286],{"emptyLinePlaceholder":285},true,"\n",[104,288,289,292,295,298,301,303,306],{"class":106,"line":139},[104,290,291],{"class":231},"const",[104,293,294],{"class":121}," crawler",[104,296,297],{"class":231}," =",[104,299,300],{"class":264}," require",[104,302,268],{"class":222},[104,304,305],{"class":114},"'.\u002Fcrawler'",[104,307,308],{"class":222},");\n",[104,310,311,313,316,318,320,322,325],{"class":106,"line":148},[104,312,291],{"class":231},[104,314,315],{"cla