[{"data":1,"prerenderedAt":36},["ShallowReactive",2],{"header-locale:\u002Ftags\u002FPaaS\u002F":3,"tag-page:zh-Hant:PaaS:1":4,"author-stats:zh-Hant:full":33},null,{"tag":5,"slug":5,"posts":6,"total":31,"totalPages":32},"PaaS",[7,18],{"url":8,"title":9,"date":10,"updated":10,"category":11,"tags":12,"description":16,"readingMinutes":17},"\u002Fother\u002F20261018\u002F3499703665\u002F","Zeabur 結束營運：台灣新創的跌倒與成長","2026-10-18 20:39:25","雜談",[13,14,5,15],"Zeabur","資安","部署","Zeabur 宣布 2026 年底結束營運。身為早期就認識創辦人、幫忙推廣過，又在八月資安事件被盜刷 500 多美金 API 額度的使用者，聊聊我眼中的 Zeabur，以及台灣新創在資源有限的情況下，怎麼在 MVP 跟資安之間取捨。","8",{"url":19,"title":20,"date":21,"updated":22,"category":11,"tags":23,"description":29,"readingMinutes":30},"\u002Fother\u002F20221213\u002F3036227586\u002F","關於從 Heroku 跳到 Render 這件事情","2022-12-13 09:59:23","2023-02-13 15:30:00",[24,25,5,26,15,27,28],"Heroku","Render","免費方案","GitHub","Git","Heroku 一直以來是我滿愛用的後端平台，可是 Heroku 在 2022\u002F11\u002F28 停止了免費方案，因此不得不將網站從 Heroku 轉移到他處，所以這一篇將會介紹一下如何轉到 Render.com 以及為什麼選擇了 Render。","6",2,1,{"postCount":34,"tagCount":35},1069,1106,1792338711325]