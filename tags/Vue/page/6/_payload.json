[{"data":1,"prerenderedAt":79},["ShallowReactive",2],{"header-locale:\u002Ftags\u002FVue\u002Fpage\u002F6\u002F":3,"tag-page:zh-Hant:Vue:6":4,"author-stats:zh-Hant:full":76},null,{"tag":5,"slug":5,"posts":6,"total":74,"totalPages":75},"Vue",[7,15,22,27,34,40,46,52,59,68],{"url":8,"title":9,"date":10,"updated":3,"category":5,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F335001087\u002F","Vue 出一個女友吧!-loading","2019-07-25 21:43:11",[5,12],"Vue 出一個女友吧","接下來要來替產品新增、修改以及刪除時增加一個 loading 特效，這樣子對於使用者體驗也會比較好，那這邊就會使用到 vue-loading-overlay","1",{"url":16,"title":17,"date":18,"updated":3,"category":5,"tags":19,"description":20,"readingMinutes":21},"\u002Fvue\u002F20190725\u002F1855985718\u002F","Vue 出一個女友吧!-產品頁面","2019-07-25 20:14:34",[5,12],"接下來是製作產品相關的 API，這邊將會講到商品建立、取得商品列表、修改商品以及刪除商品","3",{"url":23,"title":24,"date":25,"updated":3,"category":5,"tags":26,"description":24,"readingMinutes":21},"\u002Fvue\u002F20190725\u002F1960407570\u002F","Vue 出一個女友吧!-Login API","2019-07-25 16:16:05",[5,12],{"url":28,"title":29,"date":30,"updated":3,"category":5,"tags":31,"description":32,"readingMinutes":33},"\u002Fvue\u002F20190725\u002F1014459828\u002F","Vue 出一個女友吧!-Admin Page","2019-07-25 15:08:18",[5,12],"這一篇將會講到 Route 的部分，順便也會講到 Admin Page","2",{"url":35,"title":36,"date":37,"updated":3,"category":5,"tags":38,"description":39,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F3887985161\u002F","Vue 出一個女友吧!-PUG Template","2019-07-25 14:50:49",[5,12],"PUG Template 是我非常愛用的 HTML Template，所以講一下該如何使用在 Vue 中撰寫 PUG 吧",{"url":41,"title":42,"date":43,"updated":3,"category":5,"tags":44,"description":45,"readingMinutes":33},"\u002Fvue\u002F20190725\u002F1126109994\u002F","Vue 出一個女友吧!-SCSS & Boostrap 引入","2019-07-25 14:12:27",[5,12],"接下來的專案將會使用 Boostrap 幫助我們加速快速開發，所以就會需要引入 Boostrap",{"url":47,"title":48,"date":49,"updated":3,"category":5,"tags":50,"description":51,"readingMinutes":33},"\u002Fvue\u002F20190725\u002F3896075321\u002F","Vue 出一個女友吧!","2019-07-25 11:42:07",[5,12],"這是一個非常奇特的主題，至於為什麼會製作這個主題呢?後面再來講原因，這一系列將會講解紀錄使用 Vue Cli3 開發出一個平台唷",{"url":53,"title":54,"date":55,"updated":3,"category":5,"tags":56,"description":58,"readingMinutes":33},"\u002Fvue\u002F20190605\u002F1250642062\u002F","線上撰寫 Vue Cli 好物 CodeSandbox","2019-06-05 09:59:46",[57,5],"CodeSandbox","以往我們撰寫程式碼都是使用 codepen、jsbin 或是 jsfiddle，但是如果我們今天要撰寫 Vue Cli 的話，那這些線上平台就沒有辦法撰寫，但是 CodeSandbox 就可以做到這個需求，讓我們來線上撰寫 Vue Cli 吧!(~~有夠像業配~~)",{"url":60,"title":61,"date":62,"updated":3,"category":5,"tags":63,"description":67,"readingMinutes":21},"\u002Fvue\u002F20190513\u002F948497494\u002F","Vuejs部屬GitHub Pages","2019-05-13 19:34:56",[64,5,65,66],"JavaScript","Git","GitHub","開發 Vue.js 結束後接下來就是部屬上 GitHub，這邊紀錄一下指令該如何部屬到 GitHub Pages 吧~",{"url":69,"title":70,"date":71,"updated":3,"category":5,"tags":72,"description":73,"readingMinutes":33},"\u002Fvue\u002F20190510\u002F1766915506\u002F","props與emit的傳遞方式","2019-05-10 19:04:33",[64,5],"這幾天自己突然又開始使用 Vue 來製作一個小東西，因為我都是用 components 來製作，所以勢必要了解 props 與 emit 之間是如何傳遞的。",62,7,{"postCount":77,"tagCount":78},1050,1053,1790265907129]