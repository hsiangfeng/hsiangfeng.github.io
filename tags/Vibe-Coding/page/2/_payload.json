[{"data":1,"prerenderedAt":23},["ShallowReactive",2],{"header-locale:\u002Ftags\u002FVibe-Coding\u002Fpage\u002F2\u002F":3,"tag-page:zh-Hant:Vibe-Coding:2":4,"author-stats:zh-Hant:full":20},null,{"tag":5,"slug":6,"posts":7,"total":18,"totalPages":19},"Vibe Coding","Vibe-Coding",[8],{"url":9,"title":10,"date":11,"updated":11,"category":12,"tags":13,"description":16,"readingMinutes":17},"\u002Fai\u002F20251202\u002F797714546\u002F","淺談 AI Vibe Coding 當今主流的 BDD 與 SDD","2025-12-02 22:48:14","AI",[12,5,14,15],"BDD","SDD","基本上只要你有使用過 AI 來開發任何一個產品或者功能，你應該或多或少都聽過 AI 程式碼生成等詞彙。在這裡，我將這種「直接用自然語言來描述功能，由 AI 生成程式碼」的模式，稱為「Vibe Coding (直覺式開發)」。","9",11,2,{"postCount":21,"tagCount":22},1050,1053,1790265680847]