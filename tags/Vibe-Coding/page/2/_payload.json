[{"data":1,"prerenderedAt":39},["ShallowReactive",2],{"header-locale:\u002Ftags\u002FVibe-Coding\u002Fpage\u002F2\u002F":3,"tag-page:zh-Hant:Vibe-Coding:2":4,"author-stats:zh-Hant:full":36},null,{"tag":5,"slug":6,"posts":7,"total":34,"totalPages":35},"Vibe Coding","Vibe-Coding",[8,25],{"url":9,"title":10,"date":11,"updated":11,"category":12,"tags":13,"description":23,"readingMinutes":24},"\u002Fai\u002F20260427\u002F1657384902\u002F","想開始 Vibe Coding？新手推薦先搞懂的這些基礎知識","2026-04-27 14:30:00","AI",[12,5,14,15,16,17,18,19,20,21,22],"Git","GitHub","VSCode","Terminal","前端框架","UI Framework","Node.js","Prompt","新手入門","最近滿多朋友都跑來問我說「我也想用 AI 開發點東西，要從哪裡開始學？」，而這背後其實就是大家最近常聽到的 Vibe Coding。這一篇就來聊一下，新手如果想要踏入 Vibe Coding 的世界，到底有哪些基礎知識是推薦先搞懂的，例如 Git、命令列、UI Framework 等等，免得你做到一半才發現自己卡關卡到不知道該怎麼跟 AI 溝通。","12",{"url":26,"title":27,"date":28,"updated":28,"category":12,"tags":29,"description":32,"readingMinutes":33},"\u002Fai\u002F20251202\u002F797714546\u002F","淺談 AI Vibe Coding 當今主流的 BDD 與 SDD","2025-12-02 22:48:14",[12,5,30,31],"BDD","SDD","基本上只要你有使用過 AI 來開發任何一個產品或者功能，你應該或多或少都聽過 AI 程式碼生成等詞彙。在這裡，我將這種「直接用自然語言來描述功能，由 AI 生成程式碼」的模式，稱為「Vibe Coding (直覺式開發)」。","9",12,2,{"postCount":37,"tagCount":38},1052,1059,1790438727354]