[{"data":1,"prerenderedAt":26},["ShallowReactive",2],{"header-locale:\u002Ftags\u002FVibe-Coding-%E8%BF%AD%E4%BB%A3\u002F":3,"tag-page:zh-Hant:Vibe-Coding-迭代:1":4,"author-stats:zh-Hant:full":23},null,{"tag":5,"slug":6,"posts":7,"total":22,"totalPages":22},"Vibe Coding 迭代","Vibe-Coding-迭代",[8],{"url":9,"title":10,"date":11,"updated":11,"category":12,"tags":13,"description":20,"readingMinutes":21},"\u002Fai\u002F20260924\u002Fclaude-code-prompt-splitting\u002F","老闆不會教你的 Vibe Coding 實戰 30 天｜Day 11：功能迭代之一次一個的 Prompt 拆法","2026-09-24 09:00:00","AI",[14,15,5,16,17,18,19],"Claude Code","Claude Code Prompt 技巧","Vue 元件","Vue","記帳 App","老闆不會教你的 Vibe Coding 實戰 30 天","記帳 App 今天把 SPEC 剩下的功能補完：分類佔比、修改與刪除、月份切換，可是不是一句話全要，而是拆成三輪「做完、驗收、commit、換新對話」。這篇拆解好 prompt 的三要素（現況、要什麼、驗收標準），示範每一輪的實際 prompt 寫法，以及為什麼一個功能要開一個新對話。","7",1,{"postCount":24,"tagCount":25},1050,1053,1790347342320]