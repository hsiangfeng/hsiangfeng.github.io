[{"data":1,"prerenderedAt":382},["ShallowReactive",2],{"header-locale:\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F":3,"page:\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F":4,"alt:\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F":3,"prev-next:\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F":364,"related:\u002Fen\u002Fai\u002F2026\u002F10\u002F13\u002Fvibe-coding-30-days-recap\u002F":369},"\u002Fai\u002F20261013\u002Fvibe-coding-30-days-recap\u002F",{"id":5,"title":6,"abbrlink":7,"altUrl":3,"body":8,"category":342,"date":343,"description":344,"extension":345,"lang":346,"meta":347,"navigation":348,"path":349,"readingMinutes":350,"seo":351,"standalone":352,"stem":353,"tags":354,"tldr":7,"updated":343,"url":362,"__hash__":363},"content\u002Fen\u002FAI\u002Fvibe-coding-30-days-recap.md","30 Days of Vibe Coding | Day 30: Series Recap and the Full Table of Contents",null,{"type":9,"value":10,"toc":327},"minimark",[11,18,23,26,29,33,36,39,42,45,49,52,57,112,116,167,171,222,226,277,281,297,301,304,307,318,321,324],[12,13,14],"p",{},[15,16],"img",{"alt":6,"src":17},"https:\u002F\u002Fimages.israynotarray.com\u002Fblog\u002Fai\u002Fithome-2026-vibe-coding\u002Fvibe-coding-day-30-cover.png",[19,20,22],"h2",{"id":21},"intro","Intro",[12,24,25],{},"Somehow we've already made it to Day 30.",[12,27,28],{},"I'm keeping today simple: a few thoughts from me, and then everything organized into one table of contents.",[19,30,32],{"id":31},"thoughts-after-30-days","Thoughts after 30 days",[12,34,35],{},"Hmm... honestly...",[12,37,38],{},"Non-technical writing is a real challenge for me. Explaining AI agents in particular was way harder than I expected, while just walking through a technology or a workflow felt pretty easy.",[12,40,41],{},"So Day 1 through Day 20 were relatively easy to write, but from Day 20 to Day 29 things got a lot harder (I may have even started slacking off a bit lol). If the second half feels kind of rough... please forgive me?!",[12,43,44],{},"Okay, enough rambling. Here's the table of contents, so you can find whatever you're looking for.",[19,46,48],{"id":47},"the-full-table-of-contents","The full table of contents",[12,50,51],{},"I've grouped all 30 days by week. If something catches your eye, just click straight in:",[53,54,56],"h3",{"id":55},"week-1-getting-the-concepts-and-basics-down","Week 1: Getting the concepts and basics down",[58,59,60,70,77,84,91,98,105],"ul",{},[61,62,63],"li",{},[64,65,69],"a",{"href":66,"rel":67},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F14\u002Fvibe-coding-30-days-intro\u002F",[68],"nofollow","Day 1: The 30-Day Roadmap to Building an Expense Tracker App with Claude Code",[61,71,72],{},[64,73,76],{"href":74,"rel":75},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F15\u002Fwhat-is-vibe-coding\u002F",[68],"Day 2: What Is Vibe Coding? A Different Kind of Knowing",[61,78,79],{},[64,80,83],{"href":81,"rel":82},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F16\u002Fclaude-code-install-and-pricing\u002F",[68],"Day 3: Installing Claude Code and Picking a Subscription Plan",[61,85,86],{},[64,87,90],{"href":88,"rel":89},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F17\u002Fclaude-code-first-task-read-diff\u002F",[68],"Day 4: Your First Task — The Smallest Loop for Changing Code",[61,92,93],{},[64,94,97],{"href":95,"rel":96},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F18\u002Fclaude-code-permission-plan-mode\u002F",[68],"Day 5: Permissions and Plan Mode — Stop Hitting Yes on Everything",[61,99,100],{},[64,101,104],{"href":102,"rel":103},"https:\u002F\u002Fisraynotarray.com\u002Fen\u002Fai\u002F2026\u002F09\u002F19\u002Fclaude-code-clear-vs-compact\u002F",[68],"Day 6: Context and Tokens — Why AI Gets Dumber the Longer You Chat