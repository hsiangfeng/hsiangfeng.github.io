[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F73\u002F":3,"archive-page:zh-Hant:73":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,18,25,33,39,45,51,57,63,69],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fphp\u002F20190929\u002F691833817\u002F","Day28-從基礎學習 ThinkPHP-製作一個留言版","2019-09-29 00:00:05","PHP",[10,12,13,14,15],"MySQL","ThinkPHP 5.1","從基礎學習 ThinkPHP","第 11 屆 iT邦幫忙鐵人賽","基礎的 ThinkPHP 框架也學習差不多，這一篇將會稍微講一下製作一個留言版的部分，但是並不會講程式碼，這一篇重點在於留言版規劃，因為基本上都是結合前面所學的技巧而已，所以最後會附上 GitHub 當作參考唷。","3",{"url":19,"title":20,"date":21,"updated":3,"category":10,"tags":22,"description":23,"readingMinutes":24},"\u002Fphp\u002F20190928\u002F142867792\u002F","Day27-從基礎學習 ThinkPHP-分頁","2019-09-28 00:00:10",[10,12,13,14,15],"接下來讓我們講一個網站很常使用的功能，也就是分頁功能，本身 ThinkPHP 也有提供分頁功能，那該怎麼做呢?所以這一邊就會來介紹該如何使用分頁。","2",{"url":26,"title":27,"date":28,"updated":3,"category":29,"tags":30,"description":32,"readingMinutes":24},"\u002Fjavascript\u002F20190928\u002F458010850\u002F","EP.13 RE：從零開始的學習 JS 生活-第十三日之文件物件模型 DOM","2019-09-28 00:00:05","JavaScript",[29,31,15],"RE：從零開始的學習 JS 生活","轉生第十三日，這一篇將會來介紹 DOM，也就是所謂的文件物件模型。",{"url":34,"title":35,"date":36,"updated":3,"category":10,"tags":37,"description":38,"readingMinutes":17},"\u002Fphp\u002F20190927\u002F3311186145\u002F","Day26-從基礎學習 ThinkPHP-驗證碼","2019-09-27 00:00:10",[10,12,13,14,15],"這一篇將會來介紹 ThinkPHP 中的驗證碼功能，本身 ThinkPHP 就有提供驗證碼功能，如果沒有特別的需求的話，使用 ThinkPHP 本身內建驗證碼功能是滿足夠使用的。",{"url":40,"title":41,"date":42,"updated":3,"category":29,"tags":43,"description":44,"readingMinutes":24},"\u002Fjavascript\u002F20190927\u002F2624380963\u002F","EP.12 RE：從零開始的學習 JS 生活-第十二日之迴圈","2019-09-27 00:00:05",[29,31,15],"轉生第十二日，這一篇將會來介紹迴圈。",{"url":46,"title":47,"date":48,"updated":3,"category":10,"tags":49,"description":50,"readingMinutes":17},"\u002Fphp\u002F20190926\u002F2431942103\u002F","Day25-從基礎學習 ThinkPHP-表單 Token","2019-09-26 00:00:05",[10,12,13,14,15],"講完表單驗證，那麼這一篇就要來講表單 Token，表單 Token 是需要搭配前面的表單驗證才能夠使用，所以我才會將表單 Token 留在表單驗證後面，那麼就讓我們來了解什麼是表單 Token 吧!",{"url":52,"title":53,"date":54,"updated":3,"category":29,"tags":55,"description":56,"readingMinutes":17},"\u002Fjavascript\u002F20190926\u002F692592143\u002F","EP.11 RE：從零開始的學習 JS 生活-第十一日之型別轉換","2019-09-26 00:00:03",[29,31,15],"轉生第十一日，這一篇將會來介紹 JavaScript 的型別轉換，而這是 JavaScript 中滿常見且非常重要的觀念。",{"url":58,"title":59,"date":60,"updated":3,"category":29,"tags":61,"description":62,"readingMinutes":24},"\u002Fjavascript\u002F20190925\u002F2798516984\u002F","EP.10 RE：從零開始的學習 JS 生活-第十日之條件式判斷","2019-09-25 00:00:10",[29,31,15],"轉生第十日，這一篇將會介紹條件式判斷，所謂的條件式判斷不外乎就是在講 if...else... 以及 switch 等。",{"url":64,"title":65,"date":66,"updated":3,"category":10,"tags":67,"description":68,"readingMinutes":24},"\u002Fphp\u002F20190925\u002F1108470009\u002F","Day24-從基礎學習 ThinkPHP-表單驗證(2)","2019-09-25 00:00:05",[10,12,13,14,15],"前一篇我們已經將基礎的表單驗證給完成，但是其實只介紹一半，所以我將文章拆成了兩個部分，接下來讓我們繼續學習表單驗證吧!",{"url":70,"title":71,"date":72,"updated":3,"category":73,"tags":74,"description":77,"readingMinutes":24},"\u002Fother\u002F20190924\u002F3446878284\u002F","Window PowerShell美化(Windows Terminal)","2019-09-24 13:53:52","雜談",[75,76],"軟體操作","Terminal","身為一名工程師來講，最常接觸的就是 Cmd 介面，也就是所謂的終端機，那麼長久看同一個畫面也是會膩的，所以這一篇記錄一下該如何美化自己的 Terminal 吧。",1043,105,{"postCount":78,"tagCount":81},1032,1789660845771]