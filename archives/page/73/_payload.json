[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F73\u002F":3,"archive-page:zh-Hant:73":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,18,27,34,42,49,55,61,67,73],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fphp\u002F20191001\u002F106986397\u002F","Day30-從基礎學習 ThinkPHP-部屬 Heroku","2019-10-01 00:00:01","PHP",[10,12,13,14,15],"MySQL","ThinkPHP 5.1","從基礎學習 ThinkPHP","第 11 屆 iT邦幫忙鐵人賽","接下來這一篇將會介紹如何將我們前面章節所做好的 ThinkPHP 系統部屬到 Heroku 囉~","3",{"url":19,"title":20,"date":21,"updated":21,"category":22,"tags":23,"description":25,"readingMinutes":26},"\u002Flearnexp\u002F20190930\u002F236119363\u002F","被車輪戰的六角同學會","2019-09-30 12:06:42","學習經驗",[24,22],"其他","在 107\u002F09\u002F29 教師節當天六角學院舉辦了六角同學會，過程有一個自由聊天時間，所以這一篇就來記錄一下我被學員們車輪戰的過程吧(?!)","5",{"url":28,"title":29,"date":30,"updated":3,"category":10,"tags":31,"description":32,"readingMinutes":33},"\u002Fphp\u002F20190930\u002F81339708\u002F","Day29-從基礎學習 ThinkPHP-ThinkPHP 指令","2019-09-30 00:00:02",[10,12,13,14,15],"接下來我們會來認識一下 ThinkPHP 一些常用的基礎指令，但是這一篇最主要是介紹 migration 的部分，因為會影響後面的章節操作。","4",{"url":35,"title":36,"date":37,"updated":3,"category":38,"tags":39,"description":41,"readingMinutes":17},"\u002Fjavascript\u002F20190930\u002F317345641\u002F","EP.15 RE：從零開始的學習 JS 生活-第十五日之原生 AJAX","2019-09-30 00:00:01","JavaScript",[38,40,15],"RE：從零開始的學習 JS 生活","轉生第十五日，這章節將會來介紹原生的 AJAX 技術。",{"url":43,"title":44,"date":45,"updated":3,"category":38,"tags":46,"description":47,"readingMinutes":48},"\u002Fjavascript\u002F20190929\u002F3075111357\u002F","EP.14 RE：從零開始的學習 JS 生活-第十四日之 JSON","2019-09-29 00:00:10",[38,40,15],"轉生第十四日，這一篇將會來介紹 JSON。","2",{"url":50,"title":51,"date":52,"updated":3,"category":10,"tags":53,"description":54,"readingMinutes":17},"\u002Fphp\u002F20190929\u002F691833817\u002F","Day28-從基礎學習 ThinkPHP-製作一個留言版","2019-09-29 00:00:05",[10,12,13,14,15],"基礎的 ThinkPHP 框架也學習差不多，這一篇將會稍微講一下製作一個留言版的部分，但是並不會講程式碼，這一篇重點在於留言版規劃，因為基本上都是結合前面所學的技巧而已，所以最後會附上 GitHub 當作參考唷。",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":60,"readingMinutes":48},"\u002Fphp\u002F20190928\u002F142867792\u002F","Day27-從基礎學習 ThinkPHP-分頁","2019-09-28 00:00:10",[10,12,13,14,15],"接下來讓我們講一個網站很常使用的功能，也就是分頁功能，本身 ThinkPHP 也有提供分頁功能，那該怎麼做呢?所以這一邊就會來介紹該如何使用分頁。",{"url":62,"title":63,"date":64,"updated":3,"category":38,"tags":65,"description":66,"readingMinutes":48},"\u002Fjavascript\u002F20190928\u002F458010850\u002F","EP.13 RE：從零開始的學習 JS 生活-第十三日之文件物件模型 DOM","2019-09-28 00:00:05",[38,40,15],"轉生第十三日，這一篇將會來介紹 DOM，也就是所謂的文件物件模型。",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":17},"\u002Fphp\u002F20190927\u002F3311186145\u002F","Day26-從基礎學習 ThinkPHP-驗證碼","2019-09-27 00:00:10",[10,12,13,14,15],"這一篇將會來介紹 ThinkPHP 中的驗證碼功能，本身 ThinkPHP 就有提供驗證碼功能，如果沒有特別的需求的話，使用 ThinkPHP 本身內建驗證碼功能是滿足夠使用的。",{"url":74,"title":75,"date":76,"updated":3,"category":38,"tags":77,"description":78,"readingMinutes":48},"\u002Fjavascript\u002F20190927\u002F2624380963\u002F","EP.12 RE：從零開始的學習 JS 生活-第十二日之迴圈","2019-09-27 00:00:05",[38,40,15],"轉生第十二日，這一篇將會來介紹迴圈。",1048,105,{"postCount":79,"tagCount":82},1047,1790132714315]