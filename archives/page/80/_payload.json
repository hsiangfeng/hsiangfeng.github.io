[{"data":1,"prerenderedAt":75},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F80\u002F":3,"archive-page:zh-Hant:80":4,"author-stats:zh-Hant:full":73},null,{"posts":5,"total":71,"totalPages":72},[6,15,21,27,34,39,46,52,58,64],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190727\u002F3081561859\u002F","Vue 出一個女友吧!-組件溝通 event bus","2019-07-27 17:16:15","Vue",[10,12],"Vue 出一個女友吧","接下來將會講一個東西叫做組件溝通 event bus，可是我個人比較喜歡講成元件溝通就是了...那麼 event bus 會拿來做什麼呢?來記錄一下吧","1",{"url":16,"title":17,"date":18,"updated":3,"category":10,"tags":19,"description":20,"readingMinutes":14},"\u002Fvue\u002F20190726\u002F2706745772\u002F","Vue 出一個女友吧!-vue-fontawesome","2019-07-26 21:09:13",[10,12],"接下來講講其中一個套件，也就是 vue-fontawesome，在前面我們已經安裝了，但是該怎麼使用呢?來記錄一下吧",{"url":22,"title":23,"date":24,"updated":3,"category":10,"tags":25,"description":26,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F335001087\u002F","Vue 出一個女友吧!-loading","2019-07-25 21:43:11",[10,12],"接下來要來替產品新增、修改以及刪除時增加一個 loading 特效，這樣子對於使用者體驗也會比較好，那這邊就會使用到 vue-loading-overlay",{"url":28,"title":29,"date":30,"updated":3,"category":10,"tags":31,"description":32,"readingMinutes":33},"\u002Fvue\u002F20190725\u002F1855985718\u002F","Vue 出一個女友吧!-產品頁面","2019-07-25 20:14:34",[10,12],"接下來是製作產品相關的 API，這邊將會講到商品建立、取得商品列表、修改商品以及刪除商品","3",{"url":35,"title":36,"date":37,"updated":3,"category":10,"tags":38,"description":36,"readingMinutes":33},"\u002Fvue\u002F20190725\u002F1960407570\u002F","Vue 出一個女友吧!-Login API","2019-07-25 16:16:05",[10,12],{"url":40,"title":41,"date":42,"updated":3,"category":10,"tags":43,"description":44,"readingMinutes":45},"\u002Fvue\u002F20190725\u002F1014459828\u002F","Vue 出一個女友吧!-Admin Page","2019-07-25 15:08:18",[10,12],"這一篇將會講到 Route 的部分，順便也會講到 Admin Page","2",{"url":47,"title":48,"date":49,"updated":3,"category":10,"tags":50,"description":51,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F3887985161\u002F","Vue 出一個女友吧!-PUG Template","2019-07-25 14:50:49",[10,12],"PUG Template 是我非常愛用的 HTML Template，所以講一下該如何使用在 Vue 中撰寫 PUG 吧",{"url":53,"title":54,"date":55,"updated":3,"category":10,"tags":56,"description":57,"readingMinutes":45},"\u002Fvue\u002F20190725\u002F1126109994\u002F","Vue 出一個女友吧!-SCSS & Boostrap 引入","2019-07-25 14:12:27",[10,12],"接下來的專案將會使用 Boostrap 幫助我們加速快速開發，所以就會需要引入 Boostrap",{"url":59,"title":60,"date":61,"updated":3,"category":10,"tags":62,"description":63,"readingMinutes":45},"\u002Fvue\u002F20190725\u002F3896075321\u002F","Vue 出一個女友吧!","2019-07-25 11:42:07",[10,12],"這是一個非常奇特的主題，至於為什麼會製作這個主題呢?後面再來講原因，這一系列將會講解紀錄使用 Vue Cli3 開發出一個平台唷",{"url":65,"title":66,"date":67,"updated":3,"category":68,"tags":69,"description":70,"readingMinutes":45},"\u002Fjavascript\u002F20190724\u002F834556007\u002F","JavaScript 取得 QueryString 方式","2019-07-24 09:41:36","JavaScript",[68],"有些時候我們會需要使用 JavaScript 取得 URL QueryString 的參數，所以這邊做一下紀錄可以使用哪些方式取得",1048,105,{"postCount":71,"tagCount":74},1047,1790132714487]