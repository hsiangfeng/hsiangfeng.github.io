[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F80\u002F":3,"archive-page:zh-Hant:80":4,"author-stats:zh-Hant:full":75},null,{"posts":5,"total":73,"totalPages":74},[6,15,22,30,36,42,48,55,60,67],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190729\u002F371929708\u002F","Vue 出一個女友吧!-製作分頁邏輯-2","2019-07-29 16:17:31","Vue",[10,12],"Vue 出一個女友吧","從上一篇就可以了解到其實前端也是可以製作分頁邏輯的，但是會相當複雜，如果後端有做好相關的分頁邏輯 API 給前端那就會不一樣囉","1",{"url":16,"title":17,"date":18,"updated":3,"category":10,"tags":19,"description":20,"readingMinutes":21},"\u002Fvue\u002F20190729\u002F2401395670\u002F","Vue 出一個女友吧!-製作分頁邏輯-1","2019-07-29 09:47:57",[10,12],"接下來講講製作分頁邏輯的部分，好在本身 API 就已經有判斷分頁了","5",{"url":23,"title":24,"date":25,"updated":3,"category":26,"tags":27,"description":28,"readingMinutes":29},"\u002Fjavascript\u002F20190728\u002F313613648\u002F","關於我逃出胡立的異世界 R30 這件事之攻略包","2019-07-28 10:08:31","JavaScript",[26],"由於這個系列是紀錄挑戰胡立分享的遊戲 [異世界?r3:0挑戰] 的挑戰紀錄，也不知道該算在哪個分類，所以就乾脆都放在 JavaScript 下囉~","4",{"url":31,"title":32,"date":33,"updated":3,"category":10,"tags":34,"description":35,"readingMinutes":14},"\u002Fvue\u002F20190727\u002F3081561859\u002F","Vue 出一個女友吧!-組件溝通 event bus","2019-07-27 17:16:15",[10,12],"接下來將會講一個東西叫做組件溝通 event bus，可是我個人比較喜歡講成元件溝通就是了...那麼 event bus 會拿來做什麼呢?來記錄一下吧",{"url":37,"title":38,"date":39,"updated":3,"category":10,"tags":40,"description":41,"readingMinutes":14},"\u002Fvue\u002F20190726\u002F2706745772\u002F","Vue 出一個女友吧!-vue-fontawesome","2019-07-26 21:09:13",[10,12],"接下來講講其中一個套件，也就是 vue-fontawesome，在前面我們已經安裝了，但是該怎麼使用呢?來記錄一下吧",{"url":43,"title":44,"date":45,"updated":3,"category":10,"tags":46,"description":47,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F335001087\u002F","Vue 出一個女友吧!-loading","2019-07-25 21:43:11",[10,12],"接下來要來替產品新增、修改以及刪除時增加一個 loading 特效，這樣子對於使用者體驗也會比較好，那這邊就會使用到 vue-loading-overlay",{"url":49,"title":50,"date":51,"updated":3,"category":10,"tags":52,"description":53,"readingMinutes":54},"\u002Fvue\u002F20190725\u002F1855985718\u002F","Vue 出一個女友吧!-產品頁面","2019-07-25 20:14:34",[10,12],"接下來是製作產品相關的 API，這邊將會講到商品建立、取得商品列表、修改商品以及刪除商品","3",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":57,"readingMinutes":54},"\u002Fvue\u002F20190725\u002F1960407570\u002F","Vue 出一個女友吧!-Login API","2019-07-25 16:16:05",[10,12],{"url":61,"title":62,"date":63,"updated":3,"category":10,"tags":64,"description":65,"readingMinutes":66},"\u002Fvue\u002F20190725\u002F1014459828\u002F","Vue 出一個女友吧!-Admin Page","2019-07-25 15:08:18",[10,12],"這一篇將會講到 Route 的部分，順便也會講到 Admin Page","2",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F3887985161\u002F","Vue 出一個女友吧!-PUG Template","2019-07-25 14:50:49",[10,12],"PUG Template 是我非常愛用的 HTML Template，所以講一下該如何使用在 Vue 中撰寫 PUG 吧",1051,106,{"postCount":73,"tagCount":76},1057,1790352032076]