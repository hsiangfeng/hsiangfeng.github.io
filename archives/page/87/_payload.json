[{"data":1,"prerenderedAt":80},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F87\u002F":3,"archive-page:zh-Hant:87":4,"author-stats:zh-Hant:full":78},null,{"posts":5,"total":76,"totalPages":77},[6,15,21,29,35,41,47,53,62,69],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fnodejs\u002F20190626\u002F1317979814\u002F","npm 安裝指令差異","2019-06-26 22:03:53","Nodejs",[12],"Node.js","基本上這一篇算是做一下筆記整理，避免自己哪天金魚腦忘記，雖然很常打就是了","1",{"url":16,"title":17,"date":18,"updated":3,"category":10,"tags":19,"description":20,"readingMinutes":14},"\u002Fnodejs\u002F20190626\u002F2459037265\u002F","npm 版本號辨別","2019-06-26 21:19:03",[12],"這邊紀錄一下如何辨別 npm 版本號，避免自己忘記怎麼看板本號...",{"url":22,"title":23,"date":24,"updated":3,"category":10,"tags":25,"description":27,"readingMinutes":28},"\u002Fnodejs\u002F20190626\u002F477012262\u002F","全端勇士之路 Node.js 基礎學習-開啟 Web Server","2019-06-26 19:33:04",[12,26],"全端勇士之路 Node.js","接下來我們就準備來學習開啟 Web Server，而 Node.js 本身就提供了 Web Server 的功能，所以就來看看怎麼建立一個 Web Server","2",{"url":30,"title":31,"date":32,"updated":3,"category":10,"tags":33,"description":34,"readingMinutes":28},"\u002Fnodejs\u002F20190626\u002F269653331\u002F","全端勇士之路 Node.js 基礎學習-模組化開發","2019-06-26 16:14:21",[12,26],"接下來這邊將會來記錄一下 Node.js 的模組化開發，首先我們必須先認識到幾個語法。",{"url":36,"title":37,"date":38,"updated":3,"category":10,"tags":39,"description":40,"readingMinutes":14},"\u002Fnodejs\u002F20190626\u002F1683312860\u002F","全端勇士之路 Node.js 基礎學習-全域物件","2019-06-26 14:09:37",[12,26],"一般來講我們再撰寫 JavaScript 時都知道在瀏覽器上有一個全域物件叫做 Window，但是在 Node.js 上也有一個全域物件",{"url":42,"title":43,"date":44,"updated":3,"category":10,"tags":45,"description":46,"readingMinutes":14},"\u002Fnodejs\u002F20190626\u002F658065960\u002F","全端勇士之路 Node.js 基礎學習-node 模式","2019-06-26 13:55:08",[12,26],"這個篇幅可能會比較短，主要只是記錄可以使用 node 模式直接來撰寫 JavaScript。",{"url":48,"title":49,"date":50,"updated":3,"category":10,"tags":51,"description":52,"readingMinutes":28},"\u002Fnodejs\u002F20190626\u002F1885201810\u002F","全端勇士之路 Node.js 基礎學習-基礎篇","2019-06-26 12:02:21",[12,26],"又是一篇基礎學習系列的開啟，這是為了讓自己對 Node.js 觀念及開發更清楚所撰寫的系列文章，廢話不多說就開始吧~",{"url":54,"title":55,"date":56,"updated":3,"category":57,"tags":58,"description":61,"readingMinutes":14},"\u002Fpython\u002F20190626\u002F2933081730\u002F","拖曳影片檔案到 CMD 圖示內透過 Python 生成影片字幕","2019-06-26 10:13:30","Python",[57,59,60],"AI","字幕","由於先前撰寫了[使用 Python 替影片自動上字幕]的文章，後來自己在使用的時候每一次都要打開指令視窗輸入指令，對於金魚腦的我來講實在很不方便，所以這邊稍微製作 .bat 檔案，直接拖曳進去自動生成字幕。",{"url":63,"title":64,"date":65,"updated":3,"category":66,"tags":67,"description":68,"readingMinutes":14},"\u002Fjavascript\u002F20190625\u002F981473819\u002F","let、const 提升的雷點","2019-06-25 19:52:32","JavaScript",[66],"今天看到一個題目，一開始我以為 undefined & undefined，結果竟然不是，所以這邊紀錄一下題目及答案。",{"url":70,"title":71,"date":72,"updated":3,"category":66,"tags":73,"description":74,"readingMinutes":75},"\u002Fjavascript\u002F20190624\u002F604717444\u002F","嘗試了解 JavaScript 的原型鏈","2019-06-24 12:28:48",[66],"這一篇其實我一直猶豫該不該寫，因為我深怕一個地方紀錄錯了會導致其他看的人也跟著錯，但是想一想我當初撰寫 Hexo 部落格的初衷是做自己的筆記後就又好點了，這一篇來記錄一下 JavaScript 的原型鏈這個主題","3",1044,105,{"postCount":76,"tagCount":79},1034,1789747447281]