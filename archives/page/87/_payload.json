[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F87\u002F":3,"archive-page:zh-Hant:87":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,16,22,29,35,41,50,57,64,72],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20190626\u002F477012262\u002F","全端勇士之路 Node.js 基礎學習-開啟 Web Server","2019-06-26 19:33:04","Nodejs",[12,13],"Node.js","全端勇士之路 Node.js","接下來我們就準備來學習開啟 Web Server，而 Node.js 本身就提供了 Web Server 的功能，所以就來看看怎麼建立一個 Web Server","2",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":15},"\u002Fnodejs\u002F20190626\u002F269653331\u002F","全端勇士之路 Node.js 基礎學習-模組化開發","2019-06-26 16:14:21",[12,13],"接下來這邊將會來記錄一下 Node.js 的模組化開發，首先我們必須先認識到幾個語法。",{"url":23,"title":24,"date":25,"updated":3,"category":10,"tags":26,"description":27,"readingMinutes":28},"\u002Fnodejs\u002F20190626\u002F1683312860\u002F","全端勇士之路 Node.js 基礎學習-全域物件","2019-06-26 14:09:37",[12,13],"一般來講我們再撰寫 JavaScript 時都知道在瀏覽器上有一個全域物件叫做 Window，但是在 Node.js 上也有一個全域物件","1",{"url":30,"title":31,"date":32,"updated":3,"category":10,"tags":33,"description":34,"readingMinutes":28},"\u002Fnodejs\u002F20190626\u002F658065960\u002F","全端勇士之路 Node.js 基礎學習-node 模式","2019-06-26 13:55:08",[12,13],"這個篇幅可能會比較短，主要只是記錄可以使用 node 模式直接來撰寫 JavaScript。",{"url":36,"title":37,"date":38,"updated":3,"category":10,"tags":39,"description":40,"readingMinutes":15},"\u002Fnodejs\u002F20190626\u002F1885201810\u002F","全端勇士之路 Node.js 基礎學習-基礎篇","2019-06-26 12:02:21",[12,13],"又是一篇基礎學習系列的開啟，這是為了讓自己對 Node.js 觀念及開發更清楚所撰寫的系列文章，廢話不多說就開始吧~",{"url":42,"title":43,"date":44,"updated":3,"category":45,"tags":46,"description":49,"readingMinutes":28},"\u002Fpython\u002F20190626\u002F2933081730\u002F","拖曳影片檔案到 CMD 圖示內透過 Python 生成影片字幕","2019-06-26 10:13:30","Python",[45,47,48],"AI","字幕","由於先前撰寫了[使用 Python 替影片自動上字幕]的文章，後來自己在使用的時候每一次都要打開指令視窗輸入指令，對於金魚腦的我來講實在很不方便，所以這邊稍微製作 .bat 檔案，直接拖曳進去自動生成字幕。",{"url":51,"title":52,"date":53,"updated":3,"category":54,"tags":55,"description":56,"readingMinutes":28},"\u002Fjavascript\u002F20190625\u002F981473819\u002F","let、const 提升的雷點","2019-06-25 19:52:32","JavaScript",[54],"今天看到一個題目，一開始我以為 undefined & undefined，結果竟然不是，所以這邊紀錄一下題目及答案。",{"url":58,"title":59,"date":60,"updated":3,"category":54,"tags":61,"description":62,"readingMinutes":63},"\u002Fjavascript\u002F20190624\u002F604717444\u002F","嘗試了解 JavaScript 的原型鏈","2019-06-24 12:28:48",[54],"這一篇其實我一直猶豫該不該寫，因為我深怕一個地方紀錄錯了會導致其他看的人也跟著錯，但是想一想我當初撰寫 Hexo 部落格的初衷是做自己的筆記後就又好點了，這一篇來記錄一下 JavaScript 的原型鏈這個主題","3",{"url":65,"title":66,"date":67,"updated":3,"category":68,"tags":69,"description":71,"readingMinutes":63},"\u002FTypeScript\u002F20190623\u002F3262185960\u002F","TypeScript 基礎入門-Class","2019-06-23 11:43:56","TypeScript",[70,54,68],"TypeScript 基礎入門","類別(class)這個是在 ES6 引入的，而這個功能又有何用處呢?讓我們來研究一下",{"url":73,"title":74,"date":75,"updated":3,"category":68,"tags":76,"description":77,"readingMinutes":28},"\u002FTypeScript\u002F20190622\u002F2385966784\u002F","TypeScript 基礎入門-Array","2019-06-22 22:27:26",[70,54,68],"接下來講到陣列的撰寫方式，其實與撰寫變數是太大的差異，這邊就來了解一下 TypeScript 中應該怎麼寫陣列吧",1042,105,{"postCount":78,"tagCount":81},1028,1789574403710]