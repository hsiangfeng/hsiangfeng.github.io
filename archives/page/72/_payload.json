[{"data":1,"prerenderedAt":84},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F72\u002F":3,"archive-page:zh-Hant:72":4,"author-stats:zh-Hant:full":82},null,{"posts":5,"total":80,"totalPages":81},[6,18,27,33,40,49,56,62,68,74],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fphp\u002F20191002\u002F3041589016\u002F","Day31-從基礎學習 ThinkPHP-結束只是另一個開始","2019-10-02 00:00:02","PHP",[10,12,13,14,15],"MySQL","ThinkPHP 5.1","從基礎學習 ThinkPHP","第 11 屆 iT邦幫忙鐵人賽","最後我選在第 31 天來當作結尾的宣告，所以這一篇主要是寫參賽結尾的感言~","2",{"url":19,"title":20,"date":21,"updated":3,"category":22,"tags":23,"description":25,"readingMinutes":26},"\u002Fjavascript\u002F20191002\u002F3941110344\u002F","EP.17 RE：從零開始的學習 JS 生活-第十七日之 Cookie","2019-10-02 00:00:01","JavaScript",[22,24,15],"RE：從零開始的學習 JS 生活","轉生第十七日，這一篇將會介紹 Cookie。","1",{"url":28,"title":29,"date":30,"updated":3,"category":22,"tags":31,"description":32,"readingMinutes":26},"\u002Fjavascript\u002F20191001\u002F4074116676\u002F","EP.16 RE：從零開始的學習 JS 生活-第十六日之優先性與相依性","2019-10-01 00:00:03",[22,24,15],"轉生第十六日，這一篇將會來介紹運算子的優先性與相依性。",{"url":34,"title":35,"date":36,"updated":3,"category":10,"tags":37,"description":38,"readingMinutes":39},"\u002Fphp\u002F20191001\u002F106986397\u002F","Day30-從基礎學習 ThinkPHP-部屬 Heroku","2019-10-01 00:00:01",[10,12,13,14,15],"接下來這一篇將會介紹如何將我們前面章節所做好的 ThinkPHP 系統部屬到 Heroku 囉~","3",{"url":41,"title":42,"date":43,"updated":43,"category":44,"tags":45,"description":47,"readingMinutes":48},"\u002Flearnexp\u002F20190930\u002F236119363\u002F","被車輪戰的六角同學會","2019-09-30 12:06:42","學習經驗",[46,44],"其他","在 107\u002F09\u002F29 教師節當天六角學院舉辦了六角同學會，過程有一個自由聊天時間，所以這一篇就來記錄一下我被學員們車輪戰的過程吧(?!)","5",{"url":50,"title":51,"date":52,"updated":3,"category":10,"tags":53,"description":54,"readingMinutes":55},"\u002Fphp\u002F20190930\u002F81339708\u002F","Day29-從基礎學習 ThinkPHP-ThinkPHP 指令","2019-09-30 00:00:02",[10,12,13,14,15],"接下來我們會來認識一下 ThinkPHP 一些常用的基礎指令，但是這一篇最主要是介紹 migration 的部分，因為會影響後面的章節操作。","4",{"url":57,"title":58,"date":59,"updated":3,"category":22,"tags":60,"description":61,"readingMinutes":39},"\u002Fjavascript\u002F20190930\u002F317345641\u002F","EP.15 RE：從零開始的學習 JS 生活-第十五日之原生 AJAX","2019-09-30 00:00:01",[22,24,15],"轉生第十五日，這章節將會來介紹原生的 AJAX 技術。",{"url":63,"title":64,"date":65,"updated":3,"category":22,"tags":66,"description":67,"readingMinutes":17},"\u002Fjavascript\u002F20190929\u002F3075111357\u002F","EP.14 RE：從零開始的學習 JS 生活-第十四日之 JSON","2019-09-29 00:00:10",[22,24,15],"轉生第十四日，這一篇將會來介紹 JSON。",{"url":69,"title":70,"date":71,"updated":3,"category":10,"tags":72,"description":73,"readingMinutes":39},"\u002Fphp\u002F20190929\u002F691833817\u002F","Day28-從基礎學習 ThinkPHP-製作一個留言版","2019-09-29 00:00:05",[10,12,13,14,15],"基礎的 ThinkPHP 框架也學習差不多，這一篇將會稍微講一下製作一個留言版的部分，但是並不會講程式碼，這一篇重點在於留言版規劃，因為基本上都是結合前面所學的技巧而已，所以最後會附上 GitHub 當作參考唷。",{"url":75,"title":76,"date":77,"updated":3,"category":10,"tags":78,"description":79,"readingMinutes":17},"\u002Fphp\u002F20190928\u002F142867792\u002F","Day27-從基礎學習 ThinkPHP-分頁","2019-09-28 00:00:10",[10,12,13,14,15],"接下來讓我們講一個網站很常使用的功能，也就是分頁功能，本身 ThinkPHP 也有提供分頁功能，那該怎麼做呢?所以這一邊就會來介紹該如何使用分頁。",1041,105,{"postCount":80,"tagCount":83},1026,1789488951081]