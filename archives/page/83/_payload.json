[{"data":1,"prerenderedAt":78},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F83\u002F":3,"archive-page:zh-Hant:83":4,"author-stats:zh-Hant:full":76},null,{"posts":5,"total":74,"totalPages":75},[6,16,23,30,37,44,50,56,62,68],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20190708\u002F3972209423\u002F","全端勇士之路 Node.js 基礎學習-會員機制(4)","2019-07-08 10:40:48","Nodejs",[12,13],"Node.js","全端勇士之路 Node.js","前面已經記錄了許多會員註冊 & 登入以及判定，但是如果今天不希望讓使用者直接透過網址列跳到 user 頁面呢?那麼就要使用到 middleware","1",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":22},"\u002Fnodejs\u002F20190708\u002F2743242184\u002F","全端勇士之路 Node.js 基礎學習-會員機制(3)","2019-07-08 10:12:15",[12,13],"上一章節已經大致上介紹登入時要使用哪個 API，後面就介紹了一下加入 Flash 及 欄位擴充，這章節就來認真講一下登入相關","2",{"url":24,"title":25,"date":26,"updated":3,"category":10,"tags":27,"description":28,"readingMinutes":29},"\u002Fnodejs\u002F20190707\u002F3130637449\u002F","全端勇士之路 Node.js 基礎學習-會員機制(2)","2019-07-07 20:46:58",[12,13],"在前面已經製作完註冊帳號得邏輯功能，所以接下來就是要做登入得功能","3",{"url":31,"title":32,"date":33,"updated":3,"category":10,"tags":34,"description":35,"readingMinutes":36},"\u002Fnodejs\u002F20190707\u002F2444554058\u002F","全端勇士之路 Node.js 基礎學習-會員機制(1)","2019-07-07 11:18:03",[12,13],"接下來將會來講如何設置會員機制，但是這邊將會使用到的是 firebase 的會員驗證機制","4",{"url":38,"title":39,"date":40,"updated":3,"category":10,"tags":41,"description":43,"readingMinutes":15},"\u002Fnodejs\u002F20190704\u002F184223391\u002F","解決使用 nodemailer 一直出現 Error: Invalid login: 534-5.7.14 問題","2019-07-04 22:30:43",[12,42],"障礙排除","在實作 Nodejs 使用 nodemailer 的時候一直跳 Invalid login 534-5.7.14，所以這邊紀錄一下該如何解決",{"url":45,"title":46,"date":47,"updated":3,"category":10,"tags":48,"description":49,"readingMinutes":22},"\u002Fnodejs\u002F20190704\u002F3969699783\u002F","全端勇士之路 Node.js 基礎學習-實作發送電子郵件並且部屬 HeroKu(3)","2019-07-04 21:42:22",[12,13],"接下來就是準備將自己寫好的發送信件應用部屬到 Heroku 囉",{"url":51,"title":52,"date":5