[{"data":1,"prerenderedAt":121},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F27\u002F":3,"archive-page:zh-Hant:27":4,"author-stats:zh-Hant:full":119},null,{"posts":5,"total":117,"totalPages":118},[6,22,35,52,65,71,82,88,104,110],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":20,"readingMinutes":21},"\u002Fother\u002F20221213\u002F3036227586\u002F","關於從 Heroku 跳到 Render 這件事情","2022-12-13 09:59:23","2023-02-13 15:30:00","雜談",[13,14,15,16,17,18,19],"Heroku","Render","PaaS","免費方案","部署","GitHub","Git","Heroku 一直以來是我滿愛用的後端平台，可是 Heroku 在 2022\u002F11\u002F28 停止了免費方案，因此不得不將網站從 Heroku 轉移到他處，所以這一篇將會介紹一下如何轉到 Render.com 以及為什麼選擇了 Render。","6",{"url":23,"title":24,"date":25,"updated":25,"category":26,"tags":27,"description":33,"readingMinutes":34},"\u002Fgsap\u002F20221211\u002F2330475296\u002F","(8)前端好好玩用 GSAP 做一個特效 - 特殊屬性","2022-12-11 22:25:20","GSAP",[26,28,29,30,31,32],"GSAP3","Green Sock Animation Platform","GSAP3 入門","GSAP3 基礎","GSAP3 動畫","前面有提到 GSAP 基本上可以替你想得到的 CSS 屬性做動畫效果之外，其實還有一些特殊屬性可以使用，所以這一篇就來講一下 GSAP 的特殊屬性。","2",{"url":36,"title":37,"date":38,"updated":39,"category":40,"tags":41,"description":50,"readingMinutes":51},"\u002Fnodejs\u002F20221210\u002F1224824056\u002F","用 Node.js 建立你的第一個 LINE Bot 聊天機器人以 OpenAI GPT-3 與 GPT-3.5 為例","2022-12-10 17:12:11","2023-03-06 15:30:00","Nodejs",[42,43,44,45,46,47,48,49,14],"OpenAI","ChatGPT","GPT-3","GPT-3.5","LINE Bot","LiNE","Node.js","API","最近 OpenAI 的 ChatGPT 非常的火紅，剛好這個 OpenAI 是有提供 API 可以串接的，雖然是以 GPT-3 為主軸，但是後面我也有分享如何轉換到 ChatGPT API，所以這一篇我就來介紹如何使用 Node.js 基於 OpenAI 的 API 來建立一個 Line 聊天機器人吧！","11",{"url":53,"title":54,"date":55,"updated":10,"category":11,"tags":56,"description":63,"readingMinutes":64},"\u002Fother\u002F20221206\u002F2011045213\u002F","從零開始教你買網址(Google Domain)到設定成自己部落格網址","2022-12-06 14:15:01",[57,58,59,60,61,62],"Google Domain","Cloudflare","GitHub Pages","GitLab Pages","Domain","網址","滿多人都會架設自己的技術部落格並放置在 GitHub Pages、GitLab Pages 上，然後也會想要客製化自己的部落格網址，所以這一篇將會介紹如何客製化自己部落格網址，然後從零開始購買網址，一路到將原本 GitHub Pages 網址替換成自己購買的網址並搭上免費的 SSH CloudFlare！","7",{"url":66,"title":67,"date":68,"updated":68,"category":26,"tags":69,"description":70,"readingMinutes":34},"\u002Fgsap\u002F20221205\u002F1185711476\u002F","(7)前端好好玩用 GSAP 做一個特效 - 座標軸","2022-12-05 21:36:14",[26,28,29,30,31,32],"接下來我們要來認識一個製作動畫時，非常重要的觀念，座標軸。",{"url":72,"title":73,"date":74,"updated":74,"category":75,"tags":76,"description":80,"readingMinutes":81},"\u002Fvue\u002F20221202\u002F2131448011\u002F","解決 Vue 渲染太慢而導致看到 Mustache (雙花括號)的問題","2022-12-02 16:38:17","Vue",[77,75,78,79],"障礙排除","Mustache","雙花括號","有時候我們會因為網路太慢導致 Vue 的渲染速度太慢，而導致看到 Mustache (雙花括號)的問題，這個狀況其實並不是很好看，所以這一篇就記錄一下如何解決吧。","3",{"url":83,"title":84,"date":85,"updated":85,"category":26,"tags":86,"description":87,"readingMinutes":34},"\u002Fgsap\u002F20221202\u002F4194819972\u002F","(6)前端好好玩用 GSAP 做一個特效 - 自訂屬性","2022-12-02 16:16:00",[26,28,29,30,31,32],"前一章節認識了動畫屬性中的 CSS 屬性，接著這一篇將會認識動畫屬性中的自訂屬性。",{"url":89,"title":90,"date":91,"updated":92,"category":40,"tags":93,"description":103,"readingMinutes":81},"\u002Fnodejs\u002F20221127\u002F2847196536\u002F","一個 antfu\u002Fni 搞定安裝？！用 antfu\u002Fni 來取代你的 npm\u002Fyarn\u002Fpnpm\u002Fbun 吧！","2022-11-27 20:31:42","2025-04-07 14:03:27",[94,95,96,97,98,99,100,101,102],"antfu\u002Fni","ni","npm","yarn","node","pnpm","bun","套件管理","套件安裝管理器","你有想過一個問題嗎？每次拿到別人開發的新專案時，到底要輸入 npm install 還是 yarn install 呢？是不是覺得套件管理安裝器超級無敵多，每次都要打開專案看才能夠知道要用哪一個呢？所以這一篇我將會介紹一個很特別的套件安裝管理器，也就是 ni。",{"url":105,"title":106,"date":107,"updated":107,"category":26,"tags":108,"description":109,"readingMinutes":34},"\u002Fgsap\u002F20221127\u002F1252086867\u002F","(5)前端好好玩用 GSAP 做一個特效 - 動畫屬性","2022-11-27 19:54:52",[26,28,29,30,31,32],"接著我們要來認識一下關於 GSAP 可以使用的動畫屬性。",{"url":111,"title":112,"date":113,"updated":113,"category":26,"tags":114,"description":115,"readingMinutes":116},"\u002Fgsap\u002F20221125\u002F4035442226\u002F","(4)前端好好玩用 GSAP 做一個特效 - 選取目標","2022-11-25 22:25:00",[26,28,29,30,31,32],"上一篇我們認識到了基本的動畫設定與語法，接下來這一篇將會針對選取目標來介紹。","1",1044,105,{"postCount":117,"tagCount":120},1034,1789747445811]