[{"data":1,"prerenderedAt":116},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F8\u002F":3,"archive-page:zh-Hant:8":4,"author-stats:zh-Hant:full":114},null,{"posts":5,"total":112,"totalPages":113},[6,21,33,40,50,61,71,82,92,102],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":19,"readingMinutes":20},"\u002Fai\u002F20251112\u002F978259833\u002F","生成式人工智慧與機器學習導論（2） - AI Agent 背後的關鍵技術 Context Engineering","2025-11-12 00:51:29","AI",[12,13,14,15,16,17,18],"生成式 AI","李宏毅","大語言模型","ChatGPT 原理","LLM 教學","AI 幻覺","Context Engineering","現在的各種 AI 應用，基本上都跟 Prompt Engineering （提示工程）以及 Context Engineering （上下文工程）息息相關，那這兩者有何者差異以及關係呢？這一篇就來了解這兩個概念有多影響 AI Agent 的運作。","17",{"url":22,"title":23,"date":24,"updated":25,"category":26,"tags":27,"description":31,"readingMinutes":32},"\u002Fvue\u002F20251106\u002F1172686218\u002F","用 &lt;spec lang=\"md\"&gt; 標籤在 Vue 中舒服的使用 SFC 搭配 AI 開發","2025-11-06 13:45:34","2026-04-23 13:45:34","Vue",[26,28,29,30],"SFC","AI 開發","規格驅動開發","許多開發者都會搭配著 AI 工具（Claude Code、Gemini、Copilot 等）來協助撰寫程式碼，而在 Vue 的單檔元件（Single File Component, SFC）中，常常會遇到一些困擾，所以這邊就來分享一個不同的做法，也就是自訂一個 &lt;spec lang=\"md\"&gt; 標籤，來讓我們能夠在 SFC 中更舒服地使用 AI 工具來開發。","6",{"url":34,"title":35,"date":36,"updated":36,"category":10,"tags":37,"description":38,"readingMinutes":39},"\u002Fai\u002F20251102\u002F2069630219\u002F","生成式人工智慧與機器學習導論（1） - 其實都是文字接龍","2025-11-02 04:39:25",[12,13,14,15,16,17,18],"這幾年來 AI 技術發展非常快速，已經到達了連普通人都可以指揮 AI 幫忙做事的地步，尤其是大家所熟悉的 Vibe Coding 就是一個很好的例子，剛好台大的李宏毅老師在 2025 年開辦了一堂生成式 AI 與機器學習課程，就來寫一下這堂課的記錄跟心得吧～","8",{"url":41,"title":42,"date":43,"updated":44,"category":45,"tags":46,"description":48,"readingMinutes":49},"\u002Flearnexp\u002F20250930\u002F2883140524\u002F","【Day 30】目錄","2025-09-30 00:00:00","2026-05-07 21:00:00","學習經驗",[47],"Code Review 我的青春：從『嗶』聲開啟我的軟體工程師之路","系列總覽：30 天鐵人賽完整記錄，從電腦基礎、網路協定、程式語言、前端框架到職涯發展，時間軸與主題分類雙版本，幫助快速學習與查找。","4",{"url":51,"title":52,"date":53,"updated":44,"category":45,"tags":54,"description":59,"readingMinutes":60},"\u002Flearnexp\u002F20250929\u002F4192339363\u002F","【Day 29】十年工程師之路","2025-09-29 00:00:00",[47,55,56,57,58],"工程師十年歷程","AI時代程式員","技術職涯破版","程式學習心得","從「嗶」聲到十年：被遊戲點燃、被前端折磨、靠寫文成長、最後和 AI 共舞 —— 一路跌跌撞撞的工程師成長紀錄。","3",{"url":62,"title":63,"date":64,"updated":44,"category":45,"tags":65,"description":70,"readingMinutes":32},"\u002Flearnexp\u002F20250928\u002F1706365915\u002F","【Day 28】每一個學生的問題，都是我成長的修羅場","2025-09-28 00:00:00",[47,66,67,68,69],"課程助教經驗","CSS 網頁相容性","前端面試技巧","程式學習方法","問題不是阻力而是槓桿：每次回覆學生，都在修 CSS 相容、練 JS 輸出、補軟實力與面試力，理想與現實在修羅場裡對齊。",{"url":72,"title":73,"date":74,"updated":44,"category":45,"tags":75,"description":80,"readingMinutes":81},"\u002Flearnexp\u002F20250927\u002F1706365915\u002F","【Day 27】爽爽放連假的期間，我收到了資遣通知~","2025-09-27 00:00:00",[47,76,77,78,79],"工程師裁員經驗","Vue.js 學習歷程","面試技巧分享","技術框架比較","被裁之後我把技能樹點滿：Vue 寫電商、面試被問爆直譯\u002F編譯與框架\u002F函式庫，最後懂了——JS 基礎才是萬用被動技。","5",{"url":83,"title":84,"date":85,"updated":44,"category":45,"tags":86,"description":91,"readingMinutes":81},"\u002Flearnexp\u002F20250926\u002F1972102857\u002F","【Day 26】就這樣我被迫轉職成前端工程師了","2025-09-26 00:00:01",[47,87,88,89,90],"前端工程師轉職","JavaScript 學習心得","網頁切版技巧","被迫轉職經驗","會切版就等於會前端？等等別急——從被迫轉職到真香現場：HTML 骨架、CSS 外觀、JS 神經，讓靜態頁面活起來。",{"url":93,"title":94,"date":95,"updated":44,"category":45,"tags":96,"description":101,"readingMinutes":39},"\u002Flearnexp\u002F20250925\u002F228905455\u002F","【Day 25】為什麼我莫名其妙變成了寫 HTML 跟 CSS 的人？","2025-09-25 00:00:01",[47,97,98,99,100],"HTML CSS 入門","網頁前端開發","響應式網頁設計","無名小站回憶","莫名被指派切版的生存筆記：用故事帶你補齊 HTML 語意與結構、空元素與自閉合差異，並掌握 CSS 佈局與響應式核心，避開初學者最容易忽略的相容性地雷。",{"url":103,"title":104,"date":105,"updated":44,"category":45,"tags":106,"description":111,"readingMinutes":81},"\u002Flearnexp\u002F20250924\u002F2137873228\u002F","【Day 24】資安攻防戰","2025-09-24 00:00:01",[47,107,108,109,110],"網站資安防護","SQL 注入攻擊防範","WannaCry 病毒分析","系統漏洞修補","專題發表看似順利，回頭一檢卻是蜂巢滿洞：從老師提醒到實際踩雷，談 WannaCry、備份策略、SQL 注入與欄位長度 DoS 的血淚教訓。",1048,105,{"postCount":112,"tagCount":115},1047,1790132714476]