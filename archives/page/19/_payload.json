[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F19\u002F":3,"archive-page:zh-Hant:19":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,16,23,30,37,43,49,55,66,72],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20230928\u002F2824059455\u002F","Day14 - 網頁爬蟲？","2023-09-28 00:00:01","Nodejs",[12,13],"Node.js","《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","這一篇基本上我打算輕鬆一點介紹爬蟲就好，所以這一篇的篇幅或許會比以往前面少很多，主要也是讓大腦可以輕鬆一點。","3",{"url":17,"title":18,"date":19,"updated":19,"category":10,"tags":20,"description":21,"readingMinutes":22},"\u002Fnodejs\u002F20230927\u002F4133508926\u002F","Day13 - 替你的 Express 戴上頭盔吧！","2023-09-27 00:00:01",[12,13],"前面介紹了 CORS 跟 Env 可以說是基本的基本，接下來要來介紹一個很特別的東西，叫做 Helmet。","4",{"url":24,"title":25,"date":26,"updated":26,"category":10,"tags":27,"description":28,"readingMinutes":29},"\u002Fnodejs\u002F20230926\u002F1829302614\u002F","Day12 - 關於 CORS 與 Env","2023-09-26 00:00:01",[12,13],"前一篇我們完成了 Express + Mongoose 的整合，接下來我們要來處理一些環境變數的問題，以及 CORS 的問題。","6",{"url":31,"title":32,"date":33,"updated":33,"category":10,"tags":34,"description":35,"readingMinutes":36},"\u002Fnodejs\u002F20230925\u002F3347882734\u002F","Day11 - Express 與 Mongoose","2023-09-25 00:00:01",[12,13],"在上一篇文章中，我們初步建立了 MongoDB Atlas 的帳號，並且快速認識了 Mongoose，接下來當然就是要來整合再一起啦～","5",{"url":38,"title":39,"date":40,"updated":40,"category":10,"tags":41,"description":42,"readingMinutes":36},"\u002Fnodejs\u002F20230924\u002F3283299199\u002F","Day10 - MongoDB 與 Mongoose","2023-09-24 00:00:01",[12,13],"前一篇我們初步對於資料庫有了一點概念後，接下來當然要進入資料庫章節啦～",{"url":44,"title":45,"date":46,"updated":46,"category":10,"tags":47,"description":48,"readingMinutes":36},"\u002Fnodejs\u002F20230923\u002F264010765\u002F","Day9 - What is a database？","2023-09-23 00:00:01",[12,13],"對於一個網站或者服務來講，資料庫是不可或缺的一個元素，那麼什麼是資料庫呢？接下來我們就來聊聊什麼是資料庫。",{"url":50,"title":51,"date":52,"updated":52,"category":10,"tags":53,"description":54,"readingMinutes":29},"\u002Fnodejs\u002F20230922\u002F299784561\u002F","Day8 - 再續 Express.js","2023-09-22 00:00:01",[12,13],"前面我們介紹了 Express 以及 Middleware 的概念，這一篇我們將會繼續介紹 Express.js。",{"url":56,"title":57,"date":58,"updated":58,"category":59,"tags":60,"description":64,"readingMinutes":65},"\u002Fvscode\u002F20230921\u002F1985180173\u002F","Visual Studio Code 自訂折疊區塊","2023-09-21 09:43:55","VSCode",[59,61,62,63],"實用設定","Setting","開發","VSCode 預設可以折疊函式但不能自訂區塊？其實只要用 #region 跟 #endregion 包住程式碼就能自訂折疊範圍，這一篇示範這個少人知道但相當實用的小技巧。","2",{"url":67,"title":68,"date":69,"updated":69,"category":10,"tags":70,"description":71,"readingMinutes":29},"\u002Fnodejs\u002F20230921\u002F766511846\u002F","Day7 - Web Framework to Express.js","2023-09-21 00:00:01",[12,13],"前一篇我們嘗試用 Node.js 建立了 HTTP API，我相信你應該學到相當的多，但是實戰上來講，我們並不會直接使用 Node.js 來建立 HTTP API，因為這樣會太麻煩了，因此我們會使用一些框架來幫助我們建立 HTTP API，而這邊我們就來介紹一個非常熱門的框架，也就是 Express.js。",{"url":73,"title":74,"date":75,"updated":75,"category":10,"tags":76,"description":77,"readingMinutes":78},"\u002Fnodejs\u002F20230920\u002F2057349059\u002F","Day6 - 建立 HTTP API","2023-09-20 00:00:01",[12,13],"接下來這一篇我們將會來嘗試用純 Node.js 建立 HTTP API，基本上會使用到前面的知識點，所以前面的許多知識點都非常的重要唷～","8",1048,105,{"postCount":79,"tagCount":82},1047,1790132712992]