[{"data":1,"prerenderedAt":100},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F17\u002F":3,"archive-page:zh-Hant:17":4,"author-stats:zh-Hant:full":98},null,{"posts":5,"total":96,"totalPages":97},[6,18,30,38,52,61,70,78,85,90],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":16,"readingMinutes":17},"\u002Fjavascript\u002F20231031\u002F1586150719\u002F","Prettier 教學：你終究要用，為什麼不一開始就用？（VSCode 設定完整指南）","2023-10-31 10:33:52","2026-05-12 09:00:00","JavaScript",[11,13,14,15],"Prettier","ESLint","VSCode","在我們前端開發中，有一個非常重要的工具你一定要會用，也就是 Prettier，就算你現在不用，未來你也一定會用到，那為什麼不一開始就用「Prettier」呢？所以這一篇就來介紹如何使用 Prettier 吧！","5",{"url":19,"title":20,"date":21,"updated":21,"category":22,"tags":23,"description":28,"readingMinutes":29},"\u002Fother\u002F20231029\u002F4161770695\u002F","首頁總是不更新，關於被 Service Workers 雷的這件事","2023-10-29 00:12:47","雜談",[24,25,26,27],"Service Workers","PWA","障礙排除","Progressive Web Apps","最近發現部落格總是不更新，經過一番查找，發現是 Service Workers 的關係，這篇文章就來記錄一下。","2",{"url":31,"title":32,"date":33,"updated":33,"category":15,"tags":34,"description":36,"readingMinutes":37},"\u002Fvscode\u002F20231026\u002F54606935\u002F","VSCode 上 Vue 自訂元件失去高亮","2023-10-26 11:03:07",[26,15,35],"Vue","最近開發發現 Volar 的自訂元件高亮功能好像怪怪的，所以記錄一下原因。","1",{"url":39,"title":40,"date":41,"updated":41,"category":42,"tags":43,"description":50,"readingMinutes":51},"\u002Fnodejs\u002F20231024\u002F1839693229\u002F","Mac 開啟專案時，自動使用 nvm use 切換到專案的 Node 版本","2023-10-24 16:00:52","Nodejs",[44,45,46,47,48,49],"Node.js","nvm","zsh","oh-my-zsh","zsh-nvm","Powerlevel10k","身為一名 Node.js 相關的開發者，常常會遇到需要切換 Node.js 版本的情況，但是我們每個專案所使用的 Node.js 都不同，因此就很容易忘記切換版本，所以這一篇就要來記錄一下如何在 Mac 上開啟專案時，就自動使用 nvm 切換 Node 版本。","4",{"url":53,"title":54,"date":55,"updated":55,"category":56,"tags":57,"description":59,"readingMinutes":60},"\u002Fnuxt\u002F20231023\u002F2419347402\u002F","Nuxt3 綁定表單後無限觸發 API","2023-10-23 17:04:45","Nuxt",[58,56,26],"Nuxt3","最近在開發 Nuxt3 的時候踩到一個 useFetch 的雷，剛好這個雷好像滿多朋友都有踩到，所以就順便記錄一下。","3",{"url":62,"title":63,"date":64,"updated":64,"category":22,"tags":65,"description":69,"readingMinutes":17},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31",[66,67,68],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。",{"url":71,"title":72,"date":73,"updated":73,"category":11,"tags":74,"description":76,"readingMinutes":77},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58",[11,75],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":79,"title":80,"date":81,"updated":81,"category":42,"tags":82,"description":84,"readingMinutes":60},"\u002Fnodejs\u002F20231015\u002F3466588754\u002F","Day31 - 目錄與補充資源","2023-10-15 00:00:01",[44,83],"《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","今天打算做一個總結了，所以這一篇主要就以回顧的方式來做一個總結哩～",{"url":86,"title":87,"date":88,"updated":88,"category":42,"tags":89,"description":84,"readingMinutes":29},"\u002Fnodejs\u002F20231014\u002F27552363\u002F","Day30-旅途告一個段落","2023-10-14 00:00:01",[44,83],{"url":91,"title":92,"date":93,"updated":93,"category":42,"tags":94,"description":95,"readingMinutes":17},"\u002Fnodejs\u002F20231013\u002F3280561145\u002F","Day29-關於 JWT 驗證","2023-10-13 00:00:01",[44,83],"接下來這一篇將會來介紹 JWT 的驗證，畢竟前面一直都沒提到，可是實戰上來講卻是非常重要的一環哩。",1052,106,{"postCount":96,"tagCount":99},1059,1790438619842]