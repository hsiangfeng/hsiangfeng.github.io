[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F17\u002F":3,"archive-page:zh-Hant:17":4,"author-stats:zh-Hant:full":92},null,{"posts":5,"total":90,"totalPages":91},[6,16,30,39,50,59,66,72,78,84],{"url":7,"title":8,"date":9,"updated":9,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fvscode\u002F20231026\u002F54606935\u002F","VSCode 上 Vue 自訂元件失去高亮","2023-10-26 11:03:07","VSCode",[12,10,13],"障礙排除","Vue","最近開發發現 Volar 的自訂元件高亮功能好像怪怪的，所以記錄一下原因。","1",{"url":17,"title":18,"date":19,"updated":19,"category":20,"tags":21,"description":28,"readingMinutes":29},"\u002Fnodejs\u002F20231024\u002F1839693229\u002F","Mac 開啟專案時，自動使用 nvm use 切換到專案的 Node 版本","2023-10-24 16:00:52","Nodejs",[22,23,24,25,26,27],"Node.js","nvm","zsh","oh-my-zsh","zsh-nvm","Powerlevel10k","身為一名 Node.js 相關的開發者，常常會遇到需要切換 Node.js 版本的情況，但是我們每個專案所使用的 Node.js 都不同，因此就很容易忘記切換版本，所以這一篇就要來記錄一下如何在 Mac 上開啟專案時，就自動使用 nvm 切換 Node 版本。","4",{"url":31,"title":32,"date":33,"updated":33,"category":34,"tags":35,"description":37,"readingMinutes":38},"\u002Fnuxt\u002F20231023\u002F2419347402\u002F","Nuxt3 綁定表單後無限觸發 API","2023-10-23 17:04:45","Nuxt",[36,34,12],"Nuxt3","最近在開發 Nuxt3 的時候踩到一個 useFetch 的雷，剛好這個雷好像滿多朋友都有踩到，所以就順便記錄一下。","3",{"url":40,"title":41,"date":42,"updated":42,"category":43,"tags":44,"description":48,"readingMinutes":49},"\u002Fother\u002F20231022\u002F2787463355\u002F","加密是什麼呢？為什麼要加密？關於加密的基本觀念","2023-10-22 17:39:31","雜談",[45,46,47],"加密","密碼學","非對稱式加密","什麼是加密呢？這是一個很有趣的議題，剛好前陣子發生了一點事情，所以就順勢生這一篇文章，就讓我們來聊一下何謂加密。","5",{"url":51,"title":52,"date":53,"updated":53,"category":54,"tags":55,"description":57,"readingMinutes":58},"\u002Fjavascript\u002F20231021\u002F985189338\u002F","關於封裝 localStorage 的小技巧","2023-10-21 12:58:58","JavaScript",[54,56],"localStorage","在開發網頁時，常常會需要使用到 localStorage 來儲存資料，但是 localStorage 本身的 API 並不是很好用，所以我們可以透過封裝的方式來讓它更好用。","6",{"url":60,"title":61,"date":62,"updated":62,"category":20,"tags":63,"description":65,"readingMinutes":38},