[{"data":1,"prerenderedAt":80},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F104\u002F":3,"archive-page:zh-Hant:104":4,"author-stats:zh-Hant:full":78},null,{"posts":5,"total":76,"totalPages":77},[6,14,21,29,35,41,48,55,62,68],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":12,"readingMinutes":13},"\u002Fjavascript\u002F20190424\u002F2772517253\u002F","JavaScript奇妙的題目","2019-04-24 20:41:32","JavaScript",[10],"JavaScript 在很多地方都非常的奇妙又好玩，過陣子也準備進入 js 奇妙的章節...先來做一下記錄前陣子在學院中人家的 js 問題。","2",{"url":15,"title":16,"date":17,"updated":3,"category":10,"tags":18,"description":19,"readingMinutes":20},"\u002Fjavascript\u002F20190421\u002F1216566123\u002F","關於 JavaScript 陣列 20 種操作的方法","2019-04-21 11:56:53",[10],"這篇文章主要是觀看了偷米騎巴哥]操作JS陣列的20種方式而撰寫的，因為覺得這張圖真的是精華","7",{"url":22,"title":23,"date":24,"updated":3,"category":25,"tags":26,"description":28,"readingMinutes":13},"\u002FSCSS\u002F20190421\u002F968240674\u002F","SCSS學習-mixin(五)","2019-04-21 07:24:30","SCSS",[25,27],"SCSS 學習手冊","前一篇主要講解 @import 使用方式，這篇會慢慢結合前面所寫的教學來統整製作，接下來將會講解 mixin，mixin 又是什麼呢?我會把它當作一個 SCSS 資料庫，因為這裡面會放很多自己常用的 SCSS",{"url":30,"title":31,"date":32,"updated":3,"category":10,"tags":33,"description":34,"readingMinutes":13},"\u002Fjavascript\u002F20190419\u002F3635730318\u002F","Javascript中的hoisting","2019-04-19 20:33:08",[10],"今天參加了六角學院 JavaScript 線上問答時，發現自己對於這個觀念上有些地方不太正確，所以寫一下做紀錄。",{"url":36,"title":37,"date":38,"updated":3,"category":25,"tags":39,"description":40,"readingMinutes":13},"\u002FSCSS\u002F20190419\u002F947541843\u002F","SCSS學習-import(四)","2019-04-19 17:24:30",[25,27],"SCSS 中有提供一個 @import 功能，如果使用的妥當就可以開發上管理的方便。",{"url":42,"title":43,"date":44,"updated":3,"category":10,"tags":45,"description":46,"readingMinutes":47},"\u002Fjavascript\u002F20190418\u002F1842588803\u002F","關於this是一個很神奇的東西這件事情","2019-04-18 19:46:16",[10],"我學習 JavaScript 中令我感到最痛苦最煩惱的其中一個東西就是 this，所以這邊就針對 this 來做一下紀錄學習。","5",{"url":49,"title":50,"date":51,"updated":3,"category":25,"tags":52,"description":53,"readingMinutes":54},"\u002FSCSS\u002F20190418\u002F2434021097\u002F","SCSS學習-運算子(三)","2019-04-18 17:24:30",[25,27],"預算子?加減乘除嗎? CSS 中也有提供運算子的功能，所謂的運算子就是 加(+)、 減(-)、 乘(*)、 除(\u002F)。","1",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":60,"readingMinutes":61},"\u002Fjavascript\u002F20190418\u002F3212024334\u002F","JavaScript陣列物件屬性合併","2019-04-18 16:00:00",[10],"昨天有一位大大丟了一個 JavaScript 問題和我一起討論，他提供了一個陣列物件給我研究看看，沒想到看似這麼簡單的東西做起來這麼麻煩，還因此耗了我大概 3~4 小時左右的時間，功力果然不夠阿~~~~~","3",{"url":63,"title":64,"date":65,"updated":3,"category":25,"tags":66,"description":67,"readingMinutes":13},"\u002FSCSS\u002F20190417\u002F2961076508\u002F","SCSS學習-變數($)(二)","2019-04-17 12:45:50",[25,27],"從這篇開始就不會講到 SASS，讓我們來專心地了解一下如何基礎學會 SCSS。",{"url":69,"title":70,"date":71,"updated":71,"category":72,"tags":73,"description":75,"readingMinutes":47},"\u002Flearnexp\u002F20190416\u002F3782185665\u002F","該如何正確的學習前端技術或程式語言","2019-04-16 22:36:38","學習經驗",[74,72],"其他","先講講為什麼我會寫這一篇文章，自從加入六角學院轉行走前端工程師，陸陸續續都有朋友、網友及同學等都來請教該如何像我一樣學習前端技術，我思考了好一陣子才決定寫這一篇文章作為經驗分享。",1048,105,{"postCount":76,"tagCount":79},1047,1790132712708]