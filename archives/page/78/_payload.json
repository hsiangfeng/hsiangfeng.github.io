[{"data":1,"prerenderedAt":87},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F78\u002F":3,"archive-page:zh-Hant:78":4,"author-stats:zh-Hant:full":85},null,{"posts":5,"total":83,"totalPages":84},[6,18,25,31,37,46,56,64,71,77],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fphp\u002F20190905\u002F1275666548\u002F","Day4-從基礎學習 ThinkPHP-基礎 MySQL 學習-資料篇(1)","2019-09-05 00:02:55","PHP",[10,12,13,14,15],"MySQL","ThinkPHP 5.1","從基礎學習 ThinkPHP","第 11 屆 iT邦幫忙鐵人賽","前一篇我們已經學會基礎的資料表操作，那麼這一篇就會針對資料欄位的資料操作來做介紹，但是在前面我們要先了解一些觀念，而這觀念將會幫助我們理解對於後面的動作操作。","3",{"url":19,"title":20,"date":21,"updated":3,"category":10,"tags":22,"description":23,"readingMinutes":24},"\u002Fphp\u002F20190904\u002F1799668484\u002F","Day3-從基礎學習 ThinkPHP-基礎 MySQL 學習-資料表篇","2019-09-04 09:02:58",[10,12,13,14,15],"前一篇我們已經學習了基礎的資料庫操作，但是資料庫底下還有一個東西叫做資料表，而資料表就是存放資料的地方，你可以把它想像成表格或是筆記本概念，所以這一篇就要來學習資料表的基礎 SQL 指令操作。","4",{"url":26,"title":27,"date":28,"updated":3,"category":10,"tags":29,"description":30,"readingMinutes":17},"\u002Fphp\u002F20190903\u002F2318537651\u002F","Day2-從基礎學習 ThinkPHP-基礎 MySQL 學習-資料庫篇","2019-09-03 08:35:58",[10,12,13,14,15],"歡迎來到 ThinkPHP 系列的第一篇勇者大人，首先第一篇至第四篇我們將會學習基礎的 SQL 操作與指令，等到我們學習完這些基礎的指令操作後，就開始正式進入 ThinkPHP，所以就讓我們來開始學習吧!",{"url":32,"title":33,"date":34,"updated":3,"category":10,"tags":35,"description":36,"readingMinutes":17},"\u002Fphp\u002F20190902\u002F536097622\u002F","Day1-從基礎學習 ThinkPHP-介紹","2019-09-02 11:28:58",[10,12,13,14,15],"ThinkPHP 算是比較少見的框架，我會挑選 ThinkPHP 當作是一個挑戰是因為先前有寫過(被打)，但是當時寫的版本是 3.2.4，而目前版本是 5.1，這段過程 ThinkPHP 其實有非常大的改變，光系統架構上就差非常多，那麼廢話就不多說讓我們從基礎來學習 ThinkPHP 5.1 吧!",{"url":38,"title":39,"date":40,"updated":3,"category":41,"tags":42,"description":45,"readingMinutes":24},"\u002Fother\u002F20190828\u002F2944044939\u002F","Slack 基礎操作","2019-08-28 08:52:12","雜談",[43,44],"Slack","軟體操作","這一篇來記錄一下 Slack 的基礎操作與介紹，最主要 Slack 是滿多公司很常使用的溝通工具。",{"url":47,"title":48,"date":49,"updated":3,"category":50,"tags":51,"description":54,"readingMinutes":55},"\u002Fvue\u002F20190821\u002F2073039643\u002F","Nuxt 出現 window or document undefined(window is not defined)","2019-08-21 11:23:55","Vue",[50,52,53],"Nuxt","障礙排除","最近開發 Nuxt.js 在引入套件的時候發生 window is not defined 的錯誤訊息，所以這一篇來記錄一下該如何解決","1",{"url":57,"title":58,"date":59,"updated":3,"category":60,"tags":61,"description":63,"readingMinutes":55},"\u002Fhexo\u002F20190817\u002F3015878257\u002F","替 Hexo NexT 增加字數統計","2019-08-17 21:51:19","Hexo",[60,62],"NexT","有時候自己會需要翻一下自己某一篇文章寫得字數以及大約閱讀所需要的時間，所以這一篇就來記錄一下該如何替 Hexo NexT 安裝字數統計以及閱讀時間吧",{"url":65,"title":66,"date":67,"updated":3,"category":50,"tags":68,"description":69,"readingMinutes":70},"\u002Fvue\u002F20190816\u002F3627128539\u002F","Nuxt.js 導航守衛","2019-08-16 13:01:13",[50,52],"這一篇將會記錄該如何製作導航守衛，由於一般情況下 Nuxt 做法與在 Vue 下是不同的，所以就記錄一下該如何製作 Nuxt 導航守衛吧","2",{"url":72,"title":73,"date":74,"updated":3,"category":50,"tags":75,"description":76,"readingMinutes":70},"\u002Fvue\u002F20190810\u002F3385236004\u002F","Nuxt Route 設置","2019-08-10 22:29:02",[50,52],"Nuxt 生成 route 的方式比較不太一樣，這邊實作順便記錄一下",{"url":78,"title":79,"date":80,"updated":3,"category":50,"tags":81,"description":82,"readingMinutes":70},"\u002Fvue\u002F20190809\u002F3851611159\u002F","建立一個 NuxtJS 專案吧!","2019-08-09 15:49:13",[50,52],"由於最近在接觸 NuxtJS 的專案，所以這邊紀錄一下該如何起手建立專案",1052,106,{"postCount":83,"tagCount":86},1059,1790438622479]