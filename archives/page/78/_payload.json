[{"data":1,"prerenderedAt":89},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F78\u002F":3,"archive-page:zh-Hant:78":4,"author-stats:zh-Hant:full":87},null,{"posts":5,"total":85,"totalPages":86},[6,15,24,32,39,47,53,62,70,77],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190809\u002F3851611159\u002F","建立一個 NuxtJS 專案吧!","2019-08-09 15:49:13","Vue",[10,12],"Nuxt","由於最近在接觸 NuxtJS 的專案，所以這邊紀錄一下該如何起手建立專案","2",{"url":16,"title":17,"date":18,"updated":18,"category":19,"tags":20,"description":22,"readingMinutes":23},"\u002Flearnexp\u002F20190807\u002F1019052281\u002F","邀請講師的許多不小的小細節","2019-08-07 15:21:42","學習經驗",[21,19],"其他","這一篇主要會記錄關於我邀請講師時，許多細節部分，因為大多時候我們都會忽略這些細節","5",{"url":25,"title":26,"date":27,"updated":3,"category":10,"tags":28,"description":30,"readingMinutes":31},"\u002Fvue\u002F20190804\u002F3203626423\u002F","Vue 出一個女友吧!-前端頁面","2019-08-04 15:27:25",[10,29],"Vue 出一個女友吧","接下來將會開始紀錄前端頁面的開發，先來講講自己的開發習慣","1",{"url":33,"title":34,"date":35,"updated":3,"category":36,"tags":37,"description":38,"readingMinutes":31},"\u002Fcss\u002F20190803\u002F1860685658\u002F","純 CSS 愛心繪畫方式","2019-08-03 16:40:36","CSS",[36],"由於在製作 Vue 出一個女友的練習發現有一個 CSS 不會寫，所以這邊紀錄一下該如何用 CSS 寫出一個愛心~",{"url":40,"title":41,"date":42,"updated":3,"category":43,"tags":44,"description":46,"readingMinutes":31},"\u002Fgit\u002F20190802\u002F1198998279\u002F","GitHub 重新命名分支名稱","2019-08-02 10:52:04","Git",[45,43],"GitHub","有時候我們在開發的時候會遇到需要重新命名 GitHub 分支，但是總不能用刪除分支的方式來做處理，這樣子會導致先前的 commit 紀錄都消失，所以就來記錄一下該如何重新命名分支並 push 到 GitHub 上吧",{"url":48,"title":49,"date":50,"updated":3,"category":10,"tags":51,"description":52,"readingMinutes":31},"\u002Fvue\u002F20190801\u002F1336347183\u002F","Vue 出一個女友吧!-中場休息","2019-08-01 10:54:29",[10,29],"這一篇主要是紀錄目前做了哪些功能，所以並不會有太多技術性的東西",{"url":54,"title":55,"date":56,"updated":3,"category":57,"tags":58,"description":61,"readingMinutes":31},"\u002Fnodejs\u002F20190801\u002F449913843\u002F","無法辨識 'XXX' 詞彙是否為 Cmdlet、函數、指令檔或可執行程式的名稱","2019-08-01 10:28:33","Nodejs",[59,60],"Node.js","障礙排除","Windows PowerShell 突然每個指令都跳「無法辨識 XXX 詞彙是否為 Cmdlet」？這一篇分享我試過移除套件、重裝 Node 都無效之後， 從環境變數 Path 找到的真正解法。",{"url":63,"title":64,"date":65,"updated":3,"category":66,"tags":67,"description":69,"readingMinutes":31},"\u002Fphp\u002F20190731\u002F2973745480\u002F","Laravel-Vue ESLint 在 VSCode 上無法靜態使用的問題","2019-07-31 14:49:14","PHP",[66,10,68,60],"Laravel","由於最近專案開發上會使用到 Laravel-Vue，本身自己也會使用 ESLint 來管制自己得程式碼品質，但是不知道為什麼不管怎麼甚至就是沒有反應，所以這一篇來記錄一下怎麼解決",{"url":71,"title":72,"date":73,"updated":3,"category":74,"tags":75,"description":76,"readingMinutes":31},"\u002Fhexo\u002F20190730\u002F884035779\u002F","Hexo 指令失效","2019-07-30 11:51:48","Hexo",[74,60],"今天要準備撰寫文章的時候發生一個怪事，也就是 Hexo 的指令失效了，所以這一篇來記錄一下該如何解決",{"url":78,"title":79,"date":80,"updated":3,"category":66,"tags":81,"description":84,"readingMinutes":31},"\u002Fphp\u002F20190729\u002F3880646315\u002F","Composer 安裝","2019-07-29 20:48:44",[82,66,83],"環境安裝","Composer","這一篇來記錄 Composer 如何安裝吧",1043,105,{"postCount":85,"tagCount":88},1032,1789660845885]