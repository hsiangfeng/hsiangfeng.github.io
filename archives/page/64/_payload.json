[{"data":1,"prerenderedAt":94},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F64\u002F":3,"archive-page:zh-Hant:64":4,"author-stats:zh-Hant:full":92},null,{"posts":5,"total":90,"totalPages":91},[6,16,26,36,43,51,59,65,76,84],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fcss\u002F20200523\u002F116058774\u002F","淺談 CSS 設計模式系列-Sass 7-1 Pattern 篇","2020-05-23 21:00:52","CSS",[12,13,10],"CSS 設計模式","7+1 設計模式","7+1 的設計模式主要是在講目錄結構的區分，早期開發 CSS 時只能將所有檔案放在同一個地方，那麼這樣就會導致維護上的困擾，因此在開發 Sass 時就可以搭配 @import 然後使用資料夾區分相關檔案，也就是所謂的 Sass 7-1 Pattern。","2",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":25,"readingMinutes":15},"\u002Fvue\u002F20200522\u002F1986801509\u002F","如何替 Vue Cli 加入 ESLint","2020-05-22 23:48:14","Vue",[22,20,23,24],"JavaScript","Vue Cli","ESLint","實際開發專案時我們為了確保程式碼的品質，通常都會加入程式碼風格管理器，也就是 ESLint，但在 Vue Cli 中該如何正確加入呢？",{"url":27,"title":28,"date":29,"updated":3,"category":22,"tags":30,"description":35,"readingMinutes":15},"\u002Fjavascript\u002F20200518\u002F1745009932\u002F","PixiJS V5 教學 (15) - Bump","2020-05-18 08:20:50",[31,32,22,33,34],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前一篇我們學習如何使用 PIXI 建立幾何圖形，那麼接下來要學習 PIXI 中一個我認為滿特別的東西，也就是碰撞檢測。",{"url":37,"title":38,"date":39,"updated":3,"category":10,"tags":40,"description":42,"readingMinutes":15},"\u002Fcss\u002F20200517\u002F4250484451\u002F","淺談 CSS 設計模式系列-BEM 篇","2020-05-17 15:33:48",[12,41,10],"BEM","BEM 是一個為了讓 class 有更好地維護架構 CSS 設計模式，但最主要的致命缺點就是命名長度過長，可是在實際開發上非常多人都會使用到 BEM。",{"url":44,"title":45,"date":46,"updated":3,"category":10,"tags":47,"description":49,"readingMinutes":50},"\u002Fcss\u002F20200517\u002F168089779\u002F","淺談 CSS 設計模式系列-OOCSS 篇","2020-05-17 12:53:41",[12,48,10],"OOCSS","OOCSS 是 CSS 設計模式的另一種，其中最主要代表的框架就是 Bootstrap。","3",{"url":52,"title":53,"date":54,"updated":3,"category":10,"tags":55,"description":57,"readingMinutes":58},"\u002Fcss\u002F20200516\u002F2341336904\u002F","淺談 CSS 設計模式-SMACSS 篇","2020-05-16 19:59:52",[12,56,10],"SMACSS","CSS 設計模式是一個觀念、規範以及心法，最主要就是要替我們提高開發與維護的效率。","5",{"url":60,"title":61,"date":62,"updated":3,"category":22,"tags":63,"description":64,"readingMinutes":15},"\u002Fjavascript\u002F20200511\u002F1897499725\u002F","PixiJS V5 教學 (14) - Graphics(2)","2020-05-11 07:30:15",[31,32,22,33,34],"前一篇介紹了基本的幾何圖形的繪畫，但是只介紹矩形，其實 PIXI 還有其他幾何圖形的繪畫，所以接下來就來講其他的幾何圖形囉",{"url":66,"title":67,"date":68,"updated":3,"category":69,"tags":70,"description":74,"readingMinutes":75},"\u002Fother\u002F20200510\u002F1067127387\u002F","解決 Windows 上輸入指令出現「因為這個系統上已停用指令碼執行，所以無法載入...」的問題","2020-05-10 22:52:10","雜談",[71,72,73],"Windows","障礙排除","Terminal","Windows PowerShell 跳「因為這個系統上已停用指令碼執行...」？這一篇講 Set-ExecutionPolicy 預設 Restricted 的原因， 整理 AllSigned、Bypass、Unrestricted 各選項差別與最安全的調整指令。","4",{"url":77,"title":78,"date":79,"updated":3,"category":22,"tags":80,"description":83,"readingMinutes":15},"\u002Fjavascript\u002F20200510\u002F2581786882\u002F","JavaScript 核心觀念(7)-執行環境與作用域-not defined VS undefined","2020-05-10 21:27:11",[22,81,82],"JavaScript 核心篇","執行環境與作用域","not defined 以及 undefined 也是 JavaScript 中相當重要的觀念，若可以搞懂這兩者的差異，對於 debug 上是非常有幫助的。",{"url":85,"title":86,"date":87,"updated":3,"category":22,"tags":88,"description":89,"readingMinutes":15},"\u002Fjavascript\u002F20200504\u002F1045961354\u002F","PixiJS V5 教學 (13) - Graphics(1)","2020-05-04 08:10:50",[31,32,22,33,34],"接下來將會來介紹一點使用 PIXI 繪畫幾何圖形，最後會再來試著整合前面的技巧。",1043,105,{"postCount":90,"tagCount":93},1032,1789660845492]