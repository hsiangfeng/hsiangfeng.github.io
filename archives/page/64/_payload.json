[{"data":1,"prerenderedAt":88},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F64\u002F":3,"archive-page:zh-Hant:64":4,"author-stats:zh-Hant:full":86},null,{"posts":5,"total":84,"totalPages":85},[6,16,27,34,42,48,54,63,71,77],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjavascript\u002F20200606\u002F308613948\u002F","JavaScript 核心觀念(10)-執行環境與作用域-課後練習","2020-06-06 22:33:46","JavaScript",[10,12,13],"JavaScript 核心篇","執行環境與作用域","終於來到最後的課後練習，雖然課後練習中絕大部分問題都是我自己出的，但也是很值得回顧的練習，但是這邊會建議不要直接執行程式碼，而是透過觀察畫面來推敲結果答案。","5",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":25,"readingMinutes":26},"\u002Fjavascript\u002F20200601\u002F1513414542\u002F","PixiJS V5 教學 (17) - Text+HP","2020-06-01 08:38:23",[21,22,10,23,24],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","前一篇我們學會如何製作血條，但是文字呢?所以這一篇就來介紹如何補上文字~","1",{"url":28,"title":29,"date":30,"updated":3,"category":10,"tags":31,"description":32,"readingMinutes":33},"\u002Fjavascript\u002F20200531\u002F3571534372\u002F","JavaScript 核心觀念(9)-執行環境與作用域-執行緒與同步、非同步","2020-05-31 22:09:11",[10,12,13],"這個章節開始是 JavaScript 中的重點觀念，也就是常見的 JavaScript 非同步、同步以及單執行緒的問題。","2",{"url":35,"title":36,"date":37,"updated":3,"category":38,"tags":39,"description":40,"readingMinutes":41},"\u002Fvue\u002F20200530\u002F3823952369\u002F","如何在 Vue 建立動態 title","2020-05-30 21:53:33","Vue",[38],"有時候我們在開發系統時，也會希望網頁的 title 隨著頁面變化，例如首頁、關於我們等，那在 SPA 的 Vue 該怎麼做呢？","3",{"url":43,"title":44,"date":45,"updated":3,"category":10,"tags":46,"description":47,"readingMinutes":26},"\u002Fjavascript\u002F20200525\u002F1127214799\u002F","PixiJS V5 教學 (16) - Game HP","2020-05-25 09:00:08",[21,22,10,23,24],"前一篇開始我們開始有那麼一點像是在製作遊戲，所以接下來會來介紹一下遊戲中的血條該如何製作。",{"url":49,"title":50,"date":51,"updated":3,"category":10,"tags":52,"description":53,"readingMinutes":33},"\u002Fjavascript\u002F20200524\u002F995184384\u002F","JavaScript 核心觀念(8)-執行環境與作用域-記憶體存放與釋放","2020-05-24 10:56:06",[10,12,13],"接下來講一下記憶體的回收機制。",{"url":55,"title":56,"date":57,"updated":3,"category":58,"tags":59,"description":62,"readingMinutes":33},"\u002Fcss\u002F20200523\u002F116058774\u002F","淺談 CSS 設計模式系列-Sass 7-1 Pattern 篇","2020-05-23 21:00:52","CSS",[60,61,58],"CSS 設計模式","7+1 設計模式","7+1 的設計模式主要是在講目錄結構的區分，早期開發 CSS 時只能將所有檔案放在同一個地方，那麼這樣就會導致維護上的困擾，因此在開發 Sass 時就可以搭配 @import 然後使用資料夾區分相關檔案，也就是所謂的 Sass 7-1 Pattern。",{"url":64,"title":65,"date":66,"updated":3,"category":38,"tags":67,"description":70,"readingMinutes":33},"\u002Fvue\u002F20200522\u002F1986801509\u002F","如何替 Vue Cli 加入 ESLint","2020-05-22 23:48:14",[10,38,68,69],"Vue Cli","ESLint","實際開發專案時我們為了確保程式碼的品質，通常都會加入程式碼風格管理器，也就是 ESLint，但在 Vue Cli 中該如何正確加入呢？",{"url":72,"title":73,"date":74,"updated":3,"category":10,"tags":75,"description":76,"readingMinutes":33},"\u002Fjavascript\u002F20200518\u002F1745009932\u002F","PixiJS V5 教學 (15) - Bump","2020-05-18 08:20:50",[21,22,10,23,24],"前一篇我們學習如何使用 PIXI 建立幾何圖形，那麼接下來要學習 PIXI 中一個我認為滿特別的東西，也就是碰撞檢測。",{"url":78,"title":79,"date":80,"updated":3,"category":58,"tags":81,"description":83,"readingMinutes":33},"\u002Fcss\u002F20200517\u002F4250484451\u002F","淺談 CSS 設計模式系列-BEM 篇","2020-05-17 15:33:48",[60,82,58],"BEM","BEM 是一個為了讓 class 有更好地維護架構 CSS 設計模式，但最主要的致命缺點就是命名長度過長，可是在實際開發上非常多人都會使用到 BEM。",1049,105,{"postCount":84,"tagCount":87},1050,1790254931564]