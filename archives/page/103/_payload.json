[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F103\u002F":3,"archive-page:zh-Hant:103":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,15,23,32,42,49,55,61,67,73],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fanalytics\u002F20190506\u002F1879363764\u002F","如何使用GA來替自己網站作分析","2019-05-06 15:42:13","Analytics",[10,12],"Hexo","這一篇主要是被朋友推坑下來做撰寫得，所以這邊會介紹該如何埋入 Analytics，就是俗稱得 GA 分析，只要你有自己的網站、部落格，我推薦要使用 GA 分析，這可以讓自己了解到自己那些文章是屬於熱門文章。","2",{"url":16,"title":17,"date":18,"updated":3,"category":19,"tags":20,"description":21,"readingMinutes":22},"\u002Fjavascript\u002F20190505\u002F1432256317\u002F","JavaScript 製作分頁功能(使用 Fetch APIs)","2019-05-05 15:06:43","JavaScript",[19],"開網站會很長需要使用到分頁的功能，有些是在後端處理之後往前端丟，這種通常比較不擔心那麼多，只需要在資料庫做好相關設置就好了，可是如果今天後端將所有資料一次往前端丟那麼就要自己來刻分頁邏輯，所以寫一篇文章加強自己的分頁邏輯撰寫。","7",{"url":24,"title":25,"date":26,"updated":26,"category":27,"tags":28,"description":30,"readingMinutes":31},"\u002Flearnexp\u002F20190503\u002F3738458215\u002F","該如何制定自己的學習","2019-05-03 09:53:55","學習經驗",[29,27],"其他","今天又寫了一篇心得分享，主要原因出在先前所撰寫的三篇文章該如何正確的學習前端技術&程式語言、學習心態調整及你願意犧牲多少來得到你想要的事物，很多人都來詢問該如何學習及撰寫筆記這方面的問題，所以我也寫一下我提供的建議。","6",{"url":33,"title":34,"date":35,"updated":3,"category":36,"tags":37,"description":40,"readingMinutes":41},"\u002Fnodejs\u002F20190503\u002F2483499053\u002F","nodejs出現錯誤代碼500","2019-05-03 09:06:26","Nodejs",[38,39],"Node.js","障礙排除","昨天在弄 nodejs 的時候發生一件很奇妙的事情，前一天使用 ajax 還很正常，昨天突然 ajax 掛掉了...最後今天發現原因紀錄一下自己多白癡。","1",{"url":43,"title":44,"date":45,"updated":45,"category":27,"tags":46,"description":47,"readingMinutes":48},"\u002Flearnexp\u002F20190502\u002F4023370690\u002F","你願意犧牲多少來得到你想要的事物?","2019-05-02 10:24:41",[29,27],"許多時候我們都必須去作出選擇，先前六角學院的廖老師有分享過前端求職履歷面試全攻略的影音心得，其中裡面有講到你願意為了達到目標犧牲多少?","3",{"url":50,"title":51,"date":52,"updated":3,"category":36,"tags":53,"description":54,"readingMinutes":41},"\u002Fnodejs\u002F20190429\u002F1130866276\u002F","nodejs神奇的兩次Request","2019-04-29 20:06:34",[38,39],"由於最近再進修 Nodejs + firebase ，所以也挪不太出時間來寫文章，但是練習 Nodejs 過程中遇到一個很低級&智障問題，結果因此卡了三天，所以這邊做一下紀錄。",{"url":56,"title":57,"date":58,"updated":58,"category":27,"tags":59,"description":60,"readingMinutes":48},"\u002Flearnexp\u002F20190426\u002F43778186\u002F","學習時的心態調整","2019-04-26 15:35:12",[29,27],"最近在幫忙幾位朋友解決學習上的問題時，發現很常出現幾種問題，也跟自己當初的狀況很類似，所以就乾脆寫一下自己的心得分享...",{"url":62,"title":63,"date":64,"updated":3,"category":19,"tags":65,"description":66,"readingMinutes":48},"\u002Fjavascript\u002F20190426\u002F1966510488\u002F","關於 Array.prototype.sort() 排序這件不小的小事","2019-04-26 10:04:22",[19],"先前寫了一篇關於 JavaScript 陣列 20 種操作的方法，其中就有朋友對於 sort() 有點疑問不清楚原理，在被詢問時我自己也突然疑惑了一下，所以決定自己針對 sort() 來做一下研究了解原理。",{"url":68,"title":69,"date":70,"updated":3,"category":36,"tags":71,"description":72,"readingMinutes":14},"\u002Fnodejs\u002F20190425\u002F3663458445\u002F","Express自訂SASS\u002FSCSS路徑","2019-04-25 13:57:16",[38,39],"前面有撰寫一篇如何Nodejs-Express中撰寫SCSS，剛寫完就遇到一個問題...所以這邊果斷再寫一篇該如何自訂 SASS\u002FSCSS 路徑",{"url":74,"title":75,"date":76,"updated":3,"category":36,"tags":77,"description":78,"readingMinutes":41},"\u002Fnodejs\u002F20190425\u002F1258950236\u002F","Nodejs-Express中撰寫SCSS","2019-04-25 12:29:13",[38],"最近正在學習 Nodejs-Express 開發，礙於自己本身所學習是 SCSS 預處理器，可是網路上好像找不到相關解決方式，所以這邊紀錄一下...",1048,105,{"postCount":79,"tagCount":82},1047,1790132712697]