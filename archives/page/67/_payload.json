[{"data":1,"prerenderedAt":87},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F67\u002F":3,"archive-page:zh-Hant:67":4,"author-stats:zh-Hant:full":85},null,{"posts":5,"total":83,"totalPages":84},[6,18,27,35,42,48,54,60,69,76],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fjavascript\u002F20200309\u002F2684951958\u002F","PixiJS V5 教學 (5) - Texture","2020-03-09 08:15:00","JavaScript",[12,13,10,14,15],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","有引入文字那麼就會有引入圖片啦~而 PIXI 會使用 GPU 以及 WebGL 來渲染圖片，而圖片需要經過處理才能夠使用的，而通常處理好的圖片都會稱為 Texture。","2",{"url":19,"title":20,"date":21,"updated":3,"category":10,"tags":22,"description":25,"readingMinutes":26},"\u002Fjavascript\u002F20200308\u002F3384986223\u002F","Fetch API 到底是 ESMAScript6 還是 Web APIs?","2020-03-08 12:07:26",[10,23,24],"ESMAScript6","Fetch API","Fetch API 是一個很多人會誤解的一個語法，最大誤解大概就是無法區分這一個語法到底是屬於 ECMAScript6 還是 Web APIs，所以這一篇來詳解一下吧。","3",{"url":28,"title":29,"date":30,"updated":3,"category":10,"tags":31,"description":34,"readingMinutes":26},"\u002Fjavascript\u002F20200307\u002F1405700237\u002F","JavaScript 核心觀念(1)-執行環境與作用域-JavaScript 運作方式","2020-03-07 21:37:04",[10,32,33],"JavaScript 核心篇","執行環境與作用域","第一篇將會來了解 JavaScript 的運作模式，",{"url":36,"title":37,"date":38,"updated":3,"category":10,"tags":39,"description":40,"readingMinutes":41},"\u002Fjavascript\u002F20200307\u002F318160061\u002F","JavaScript 核心觀念(0)-目錄及前言","2020-03-07 21:27:49",[10,32],"JavaScript 核心篇是基於六角學院的線上影音課程而撰寫的系列文章，雖然自己本身已經有上過 JavaScript 奇怪的部份，但每一位講者都有屬於他的講解方式，所以這一篇也來開始做一次紀錄以及學習囉。","4",{"url":43,"title":44,"date":45,"updated":3,"category":10,"tags":46,"description":47,"readingMinutes":17},"\u002Fjavascript\u002F20200302\u002F3104976087\u002F","PixiJS V5 教學 (4) - Text","2020-03-02 09:00:10",[12,13,10,14,15],"前一篇介紹了 Container，接下來要來看介紹前一篇所使用到的語法，也就是 new PIXI.Text()。",{"url":49,"title":50,"date":51,"updated":3,"category":10,"tags":52,"description":53,"readingMinutes":17},"\u002Fjavascript\u002F20200224\u002F4132682256\u002F","PixiJS V5 教學 (3) - Container","2020-02-24 08:17:13",[12,13,10,14,15],"前面基本知識也算是講得差不多，接下來將會介紹 PIXI 中的一個重要的東西，也就是 Container。",{"url":55,"title":56,"date":57,"updated":3,"category":10,"tags":58,"description":59,"readingMinutes":17},"\u002Fjavascript\u002F20200217\u002F4014508881\u002F","PixiJS V5 教學 (2) - WebGL 以及 Renderer","2020-02-17 00:05:28",[12,13,10,14,15],"這一篇會介紹一下前一篇沒有介紹的地方，舉例來講 WebGL 是什麼以及 Renderer 等語法跟說明。",{"url":61,"title":62,"date":63,"updated":3,"category":64,"tags":65,"description":68,"readingMinutes":41},"\u002Fvue\u002F20200214\u002F1055437216\u002F","一個指令快速部署 Vue Cli 到 GitHub Pages","2020-02-14 08:47:16","Vue",[10,64,66,67],"GitHub","Git","一般來說我們使用 Vue Cli 開發一個作品完畢之後都會需要部署到特定空間來展示作品，舉例來講 GitHub Pages 就是一個，那麼這一篇就來介紹該如何一個指令快速部署吧。",{"url":70,"title":71,"date":72,"updated":3,"category":64,"tags":73,"description":74,"readingMinutes":75},"\u002Fvue\u002F20200212\u002F3763656674\u002F","TypeError: this.getResolve is not a function","2020-02-12 08:53:36",[10,64],"最近剛好一些專案需求，所以會使用 Vue Cli2，但是在環境架設上突然發生一個錯誤，所以這一篇就來紀錄一下解決原因","1",{"url":77,"title":78,"date":79,"updated":3,"category":10,"tags":80,"description":82,"readingMinutes":17},"\u002Fjavascript\u002F20200210\u002F3949702627\u002F","PixiJS V5 教學 (1) - PixiJS 建立","2020-02-10 00:00:10",[12,13,10,81,15],"Canvasgit","Pixi.js 是一款基於 JavaScript 的 2D 引擎所開發的框架，主要常見於開發 2D 網頁遊戲，接下來就來快速入門學習吧 :D",1044,105,{"postCount":83,"tagCount":86},1034,1789747446796]