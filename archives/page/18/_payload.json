[{"data":1,"prerenderedAt":83},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F18\u002F":3,"archive-page:zh-Hant:18":4,"author-stats:zh-Hant:full":81},null,{"posts":5,"total":79,"totalPages":80},[6,17,24,31,38,44,50,56,62,73],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":15,"readingMinutes":16},"\u002Fnodejs\u002F20230929\u002F3878806252\u002F","Day15 - 第一個爬蟲","2023-09-29 00:00:01","2023-11-19 00:00:01","Nodejs",[13,14],"Node.js","《Node.js 不負責系列：把前端人員當作後端來用，就算是前端也能嘗試寫的後端～原來 Node.js 可以做這麼多事～》","前一篇我們對於爬蟲應該有一些基本的概念與認知了，接下來當然就是要來實作一下囉。","5",{"url":18,"title":19,"date":20,"updated":20,"category":11,"tags":21,"description":22,"readingMinutes":23},"\u002Fnodejs\u002F20230928\u002F2824059455\u002F","Day14 - 網頁爬蟲？","2023-09-28 00:00:01",[13,14],"這一篇基本上我打算輕鬆一點介紹爬蟲就好，所以這一篇的篇幅或許會比以往前面少很多，主要也是讓大腦可以輕鬆一點。","3",{"url":25,"title":26,"date":27,"updated":27,"category":11,"tags":28,"description":29,"readingMinutes":30},"\u002Fnodejs\u002F20230927\u002F4133508926\u002F","Day13 - 替你的 Express 戴上頭盔吧！","2023-09-27 00:00:01",[13,14],"前面介紹了 CORS 跟 Env 可以說是基本的基本，接下來要來介紹一個很特別的東西，叫做 Helmet。","4",{"url":32,"title":33,"date":34,"updated":34,"category":11,"tags":35,"description":36,"readingMinutes":37},"\u002Fnodejs\u002F20230926\u002F1829302614\u002F","Day12 - 關於 CORS 與 Env","2023-09-26 00:00:01",[13,14],"前一篇我們完成了 Express + Mongoose 的整合，接下來我們要來處理一些環境變數的問題，以及 CORS 的問題。","6",{"url":39,"title":40,"date":41,"updated":41,"category":11,"tags":42,"description":43,"readingMinutes":16},"\u002Fnodejs\u002F20230925\u002F3347882734\u002F","Day11 - Express 與 Mongoose","2023-09-25 00:00:01",[13,14],"在上一篇文章中，我們初步建立了 MongoDB Atlas 的帳號，並且快速認識了 Mongoose，接下來當然就是要來整合再一起啦～",{"url":45,"title":46,"date":47,"updated":47,"category":11,"tags":48,"description":49,"readingMinutes":16},"\u002Fnodejs\u002F20230924\u002F3283299199\u002F","Day10 - MongoDB 與 Mongoose","2023-09-24 00:00:01",[13,14],"前一篇我們初步對於資料庫有了一點概念後，接下來當然要進入資料庫章節啦～",{"url":51,"title":52,"date":53,"updated":53,"category":11,"tags":54,"description":55,"readingMinutes":16},"\u002Fnodejs\u002F20230923\u002F264010765\u002F","Day9 - What is a database？","2023-09-23 00:00:01",[13,14],"對於一個網站或者服務來講，資料庫是不可或缺的一個元素，那麼什麼是資料庫呢？接下來我們就來聊聊什麼是資料庫。",{"url":57,"title":58,"date":59,"updated":59,"category":11,"tags":60,"description":61,"readingMinutes":37},"\u002Fnodejs\u002F20230922\u002F299784561\u002F","Day8 - 再續 Express.js","2023-09-22 00:00:01",[13,14],"前面我們介紹了 Express 以及 Middleware 的概念，這一篇我們將會繼續介紹 Express.js。",{"url":63,"title":64,"date":65,"updated":65,"category":66,"tags":67,"description":71,"readingMinutes":72},"\u002Fvscode\u002F20230921\u002F1985180173\u002F","Visual Studio Code 自訂折疊區塊","2023-09-21 09:43:55","VSCode",[66,68,69,70],"實用設定","Setting","開發","VSCode 預設可以折疊函式但不能自訂區塊？其實只要用 #region 跟 #endregion 包住程式碼就能自訂折疊範圍，這一篇示範這個少人知道但相當實用的小技巧。","2",{"url":74,"title":75,"date":76,"updated":76,"category":11,"tags":77,"description":78,"readingMinutes":37},"\u002Fnodejs\u002F20230921\u002F766511846\u002F","Day7 - Web Framework to Express.js","2023-09-21 00:00:01",[13,14],"前一篇我們嘗試用 Node.js 建立了 HTTP API，我相信你應該學到相當的多，但是實戰上來講，我們並不會直接使用 Node.js 來建立 HTTP API，因為這樣會太麻煩了，因此我們會使用一些框架來幫助我們建立 HTTP API，而這邊我們就來介紹一個非常熱門的框架，也就是 Express.js。",1039,104,{"postCount":79,"tagCount":82},1020,1789315363981]