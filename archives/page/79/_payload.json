[{"data":1,"prerenderedAt":76},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F79\u002F":3,"archive-page:zh-Hant:79":4,"author-stats:zh-Hant:full":74},null,{"posts":5,"total":72,"totalPages":73},[6,14,23,29,35,42,47,54,60,66],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":12,"readingMinutes":13},"\u002Fjavascript\u002F20190728\u002F313613648\u002F","關於我逃出胡立的異世界 R30 這件事之攻略包","2019-07-28 10:08:31","JavaScript",[10],"由於這個系列是紀錄挑戰胡立分享的遊戲 [異世界?r3:0挑戰] 的挑戰紀錄，也不知道該算在哪個分類，所以就乾脆都放在 JavaScript 下囉~","4",{"url":15,"title":16,"date":17,"updated":3,"category":18,"tags":19,"description":21,"readingMinutes":22},"\u002Fvue\u002F20190727\u002F3081561859\u002F","Vue 出一個女友吧!-組件溝通 event bus","2019-07-27 17:16:15","Vue",[18,20],"Vue 出一個女友吧","接下來將會講一個東西叫做組件溝通 event bus，可是我個人比較喜歡講成元件溝通就是了...那麼 event bus 會拿來做什麼呢?來記錄一下吧","1",{"url":24,"title":25,"date":26,"updated":3,"category":18,"tags":27,"description":28,"readingMinutes":22},"\u002Fvue\u002F20190726\u002F2706745772\u002F","Vue 出一個女友吧!-vue-fontawesome","2019-07-26 21:09:13",[18,20],"接下來講講其中一個套件，也就是 vue-fontawesome，在前面我們已經安裝了，但是該怎麼使用呢?來記錄一下吧",{"url":30,"title":31,"date":32,"updated":3,"category":18,"tags":33,"description":34,"readingMinutes":22},"\u002Fvue\u002F20190725\u002F335001087\u002F","Vue 出一個女友吧!-loading","2019-07-25 21:43:11",[18,20],"接下來要來替產品新增、修改以及刪除時增加一個 loading 特效，這樣子對於使用者體驗也會比較好，那這邊就會使用到 vue-loading-overlay",{"url":36,"title":37,"date":38,"updated":3,"category":18,"tags":39,"description":40,"readingMinutes":41},"\u002Fvue\u002F20190725\u002F1855985718\u002F","Vue 出一個女友吧!-產品頁面","2019-07-25 20:14:34",[18,20],"接下來是製作產品相關的 API，這邊將會講到商品建立、取得商品列表、修改商品以及刪除商品","3",{"url":43,"title":44,"date":45,"updated":3,"category":18,"tags":46,"description":44,"readingMinutes":41},"\u002Fvue\u002F20190725\u002F1960407570\u002F","Vue 出一個女友吧!-Login API","2019-07-25 16:16:05",[18,20],{"url":48,"title":49,"date":50,"updated":3,"category":18,"tags":51,"description":52,"readingMinutes":53},"\u002Fvue\u002F20190725\u002F1014459828\u002F","Vue 出一個女友吧!-Admin Page","2019-07-25 15:08:18",[18,20],"這一篇將會講到 Route 的部分，順便也會講到 Admin Page","2",{"url":55,"title":56,"date":57,"updated":3,"category":18,"tags":58,"description":59,"readingMinutes":22},"\u002Fvue\u002F20190725\u002F3887985161\u002F","Vue 出一個女友吧!-PUG Template","2019-07-25 14:50:49",[18,20],"PUG Template 是我非常愛用的 HTML Template，所以講一下該如何使用在 Vue 中撰寫 PUG 吧",{"url":61,"title":62,"date":63,"updated":3,"category":18,"tags":64,"description":65,"readingMinutes":53},"\u002Fvue\u002F20190725\u002F1126109994\u002F","Vue 出一個女友吧!-SCSS & Boostrap 引入","2019-07-25 14:12:27",[18,20],"接下來的專案將會使用 Boostrap 幫助我們加速快速開發，所以就會需要引入 Boostrap",{"url":67,"title":68,"date":69,"updated":3,"category":18,"tags":70,"description":71,"readingMinutes":53},"\u002Fvue\u002F20190725\u002F3896075321\u002F","Vue 出一個女友吧!","2019-07-25 11:42:07",[18,20],"這是一個非常奇特的主題，至於為什麼會製作這個主題呢?後面再來講原因，這一系列將會講解紀錄使用 Vue Cli3 開發出一個平台唷",1039,104,{"postCount":72,"tagCount":75},1020,1789315365552]