[{"data":1,"prerenderedAt":84},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F63\u002F":3,"archive-page:zh-Hant:63":4,"author-stats:zh-Hant:full":82},null,{"posts":5,"total":80,"totalPages":81},[6,18,26,32,38,44,53,59,65,73],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":16,"readingMinutes":17},"\u002Fjavascript\u002F20200622\u002F389281552\u002F","PixiJS V5 教學 (20) - 碰撞邊界(2)","2020-06-22 08:25:39","JavaScript",[12,13,10,14,15],"PixiJS V5 教學","PixiJS","Canvas","w3HexSchool","接下來我們可以試著來製作撞到牆壁後出現數字的效果。","2",{"url":19,"title":20,"date":21,"updated":3,"category":10,"tags":22,"description":25,"readingMinutes":17},"\u002Fjavascript\u002F20200621\u002F3684249269\u002F","JavaScript 核心觀念(14)-運算子、型別與文法-原始型別及物件型別","2020-06-21 20:41:52",[10,23,24],"JavaScript 核心篇","運算子、型別與文法","JavaScript 中對於型別的觀念越清楚的話，實際開發時是有一定幫助的。",{"url":27,"title":28,"date":29,"updated":3,"category":10,"tags":30,"description":31,"readingMinutes":17},"\u002Fjavascript\u002F20200621\u002F3160672433\u002F","JavaScript 核心觀念(13)-運算子、型別與文法-動態型別","2020-06-21 16:41:54",[10,23,24],"當我們在轉寫 JavaScript 的時候，完全不用去宣告該變數是什麼型別，而這主要原因在於 JavaScript 是一個動態型別的語言。",{"url":33,"title":34,"date":35,"updated":3,"category":10,"tags":36,"description":37,"readingMinutes":17},"\u002Fjavascript\u002F20200615\u002F3300389376\u002F","PixiJS V5 教學 (19) - 碰撞邊界(1)","2020-06-15 08:13:50",[12,13,10,14,15],"接下來邊界相關的東西，通常來講我們在玩遊戲都會有所謂的邊界。",{"url":39,"title":40,"date":41,"updated":3,"category":10,"tags":42,"description":43,"readingMinutes":17},"\u002Fjavascript\u002F20200613\u002F3587770435\u002F","JavaScript 核心觀念(12)-運算子、型別與文法-ASI 自動插入分號","2020-06-13 21:16:47",[10,23,24],"JavaScript 為什麼一下子可以有「;」號一下子有沒有「;」號呢？這歸功於 JavaScript 中的一個機制 ASI。",{"url":45,"title":46,"date":47,"updated":47,"category":48,"tags":49,"description":51,"readingMinutes":52},"\u002Flearnexp\u002F20200612\u002F341747575\u002F","入職後發現技術不足怎麼辦？","2020-06-12 22:06:31","學習經驗",[50,48],"其他","這幾天有幾位類似相同境遇的學員來跟我小聊一下自己工作近況，話題大多都是關於「入職後發現自己技術完全跟不上，同事開會時也幫不上忙，是不是該離職了。」","4",{"url":54,"title":55,"date":56,"updated":3,"category":10,"tags":57,"description":58,"readingMinutes":17},"\u002Fjavascript\u002F20200608\u002F3719086913\u002F","PixiJS V5 教學 (18) - boxesIntersect","2020-06-08 08:40:42",[12,13,10,14,15],"接下來稍微讓我們回顧一下前面沒講的東西，也就是 boxesIntersect 的參數。",{"url":60,"title":61,"date":62,"updated":3,"category":10,"tags":63,"description":64,"readingMinutes":52},"\u002Fjavascript\u002F20200607\u002F196651152\u002F","JavaScript 核心觀念(11)-運算子、型別與文法-陳述式與表達式","2020-06-07 14:08:21",[10,23,24],"陳述式 vs 表達式是最容易搞不清楚的觀念，包含我自己也是。",{"url":66,"title":67,"date":68,"updated":3,"category":10,"tags":69,"description":71,"readingMinutes":72},"\u002Fjavascript\u002F20200606\u002F308613948\u002F","JavaScript 核心觀念(10)-執行環境與作用域-課後練習","2020-06-06 22:33:46",[10,23,70],"執行環境與作用域","終於來到最後的課後練習，雖然課後練習中絕大部分問題都是我自己出的，但也是很值得回顧的練習，但是這邊會建議不要直接執行程式碼，而是透過觀察畫面來推敲結果答案。","5",{"url":74,"title":75,"date":76,"updated":3,"category":10,"tags":77,"description":78,"readingMinutes":79},"\u002Fjavascript\u002F20200601\u002F1513414542\u002F","PixiJS V5 教學 (17) - Text+HP","2020-06-01 08:38:23",[12,13,10,14,15],"前一篇我們學會如何製作血條，但是文字呢?所以這一篇就來介紹如何補上文字~","1",1047,105,{"postCount":80,"tagCount":83},1044,1790006470471]