[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F88\u002F":3,"archive-page:zh-Hant:88":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,16,26,33,40,48,54,60,66,72],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fnodejs\u002F20190626\u002F1885201810\u002F","全端勇士之路 Node.js 基礎學習-基礎篇","2019-06-26 12:02:21","Nodejs",[12,13],"Node.js","全端勇士之路 Node.js","又是一篇基礎學習系列的開啟，這是為了讓自己對 Node.js 觀念及開發更清楚所撰寫的系列文章，廢話不多說就開始吧~","2",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":24,"readingMinutes":25},"\u002Fpython\u002F20190626\u002F2933081730\u002F","拖曳影片檔案到 CMD 圖示內透過 Python 生成影片字幕","2019-06-26 10:13:30","Python",[20,22,23],"AI","字幕","由於先前撰寫了[使用 Python 替影片自動上字幕]的文章，後來自己在使用的時候每一次都要打開指令視窗輸入指令，對於金魚腦的我來講實在很不方便，所以這邊稍微製作 .bat 檔案，直接拖曳進去自動生成字幕。","1",{"url":27,"title":28,"date":29,"updated":3,"category":30,"tags":31,"description":32,"readingMinutes":25},"\u002Fjavascript\u002F20190625\u002F981473819\u002F","let、const 提升的雷點","2019-06-25 19:52:32","JavaScript",[30],"今天看到一個題目，一開始我以為 undefined & undefined，結果竟然不是，所以這邊紀錄一下題目及答案。",{"url":34,"title":35,"date":36,"updated":3,"category":30,"tags":37,"description":38,"readingMinutes":39},"\u002Fjavascript\u002F20190624\u002F604717444\u002F","嘗試了解 JavaScript 的原型鏈","2019-06-24 12:28:48",[30],"這一篇其實我一直猶豫該不該寫，因為我深怕一個地方紀錄錯了會導致其他看的人也跟著錯，但是想一想我當初撰寫 Hexo 部落格的初衷是做自己的筆記後就又好點了，這一篇來記錄一下 JavaScript 的原型鏈這個主題","3",{"url":41,"title":42,"date":43,"updated":3,"category":44,"tags":45,"description":47,"readingMinutes":39},"\u002FTypeScript\u002F20190623\u002F3262185960\u002F","TypeScript 基礎入門-Class","2019-06-23 11:43:56","TypeScript",[46,30,44],"TypeScript 基礎入門","類別(class)這個是在 ES6 引入的，而這個功能又有何用處呢?讓我們來研究一下",{"url":49,"title":50,"date":51,"updated":3,"category":44,"tags":52,"description":53,"readingMinutes":25},"\u002FTypeScript\u002F20190622\u002F2385966784\u002F","TypeScript 基礎入門-Array","2019-06-22 22:27:26",[46,30,44],"接下來講到陣列的撰寫方式，其實與撰寫變數是太大的差異，這邊就來了解一下 TypeScript 中應該怎麼寫陣列吧",{"url":55,"title":56,"date":57,"updated":3,"category":44,"tags":58,"description":59,"readingMinutes":25},"\u002FTypeScript\u002F20190622\u002F3741788460\u002F","TypeScript 基礎入門-Function","2019-06-22 22:14:41",[46,30,44],"寫 JavaScript 的時候會非常撰寫 function，但 TypeScript 也有它的撰寫方式，讓我們來了解一下",{"url":61,"title":62,"date":63,"updated":3,"category":44,"tags":64,"description":65,"readingMinutes":25},"\u002FTypeScript\u002F20190622\u002F2982589304\u002F","TypeScript 基礎入門-混和型別","2019-06-22 21:56:38",[46,30,44],"前面講到 TypeScript 有所謂的型別推論的能力，在這邊再來講一個東西混和型別，這個東西又是什麼呢?讓我們來了解一下",{"url":67,"title":68,"date":69,"updated":3,"category":44,"tags":70,"description":71,"readingMinutes":25},"\u002FTypeScript\u002F20190622\u002F2739569432\u002F","TypeScript 基礎入門-型別推論","2019-06-22 15:49:05",[46,30,44],"前面已經了解該如何設置變數型別的方式，但是尾段其實也有講到如果不設置型別也是會編譯成功，但是實際上真的是這樣子嗎?這邊就來講講 TypeScript 裡面有一個很特別的東西，叫做型別推論，就算你不宣告型別 TypeScript 也會自己判定，來了解看看吧~",{"url":73,"title":74,"date":75,"updated":3,"category":44,"tags":76,"description":77,"readingMinutes":15},"\u002FTypeScript\u002F20190622\u002F3955309115\u002F","TypeScript 基礎入門-變數篇","2019-06-22 15:06:22",[46,30,44],"身邊滿多前端工程師都會接觸到 TypeScript，所以這邊紀錄一下 TypeScript 基礎入門",1048,105,{"postCount":78,"tagCount":81},1047,1790132714673]