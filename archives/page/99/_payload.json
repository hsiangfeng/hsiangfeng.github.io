[{"data":1,"prerenderedAt":77},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F99\u002F":3,"archive-page:zh-Hant:99":4,"author-stats:zh-Hant:full":75},null,{"posts":5,"total":73,"totalPages":74},[6,16,22,29,35,43,49,55,61,67],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190517\u002F4033482277\u002F","[JS奇怪的世界]No.22 物件與「點」","2019-05-17 14:30:00","克服JS奇怪的部分系列",[12,13],"JavaScript","JavaScript 全攻略:克服JS奇怪的部分","接下來是一個新的章節，物件與函數，許多課程都會將 JavaScript 中的這兩個東西當成不同的主題在教導，但這其實是一個天大的錯誤，why? 在其他的程式語言裡面這兩者確實是不同的主題，但 JavaScript 世界中這兩者就非常的有相關。","2",{"url":17,"title":18,"date":19,"updated":3,"category":10,"tags":20,"description":21,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190517\u002F3961604918\u002F","[JS奇怪的世界]No.21 框架小叮嚀:預設值","2019-05-17 13:22:00",[12,13],"接下來將針對框架做一個小觀念叮嚀，這邊課程講解的是 jQuery，為什麼會拿 jQuery 來講解呢呢?以前最熱門的框架非 jQuery 莫屬，舉凡動畫效果等等都是由 jQuery 一手包辦，並不用說瀏覽器適應問題，所以這章節拿 jQuery 來作範例再適合不過了。",{"url":23,"title":24,"date":25,"updated":3,"category":10,"tags":26,"description":27,"readingMinutes":28},"\u002Fjsweirdworld\u002F20190517\u002F600418516\u002F","[JS奇怪的世界]No.20 預設值","2019-05-17 12:22:00",[12,13],"上一章節講解了強制轉型的一些特性，所以這堂課將會試著從另一個角度去利用它的特性，首先課程提供了範例程式碼 ↓","1",{"url":30,"title":31,"date":32,"updated":3,"category":10,"tags":33,"description":34,"readingMinutes":28},"\u002Fjsweirdworld\u002F20190517\u002F3849161770\u002F","[JS奇怪的世界]No.19 存在與布林值","2019-05-17 11:16:35",[12,13],"一般來講我們可以手動使用 Boolean、Number 等函數來做強制轉型的動作，但是課程也是強調不要這樣做(手動轉型)，但是用來展示效果是可以的，舉例我們將 undefined 轉換成布林值 ↓",{"url":36,"title":37,"date":38,"updated":3,"category":39,"tags":40,"description":42,"readingMinutes":28},"\u002Fhexo\u002F20190517\u002F2562079032\u002F","Hexo Url優化(SEO)","2019-05-17 10:05:19","Hexo",[39,41],"SEO","由於 Hexo 本身 Url 的 SEO 狀況並不是設計非常漂亮，因為在 SEO 規範中文連結遠比英文連結差，所以這邊紀錄一下該如何使用。",{"url":44,"title":45,"date":46,"updated":3,"category":10,"tags":47,"description":48,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190516\u002F803766782\u002F","[JS奇怪的世界]No.18 比較運算子","2019-05-16 21:16:35",[12,13],"將下來講講 小於運算子，讓我們試著用程式碼來講解。",{"url":50,"title":51,"date":52,"updated":3,"category":10,"tags":53,"description":54,"readingMinutes":28},"\u002Fjsweirdworld\u002F20190516\u002F3588659278\u002F","[JS奇怪的世界]No.17 觀念小叮嚀:強制轉型","2019-05-16 21:01:35",[12,13],"強制轉型的意思是什麼?就是將原本的型別轉換成另一種，例如 String 變成 Boolean。",{"url":56,"title":57,"date":58,"updated":3,"category":10,"tags":59,"description":60,"readingMinutes":28},"\u002Fjsweirdworld\u002F20190516\u002F3658238475\u002F","[JS奇怪的世界]No.16 運算子的優先性與相依性","2019-05-16 20:34:35",[12,13],"這兩個在 JavaScript 是一個非常重要的名詞，其實非常重要的觀念，如果能瞭解其觀念，對於 debug 上是有一定幫助的。",{"url":62,"title":63,"date":64,"updated":3,"category":10,"tags":65,"description":66,"readingMinutes":28},"\u002Fjsweirdworld\u002F20190516\u002F2821553635\u002F","[JS奇怪的世界]No.15 觀念小叮嚀:運算子","2019-05-16 20:00:35",[12,13],"運算子可以說是 JavaScript 中提供的特殊方法也可以稱之為函數，並且可以協助我們做一些計算，那怎麼寫呢?",{"url":68,"title":69,"date":70,"updated":3,"category":10,"tags":71,"description":72,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190516\u002F890725015\u002F","[JS奇怪的世界]No.14 純值","2019-05-16 19:30:35",[12,13],"前面已經針對 JavaScript 的型別做的一個簡易的介紹，而這章節課程將針對 JavaScript 動態型別瞭解以及其優缺點深入瞭解。",1044,105,{"postCount":73,"tagCount":76},1034,1789747447550]