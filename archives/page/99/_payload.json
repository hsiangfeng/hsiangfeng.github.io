[{"data":1,"prerenderedAt":79},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F99\u002F":3,"archive-page:zh-Hant:99":4,"author-stats:zh-Hant:full":77},null,{"posts":5,"total":75,"totalPages":76},[6,16,26,32,38,44,50,56,62,69],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":14,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190518\u002F3335281250\u002F","[JS奇怪的世界]No.24 框架小叮嚀:偽裝命名空間","2019-05-18 18:26:00","克服JS奇怪的部分系列",[12,13],"JavaScript","JavaScript 全攻略:克服JS奇怪的部分","命名空間在現在的程式語言是變數與函數的容器，通常是用來維持變數和函數的名稱分開避免 A 感染到 B，但 JavaScript 其實並沒有命名空間這種東西，可是我們可以利用物件來偽裝命名空間。","2",{"url":17,"title":18,"date":19,"updated":3,"category":20,"tags":21,"description":24,"readingMinutes":25},"\u002Fhexo\u002F20190518\u002F3303379172\u002F","Hexo Next 加入 FB 留言版","2019-05-18 10:07:05","Hexo",[20,22,23],"NexT","FB Comment","首先必須要先建立應用程式 FB sdk。","1",{"url":27,"title":28,"date":29,"updated":3,"category":20,"tags":30,"description":31,"readingMinutes":25},"\u002Fhexo\u002F20190517\u002F1811593244\u002F","Hexo 壓縮相關檔案","2019-05-17 21:05:19",[20],"當 Hexo 寫到一定程度時速度會越來越慢，這時候可以嘗試做一些壓縮的動作，舉凡壓縮js、HTML等進而減少使用者要載入的時間。",{"url":33,"title":34,"date":35,"updated":3,"category":10,"tags":36,"description":37,"readingMinutes":25},"\u002Fjsweirdworld\u002F20190517\u002F1261168016\u002F","[JS奇怪的世界]No.23 物件與物件實體","2019-05-17 15:26:00",[12,13],"這章節準備來講解另一種建立物件的方式，還記得上一個章節我們是使用 `new Object();` 來建立物件的吧?其實這個方式對於開發者來講非常不直覺 ↓",{"url":39,"title":40,"date":41,"updated":3,"category":10,"tags":42,"description":43,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190517\u002F4033482277\u002F","[JS奇怪的世界]No.22 物件與「點」","2019-05-17 14:30:00",[12,13],"接下來是一個新的章節，物件與函數，許多課程都會將 JavaScript 中的這兩個東西當成不同的主題在教導，但這其實是一個天大的錯誤，why? 在其他的程式語言裡面這兩者確實是不同的主題，但 JavaScript 世界中這兩者就非常的有相關。",{"url":45,"title":46,"date":47,"updated":3,"category":10,"tags":48,"description":49,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190517\u002F3961604918\u002F","[JS奇怪的世界]No.21 框架小叮嚀:預設值","2019-05-17 13:22:00",[12,13],"接下來將針對框架做一個小觀念叮嚀，這邊課程講解的是 jQuery，為什麼會拿 jQuery 來講解呢呢?以前最熱門的框架非 jQuery 莫屬，舉凡動畫效果等等都是由 jQuery 一手包辦，並不用說瀏覽器適應問題，所以這章節拿 jQuery 來作範例再適合不過了。",{"url":51,"title":52,"date":53,"updated":3,"category":10,"tags":54,"description":55,"readingMinutes":25},"\u002Fjsweirdworld\u002F20190517\u002F600418516\u002F","[JS奇怪的世界]No.20 預設值","2019-05-17 12:22:00",[12,13],"上一章節講解了強制轉型的一些特性，所以這堂課將會試著從另一個角度去利用它的特性，首先課程提供了範例程式碼 ↓",{"url":57,"title":58,"date":59,"updated":3,"category":10,"tags":60,"description":61,"readingMinutes":25},"\u002Fjsweirdworld\u002F20190517\u002F3849161770\u002F","[JS奇怪的世界]No.19 存在與布林值","2019-05-17 11:16:35",[12,13],"一般來講我們可以手動使用 Boolean、Number 等函數來做強制轉型的動作，但是課程也是強調不要這樣做(手動轉型)，但是用來展示效果是可以的，舉例我們將 undefined 轉換成布林值 ↓",{"url":63,"title":64,"date":65,"updated":3,"category":20,"tags":66,"description":68,"readingMinutes":25},"\u002Fhexo\u002F20190517\u002F2562079032\u002F","Hexo Url優化(SEO)","2019-05-17 10:05:19",[20,67],"SEO","由於 Hexo 本身 Url 的 SEO 狀況並不是設計非常漂亮，因為在 SEO 規範中文連結遠比英文連結差，所以這邊紀錄一下該如何使用。",{"url":70,"title":71,"date":72,"updated":3,"category":10,"tags":73,"description":74,"readingMinutes":15},"\u002Fjsweirdworld\u002F20190516\u002F803766782\u002F","[JS奇怪的世界]No.18 比較運算子","2019-05-16 21:16:35",[12,13],"將下來講講 小於運算子，讓我們試著用程式碼來講解。",1048,105,{"postCount":75,"tagCount":78},1047,1790132449255]