[{"data":1,"prerenderedAt":111},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F28\u002F":3,"archive-page:zh-Hant:28":4,"author-stats:zh-Hant:full":109},null,{"posts":5,"total":107,"totalPages":108},[6,24,37,44,50,64,74,84,90,98],{"url":7,"title":8,"date":9,"updated":10,"category":11,"tags":12,"description":22,"readingMinutes":23},"\u002Fnodejs\u002F20221127\u002F2847196536\u002F","一個 antfu\u002Fni 搞定安裝？！用 antfu\u002Fni 來取代你的 npm\u002Fyarn\u002Fpnpm\u002Fbun 吧！","2022-11-27 20:31:42","2025-04-07 14:03:27","Nodejs",[13,14,15,16,17,18,19,20,21],"antfu\u002Fni","ni","npm","yarn","node","pnpm","bun","套件管理","套件安裝管理器","你有想過一個問題嗎？每次拿到別人開發的新專案時，到底要輸入 npm install 還是 yarn install 呢？是不是覺得套件管理安裝器超級無敵多，每次都要打開專案看才能夠知道要用哪一個呢？所以這一篇我將會介紹一個很特別的套件安裝管理器，也就是 ni。","3",{"url":25,"title":26,"date":27,"updated":27,"category":28,"tags":29,"description":35,"readingMinutes":36},"\u002Fgsap\u002F20221127\u002F1252086867\u002F","(5)前端好好玩用 GSAP 做一個特效 - 動畫屬性","2022-11-27 19:54:52","GSAP",[28,30,31,32,33,34],"GSAP3","Green Sock Animation Platform","GSAP3 入門","GSAP3 基礎","GSAP3 動畫","接著我們要來認識一下關於 GSAP 可以使用的動畫屬性。","2",{"url":38,"title":39,"date":40,"updated":40,"category":28,"tags":41,"description":42,"readingMinutes":43},"\u002Fgsap\u002F20221125\u002F4035442226\u002F","(4)前端好好玩用 GSAP 做一個特效 - 選取目標","2022-11-25 22:25:00",[28,30,31,32,33,34],"上一篇我們認識到了基本的動畫設定與語法，接下來這一篇將會針對選取目標來介紹。","1",{"url":45,"title":46,"date":47,"updated":47,"category":28,"tags":48,"description":49,"readingMinutes":36},"\u002Fgsap\u002F20221119\u002F1174983119\u002F","(3)前端好好玩用 GSAP 做一個特效 - 第一個動畫","2022-11-19 22:04:00",[28,30,31,32,33,34],"接著這一篇開始我們要來做一個最簡單的動畫以及認識最基本的 GSAP 語法。",{"url":51,"title":52,"date":53,"updated":53,"category":54,"tags":55,"description":63,"readingMinutes":36},"\u002Fgulp\u002F20221118\u002F111080074\u002F","解決使用 Gulp 發生 regeneratorRuntime is not defined 問題","2022-11-18 09:45:25","Gulp",[54,56,57,58,59,60,61,62],"Node.js","Gulp 4","障礙排除","gulp-babel","babel-polyfill","babel-runtime","babel-preset-env","這一篇稍微記錄一下關於使用 gulp-babel 發生 `regeneratorRuntime is not defined` 的問題。",{"url":65,"title":66,"date":67,"updated":67,"category":68,"tags":69,"description":72,"readingMinutes":73},"\u002Fgit\u002F20221115\u002F721294310\u002F","來吧！用 git-cz 讓你的 Git Commit 訊息更美一點！","2022-11-15 10:46:46","Git",[68,70,71],"GitHub","git-cz","你有想過嗎？你的 Git Commit 是不是有點醜呢？然後時常不知道到底要寫什麼？如果有的話，那麼這一篇就要來介紹一個工具，也就是 git-cz，讓你解放你的 Git Commit 訊息，讓你的 Git Commit 更美更漂亮，說是懶人福音也不為過唷。","7",{"url":75,"title":76,"date":77,"updated":77,"category":28,"tags":78,"description":83,"readingMinutes":36},"\u002Fgsap\u002F20221114\u002F4266478793\u002F","(2)前端好好玩用 GSAP 做一個特效 - 初始環境","2022-11-14 09:12:14",[28,30,79,80,81,82,31,32,33,34],"TweenMax","TweenLite","TimelineMax","TimelineLite","第一篇我們當然要先來介紹一下初始環境，否則有很高機率踩到各式各樣的雷。",{"url":85,"title":86,"date":87,"updated":87,"category":28,"tags":88,"description":89,"readingMinutes":36},"\u002Fgsap\u002F20221109\u002F986425046\u002F","(1)前端好好玩用 GSAP3 做一個特效 - 誰是 GSAP？","2022-11-09 08:23:00",[28,30,79,80,81,82,31,32,33,34],"身為一名前端工程師來講其實很常做特效，那麼 GSAP 就是一個非常好用的工具，它可以讓我們在網頁上做出許多有趣的動畫特效，並它的 API 也相當簡單，所以就乾脆來寫一系列的 GSAP 教學文章吧。",{"url":91,"title":92,"date":93,"updated":93,"category":94,"tags":95,"description":97,"readingMinutes":36},"\u002Fhexo\u002F20221030\u002F561405053\u002F","解決 Hexo 更新系統或使用 CI 部署後文章出現更新日期的問題","2022-10-30 11:52:35","Hexo",[94,96,68,70,58],"CI","最新更新 Hexo 的時候發現一些問題就是文章莫名其妙通通全部被加上更新時間，因此這一篇記錄一下該如何解決這個問題，否則明明沒有更新的文章卻全部標記更新，這樣對於讀者來講會非常困擾。",{"url":99,"title":100,"date":101,"updated":3,"category":102,"tags":103,"description":106,"readingMinutes":36},"\u002Freact\u002F20221014\u002F3383337781\u002F","終究都要學 React 何不現在學呢？ - 鐵人賽後記 - 目錄 - (30)","2022-10-14 00:00:01","React",[104,105],"終究都要學 React 何不現在學呢？","React 基礎","這一篇是「終究都要學 React 何不現在學呢？」系列的最後一篇了，同時也是目錄，因此也最後分享一下自己學的過程，以及一些心得。",1047,105,{"postCount":107,"tagCount":110},1044,1790006469569]