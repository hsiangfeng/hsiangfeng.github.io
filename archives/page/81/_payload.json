[{"data":1,"prerenderedAt":82},["ShallowReactive",2],{"header-locale:\u002Farchives\u002Fpage\u002F81\u002F":3,"archive-page:zh-Hant:81":4,"author-stats:zh-Hant:full":80},null,{"posts":5,"total":78,"totalPages":79},[6,15,21,28,37,44,54,60,66,72],{"url":7,"title":8,"date":9,"updated":3,"category":10,"tags":11,"description":13,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F1126109994\u002F","Vue 出一個女友吧!-SCSS & Boostrap 引入","2019-07-25 14:12:27","Vue",[10,12],"Vue 出一個女友吧","接下來的專案將會使用 Boostrap 幫助我們加速快速開發，所以就會需要引入 Boostrap","2",{"url":16,"title":17,"date":18,"updated":3,"category":10,"tags":19,"description":20,"readingMinutes":14},"\u002Fvue\u002F20190725\u002F3896075321\u002F","Vue 出一個女友吧!","2019-07-25 11:42:07",[10,12],"這是一個非常奇特的主題，至於為什麼會製作這個主題呢?後面再來講原因，這一系列將會講解紀錄使用 Vue Cli3 開發出一個平台唷",{"url":22,"title":23,"date":24,"updated":3,"category":25,"tags":26,"description":27,"readingMinutes":14},"\u002Fjavascript\u002F20190724\u002F834556007\u002F","JavaScript 取得 QueryString 方式","2019-07-24 09:41:36","JavaScript",[25],"有些時候我們會需要使用 JavaScript 取得 URL QueryString 的參數，所以這邊做一下紀錄可以使用哪些方式取得",{"url":29,"title":30,"date":31,"updated":31,"category":32,"tags":33,"description":35,"readingMinutes":36},"\u002Flearnexp\u002F20190723\u002F2343571780\u002F","關於寫部落格的心法","2019-07-23 21:14:06","學習經驗",[34,32],"其他","最近都有人在詢問撰寫部落格到底對於自己求職 & 工作有沒有幫助，也有人問說該如何起手，所以我就稍微講一下我自己的寫部落格心法囉~","3",{"url":38,"title":39,"date":40,"updated":3,"category":41,"tags":42,"description":43,"readingMinutes":14},"\u002Fadobexd\u002F20190723\u002F1858934129\u002F","Adobe XD 設計稿的開啟方式","2019-07-23 09:31:27","AdobeXD",[41],"一般來講我們前端工程師會很長拿到用 AdobeXD 設計的線上標示設計稿，但是如果設計師使用的是免費版 AdobeXD 那就不太一樣了，有可能會拿到原始的 XD 檔案，那麼我們該如何開啟標示設計稿呢?",{"url":45,"title":46,"date":47,"updated":3,"category":48,"tags":49,"description":52,"readingMinutes":53},"\u002Fnodejs\u002F20190722\u002F2145427316\u002F","這是在講關於一名叫 Koa 的全端勇士傳說-部屬 Heroku","2019-07-22 21:39:03","Nodejs",[50,51],"Node.js","這是在講關於一名叫 Koa 的全端勇士傳說","前面已經將基本的會員機制給完成了，那麼實際該如何部屬 Heroku 呢?這邊就來記錄一下吧","1",{"url":55,"title":56,"date":57,"updated":3,"category":48,"tags":58,"description":59,"readingMinutes":14},"\u002Fnodejs\u002F20190722\u002F1630780789\u002F","這是在講關於一名叫 Koa 的全端勇士傳說-會員登入機制(2)","2019-07-22 14:29:41",[50,51],"前面大致上將登入方面的介面以及基本的功能都做好了，接下來要來講關於會員密碼的部份",{"url":61,"title":62,"date":63,"updated":3,"category":48,"tags":64,"description":65,"readingMinutes":14},"\u002Fnodejs\u002F20190721\u002F1243541174\u002F","這是在講關於一名叫 Koa 的全端勇士傳說-會員登入機制(1)","2019-07-21 16:15:21",[50,51],"前面講了那麼多，這邊就來稍微越級打怪一下試著製作會員登入看看，但是這邊要先做一些準備動作才可以",{"url":67,"title":68,"date":69,"updated":3,"category":48,"tags":70,"description":71,"readingMinutes":36},"\u002Fnodejs\u002F20190720\u002F4027902980\u002F","這是在講關於一名叫 Koa 的全端勇士傳說-MySQL篇-sequelize(4)","2019-07-20 17:26:04",[50,51],"前面已經學習了如何查詢資料並打印在前端畫面上，接下來就是將表單資料 post 之後新增到資料庫內",{"url":73,"title":74,"date":75,"updated":3,"category":48,"tags":76,"description":77,"readingMinutes":14},"\u002Fnodejs\u002F20190720\u002F3210050243\u002F","這是在講關於一名叫 Koa 的全端勇士傳說-MySQL篇-sequelize(3)","2019-07-20 11:57:11",[50,51],"前面知道可以使用 migrations 來做遷移，而 migrations 也可以方便我們轉移資料到新資料庫(當然不包含資料內容)，那麼在實作上該如何透過 sequelize 來取得表單資料並新增資料進去資料表呢?",1051,106,{"postCount":78,"tagCount":81},1057,1790352032109]